<script src="{{ 'blog-filter.js' | asset_url }}" defer="defer"></script>
{% style %}
#shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --desktop-grid-type: {{ section.settings.grid_type }};
    --focal-point: {{ section.settings.focal_point }};
    {% if section.settings.context_image_radius == 'default' %}
    --context-image-radius: var(--images-and-section-radius);
    {% else %}
    --context-image-radius: {{ section.settings.context_image_radius }};
    {% endif %}
}
{% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
  .gradient-heading-text--{{ section.id }} {
    background: {{ section.settings.heading_gradient }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
{% endif %}
{% for block in section.blocks %}
  {% case block.type %}
    {% when 'title' %}
      {% if block.settings.heading_color == 'gradient' and block.settings.heading_gradient != blank %}
        .gradient-heading-text--{{ block.id }} {
          background: {{ block.settings.heading_gradient }};
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          color: transparent;
        }
      {% endif %}
  {% endcase %}
{% endfor %}
@media screen and (max-width: 920px) {
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.mobile_padding_top }}px;
    --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
}
{% endstyle %}
{%- liquid 
  if settings.typography_preset == 'avant_garde'
    assign weight = settings.accent_icon_weight
    if settings.swap_fonts
        assign weight = settings.base_icon_weight
    endif
else 
    assign weight =  settings.base_icon_weight
    if settings.swap_fonts
        assign weight = settings.accent_icon_weight
    endif
endif
assign uppercase_font = false
assign bolder_font = false
if settings.typography_preset == 'custom'
  assign weight = settings.custom_icon_weight
    if settings.uppercase_body_s
        assign uppercase_font = true
    endif
    if settings.bolder_font_body_s
        assign bolder_font = true
    endif
endif

assign disable_layout_margins = false
if section.settings.layout_margins == 'disable'
  assign disable_layout_margins = true
elsif section.settings.layout_margins == 'default' and settings.disable_margins
  assign disable_layout_margins = true
endif
-%}

{%- paginate blog.articles by section.settings.posts_per_page -%}
  <div id="ProductGridContainer--{{  section.id }}" class="main-blog main-blog--{{ settings.white_space }} {% if settings.show_lines %}main-blog--lines{% endif %} ordinal-section ordinal-section--{{ settings.white_space }} {% if settings.show_lines %}ordinal-section--lines{% endif %}  {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }} {% unless disable_layout_margins %}section-padding--{{ settings.white_space }}{% endunless %} {% if disable_layout_margins %}disable-layout-margins disable-layout-margins--{{ settings.white_space }}{% endif %}">
      <{{ section.settings.heading_tag }} class="blog__heading {% if settings.accent_color_for_headings %}heading--accent{% endif %} heading--{{ settings.typography_preset }} {% if disable_layout_margins %} section-padding--{{ settings.white_space }} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }}{% endif %}
        {% if section.settings.heading_size != 'default' %}{{ section.settings.heading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_heading_xs %} uppercase{% endif %}{% if settings.bolder_font_heading_xs %} bolder-font{% endif %}{% endif %}
        {% endif %}{% if settings.center_text %} center{% endif %}">
        {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}<span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{% endif %}
        {{ blog.title | escape }} {% if section.settings.show_number_of_posts %}({{ blog.articles_count }}){% endif %}
        {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}</span>{% endif %}
      </{{ section.settings.heading_tag }}>
      {%- if section.settings.enable_filtering_by_tags and blog.tags.size > 0 -%}
        <div class="blog__filters">
          <ul class="blog__filters-list input--{{ settings.typography_preset }}{% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %} {% if settings.center_text %} center{% endif %} {% if disable_layout_margins %} section-padding--{{ settings.white_space }} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }}{% endif %}">
            <li><a href="/blogs/{{ blog.handle }}" class="blog__filters-link{% if current_tags == blank %} is-selected{% endif %}">{{ 'blogs.article.all_tags' | t }}</a></li>
            {%- for tag in blog.all_tags -%}
              {%- liquid
                if tag contains "_"
                  assign tag_starts_with = tag | slice: 0
                  if tag_starts_with == "_"
                    if tag_count
                      assign tag_count = tag_count | minus: 1 | at_least: 0
                    endif
                    continue
                  endif
                endif
              -%}
              <li><a href="/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}" class="blog__filters-link{% if current_tags contains tag %} is-selected{% endif %}">{{ tag }}</a></li>
            {%- endfor -%}
          </ul>
          <blog-filter class="select blog__filters-select {% if disable_layout_margins %} section-padding--{{ settings.white_space }} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }}{% endif %}">
            <select class="select__select input--{{ settings.typography_preset }}{% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %}">
              <option value="/blogs/{{ blog.handle }}">{{ 'blogs.article.all_tags' | t }}</option>
              {%- for tag in blog.all_tags -%}
                {%- liquid
                  if tag contains "_"
                    assign tag_starts_with = tag | slice: 0
                    if tag_starts_with == "_"
                      if tag_count
                        assign tag_count = tag_count | minus: 1 | at_least: 0
                      endif
  
                      continue
                    endif
                  endif
                -%}
                <option value="/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}" {% if current_tags contains tag %}selected{% endif %}>{{ tag }}</option>
              {%- endfor -%}
            </select>
            <div class="select-icon ">
              {% assign icon_full = 'close-chevron' | append: "-" | append: weight %}
              {% render 'icon', icon: icon_full %}
            </div>
          </blog-filter>
        </div>
      {%- endif -%}

    <div id="product-grid--{{ section.id }}" class="blog-articles {% if settings.show_lines %}blog-articles--lines{% endif %} blog-articles--{{ section.settings.grid_type }}">
      {%- for article in blog.articles -%}
        {% liquid 
          assign lazy_load = false
          assign items = section.settings.mobile_layout | times: 1
          if forloop.index > 6 or section.index > 2
            assign lazy_load = true
          endif
        %}
        <div class="blog-articles__article article article--{{ section.settings.grid_type }} article--{{ settings.white_space }} {% if settings.show_lines %}article--lines{% endif %}">
          {%- render 'article-card',
            article: article,
            blog_columns_count: section.settings.grid_type,
            media_height: section.settings.image_height,
            media_aspect_ratio: article.image.aspect_ratio,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            lazy_load: lazy_load,
            article_index: forloop.index
          -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate, infinite_scroll: section.settings.infinite_scroll, disable_layout_margins: disable_layout_margins -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

