{% style %}
#shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}
{% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
  .gradient-heading-text--{{ section.id }} {
    background: {{ section.settings.heading_gradient }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
{% endif %}
@media screen and (max-width: 920px) {
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.mobile_padding_top }}px;
    --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
}
{% endstyle %}
{% liquid
    assign uppercase_font = false
    assign bolder_font = false
    if settings.typography_preset == 'custom' and section.settings.text_size == 'default'
      if settings.uppercase_body_m
        assign uppercase_font = true
      endif
      if settings.bolder_font_body_m
        assign bolder_font = true
      endif
    endif
  %} 

<div class="ordinal-section ordinal-section--{{ settings.white_space }} {% if settings.show_lines %}ordinal-section--lines{% endif %}  {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }} section-padding--{{ settings.white_space }}">
    <div class="page page--{{ settings.white_space }} page--{{ section.settings.section_width }}">
        {% unless section.settings.hide_heading %}<{{ section.settings.heading_tag }} class="page__title custom-heading {% if settings.accent_color_for_headings %}heading--accent{% endif %} heading--{{ settings.typography_preset }} {% if section.settings.heading_size != 'default' %}{{ section.settings.heading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_heading_xs %} uppercase{% endif %}{% if settings.bolder_font_heading_xs %} bolder-font{% endif %}{% endif %}{% endif %} {% if settings.center_text %} center{% endif %}">
        {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}<span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{% endif %}
        {% if section.settings.heading != blank %}    
            {% liquid
                assign heading_text = section.settings.heading | escape
                assign final_text = ''
                assign split_text_curly = heading_text | split: '{'
                for part in split_text_curly
                    if part contains '}'
                        assign split_curly = part | split: '}'
                        assign styled_text = split_curly[0]
                        assign after_curly = split_curly[1]
                        assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                    else
                        assign final_text = final_text | append: part
                    endif
                endfor
            %}
            {{ final_text }}
        {% else %}
            {{ page.title | escape }}
          {% endif %}
        {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}</span>{% endif %}
        </{{ section.settings.heading_tag }}>{% endunless %}
        <div class="page__content body-text--{{ settings.typography_preset }} rte{% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %}{% if section.settings.text_size != 'default' %} {{ section.settings.text_size }}{% endif %}">
        {{ page.content }}
        </div>
    </div>
</div>

