{% liquid
  comment
    Primary data source: metaobject type "retailer"
    Fallback: section blocks (used until metaobjects are populated)
  endcomment
  assign retailer_entries = shop.metaobjects.retailer.values
  assign use_metaobjects  = false
  if retailer_entries.size > 0
    assign use_metaobjects = true
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    {% if section.settings.varty_color_scheme != blank %}
      {% render 'varty-color-vars', scheme: section.settings.varty_color_scheme %}
    {% else %}
      --layout-background-color: {{ section.settings.background_color.red }}, {{ section.settings.background_color.green }}, {{ section.settings.background_color.blue }};
      --layout-text-color: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    {% endif %}
    background-color: rgb(var(--layout-background-color, 252, 242, 211));
    color: rgb(var(--layout-text-color, 84, 99, 179));
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__contact {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__heading {
    margin: 0 0 1.25rem;
    color: inherit;
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: clamp(3.1rem, 5.1vw, 5.25rem) !important;
    line-height: 0.95 !important;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__intro {
    max-width: 44rem;
    color: inherit;
    font-size: clamp(1.45rem, 1.75vw, 1.95rem);
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__image-stack {
    position: relative;
    width: min(100%, 420px);
    min-height: 300px;
    margin-top: clamp(72px, 10vw, 140px);
  }

  #shopify-section-{{ section.id }} .custom-store-finder__image {
    position: absolute;
    display: block;
    border-radius: 8px;
    object-fit: cover;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__image--back {
    left: 0;
    bottom: 0;
    width: 72%;
    aspect-ratio: 0.82;
    background: linear-gradient(140deg, #8f5a31, #c9834d 48%, #563720);
  }

  #shopify-section-{{ section.id }} .custom-store-finder__image--front {
    right: 0;
    top: 0;
    width: 72%;
    aspect-ratio: 1.04;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    background: #fff;
    border-radius: 32px;
    padding: clamp(40px, 5vw, 64px);
  }

  #shopify-section-{{ section.id }} .custom-store-finder__field--full,
  #shopify-section-{{ section.id }} .custom-store-finder__submit {
    grid-column: auto;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__field label {
    display: block;
    margin-bottom: 8px;
    color: inherit;
    font-size: clamp(1.05rem, 1.25vw, 1.3rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__field input,
  #shopify-section-{{ section.id }} .custom-store-finder__field textarea {
    width: 100%;
    border: 0;
    border-bottom: 1.5px solid currentColor;
    border-radius: 0;
    background: transparent;
    color: inherit;
    padding: 12px 0 16px;
    min-height: 48px;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__field textarea {
    min-height: 144px;
    resize: vertical;
  }

  #shopify-section-{{ section.id }} .custom-store-finder__submit {
    justify-self: stretch;
    border: 0;
    border-radius: 999px;
    background: rgb(var(--layout-text-color, 84, 99, 179));
    color: rgb(var(--layout-background-color, 252, 242, 211));
    padding: 1.1rem 2.2rem;
    font-weight: 700;
    font-size: clamp(1.15rem, 1.45vw, 1.65rem);
    letter-spacing: 0.03em;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .custom-store-finder__contact,
    #shopify-section-{{ section.id }} .custom-store-finder__form {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .custom-store-finder__submit {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .custom-store-finder__image-stack {
      margin-top: 40px;
      min-height: 240px;
    }

    #shopify-section-{{ section.id }} .custom-store-finder__form {
      padding: 28px 22px;
      border-radius: 20px;
    }
  }
</style>

<div class="custom-store-finder page-width" id="varty-store-finder-{{ section.id }}">

  {% if section.settings.contact_mode %}
    <div class="custom-store-finder__contact">
      <div class="custom-store-finder__contact-copy">
        {% if section.settings.heading != blank %}
          <h2 class="custom-store-finder__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.intro_richtext != blank %}
          <div class="custom-store-finder__intro rte">{{ section.settings.intro_richtext }}</div>
        {% endif %}
        <div class="custom-store-finder__image-stack" aria-hidden="true">
          {% if section.settings.contact_back_image != blank %}
            {{ section.settings.contact_back_image | image_url: width: 720 | image_tag: class: 'custom-store-finder__image custom-store-finder__image--back', loading: 'lazy', alt: '' }}
          {% else %}
            <div class="custom-store-finder__image custom-store-finder__image--back"></div>
          {% endif %}

          {% if section.settings.contact_front_image != blank %}
            {{ section.settings.contact_front_image | image_url: width: 720 | image_tag: class: 'custom-store-finder__image custom-store-finder__image--front', loading: 'lazy', alt: '' }}
          {% else %}
            <img
              class="custom-store-finder__image custom-store-finder__image--front"
              src="{{ 'varty-about-wix-mission-left.png' | asset_url }}"
              alt=""
              loading="lazy"
              width="720"
              height="540"
            >
          {% endif %}
        </div>
      </div>

      {% form 'contact', class: 'custom-store-finder__form' %}
        <div class="custom-store-finder__field">
          <label for="ContactFormName-{{ section.id }}">FULL NAME</label>
          <input id="ContactFormName-{{ section.id }}" type="text" name="contact[name]" required>
        </div>
        <div class="custom-store-finder__field">
          <label for="ContactFormCompany-{{ section.id }}">COMPANY / STORE</label>
          <input id="ContactFormCompany-{{ section.id }}" type="text" name="contact[company]">
        </div>
        <div class="custom-store-finder__field">
          <label for="ContactFormEmail-{{ section.id }}">EMAIL ADDRESS *</label>
          <input id="ContactFormEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
        </div>
        <div class="custom-store-finder__field custom-store-finder__field--full">
          <label for="ContactFormMessage-{{ section.id }}">MESSAGE</label>
          <textarea id="ContactFormMessage-{{ section.id }}" name="contact[body]" rows="5" required></textarea>
        </div>
        <button type="submit" class="custom-store-finder__submit">SUBMIT</button>
      {% endform %}
    </div>
  {% else %}

  {% if section.settings.heading != blank %}
    <div class="custom-store-finder__header">
      <h2 class="custom-store-finder__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.intro_richtext != blank %}
        <div class="custom-store-finder__intro rte">{{ section.settings.intro_richtext }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if section.settings.enable_search or section.settings.enable_region_filter %}
    <div class="custom-store-finder__controls">
      {% if section.settings.enable_search %}
        <input
          class="varty-store-finder__search"
          type="search"
          placeholder="{{ 'sections.store_finder.search_placeholder' | t }}"
          aria-label="{{ 'sections.store_finder.search_placeholder' | t }}"
          id="varty-sf-search-{{ section.id }}"
        />
      {% endif %}
      {% if section.settings.enable_region_filter %}
        <div class="varty-store-finder__filter" id="varty-sf-filter-{{ section.id }}" role="group" aria-label="Filter by region">
          <button class="varty-store-finder__filter-btn varty-store-finder__filter-btn--active" data-region="all">
            {{ 'sections.store_finder.all_regions' | t }}
          </button>
          {% comment %} Region buttons injected by JS after DOM parse {% endcomment %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="varty-store-finder__grid" id="varty-sf-grid-{{ section.id }}">

    {% if use_metaobjects %}
      {% comment %} --- Metaobject source --- {% endcomment %}
      {% for retailer in retailer_entries %}
        <div
          class="varty-store-finder__card"
          data-name="{{ retailer.name.value | downcase }}"
          data-city="{{ retailer.city.value | downcase }}"
          data-region="{{ retailer.region.value | downcase }}"
        >
          <div class="varty-store-finder__card-name">{{ retailer.name.value | escape }}</div>
          <div class="varty-store-finder__card-address">{{ retailer.address.value | escape }}</div>
          <div class="varty-store-finder__card-city">{{ retailer.city.value | escape }}, {{ retailer.region.value | escape }} {{ retailer.postal_code.value | escape }}</div>
          {% if retailer.url.value != blank %}
            <a
              class="varty-store-finder__card-link"
              href="{{ retailer.url.value }}"
              target="_blank"
              rel="noopener"
            >{{ 'sections.store_finder.directions_label' | t }}</a>
          {% endif %}
        </div>
      {% endfor %}

    {% else %}
      {% comment %} --- Block fallback source --- {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'retailer' %}
          <div
            class="varty-store-finder__card"
            data-name="{{ block.settings.name | downcase }}"
            data-city="{{ block.settings.city | downcase }}"
            data-region="{{ block.settings.region | downcase }}"
            {{ block.shopify_attributes }}
          >
            <div class="varty-store-finder__card-name">{{ block.settings.name | escape }}</div>
            <div class="varty-store-finder__card-address">{{ block.settings.address | escape }}</div>
            <div class="varty-store-finder__card-city">{{ block.settings.city | escape }}{% if block.settings.region != blank %}, {{ block.settings.region | escape }}{% endif %} {{ block.settings.postal_code | escape }}</div>
            {% if block.settings.url != blank %}
              <a
                class="varty-store-finder__card-link"
                href="{{ block.settings.url }}"
                target="_blank"
                rel="noopener"
              >{{ 'sections.store_finder.directions_label' | t }}</a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}

  </div><!-- /.varty-store-finder__grid -->

  <p class="varty-store-finder__no-results" id="varty-sf-empty-{{ section.id }}" style="display:none;text-align:center;padding:24px 0;opacity:0.7;">
    {{ 'sections.store_finder.no_results' | t }}
  </p>

  {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
    <div class="custom-store-finder__cta">
      <a class="button" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }}</a>
    </div>
  {% endif %}

  {% endif %}

</div>

<script>
(function(){
  var sid = '{{ section.id }}';
  var grid    = document.getElementById('varty-sf-grid-' + sid);
  var search  = document.getElementById('varty-sf-search-' + sid);
  var filter  = document.getElementById('varty-sf-filter-' + sid);
  var empty   = document.getElementById('varty-sf-empty-' + sid);
  if (!grid) return;

  var cards = Array.from(grid.querySelectorAll('.varty-store-finder__card'));
  var activeRegion = 'all';
  var searchVal    = '';

  // Build region buttons from card data
  if (filter) {
    var regions = ['all'];
    cards.forEach(function(c){ var r = c.dataset.region; if(r && regions.indexOf(r)===-1) regions.push(r); });
    regions.slice(1).forEach(function(r){
      var btn = document.createElement('button');
      btn.className = 'varty-store-finder__filter-btn';
      btn.dataset.region = r;
      btn.textContent = r.charAt(0).toUpperCase() + r.slice(1);
      filter.appendChild(btn);
    });
    filter.addEventListener('click', function(e){
      var btn = e.target.closest('.varty-store-finder__filter-btn');
      if(!btn) return;
      activeRegion = btn.dataset.region;
      filter.querySelectorAll('.varty-store-finder__filter-btn').forEach(function(b){ b.classList.remove('varty-store-finder__filter-btn--active'); });
      btn.classList.add('varty-store-finder__filter-btn--active');
      applyFilters();
    });
  }

  if (search) {
    search.addEventListener('input', function(){ searchVal = this.value.toLowerCase().trim(); applyFilters(); });
  }

  function applyFilters(){
    var visible = 0;
    cards.forEach(function(c){
      var matchRegion = (activeRegion === 'all') || (c.dataset.region === activeRegion);
      var matchSearch = !searchVal || c.dataset.name.indexOf(searchVal) > -1 || c.dataset.city.indexOf(searchVal) > -1;
      var show = matchRegion && matchSearch;
      c.style.display = show ? '' : 'none';
      if(show) visible++;
    });
    if(empty) empty.style.display = visible === 0 ? '' : 'none';
  }
})();
</script>

{% schema %}
{
  "name": "Store Finder",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "contact_mode",
      "label": "Render contact form instead of stockist cards",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Varty Near You"
    },
    {
      "type": "richtext",
      "id": "intro_richtext",
      "label": "Intro text",
      "default": "<p>Available at 22 locations across Québec.</p>"
    },
    {
      "type": "image_picker",
      "id": "contact_back_image",
      "label": "Contact collage back image"
    },
    {
      "type": "image_picker",
      "id": "contact_front_image",
      "label": "Contact collage front image"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable search bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_region_filter",
      "label": "Enable region filter buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "See All Stockists"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button URL"
    },
    {
      "type": "select",
      "id": "varty_color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme_brand_beige", "label": "Brand beige" },
        { "value": "scheme_brand_purple", "label": "Brand purple" }
      ],
      "default": "scheme_brand_beige"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#fcf2d3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#2D2D5E"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": "Desktop padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "label": "Desktop padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "label": "Mobile padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "label": "Mobile padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "retailer",
      "name": "Retailer",
      "settings": [
        { "type": "text", "id": "name",        "label": "Store name"    },
        { "type": "text", "id": "address",     "label": "Address"       },
        { "type": "text", "id": "city",        "label": "City"          },
