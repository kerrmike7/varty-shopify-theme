{% style %}
  #shopify-section-{{ section.id }} {
    background: #5463b3;
    color: #fcf2d3;
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix {
    padding: clamp(34px, 4.2vw, 56px) clamp(18px, 2vw, 40px) clamp(46px, 5vw, 72px);
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(10px, 0.85vw, 16px);
    max-width: 1820px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__image-panel,
  #shopify-section-{{ section.id }} .varty-wholesale-wix__content-panel {
    position: relative;
    min-height: clamp(540px, 35.5vw, 720px);
    overflow: hidden;
    border-radius: clamp(20px, 1.5vw, 28px);
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__image-panel img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: center bottom;
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__content-panel {
    display: flex;
    align-items: center;
    background: #fcf2d3;
    color: #5463b3;
    padding: clamp(44px, 4vw, 74px);
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__content {
    position: relative;
    z-index: 1;
    max-width: 760px;
    padding-bottom: clamp(36px, 4.4vw, 82px);
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__heading {
    margin: 0;
    color: inherit;
    font-family: "Avenir Next", "Arial Black", Arial, sans-serif;
    font-size: clamp(3rem, 4.15vw, 5rem) !important;
    font-weight: 900;
    line-height: 0.98 !important;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__body {
    max-width: 760px;
    margin-top: clamp(22px, 1.85vw, 34px);
    color: inherit;
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(1.35rem, 1.45vw, 1.8rem);
    line-height: 1.34;
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__body p {
    margin: 0 0 1em;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__body p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: clamp(24px, 2.2vw, 38px);
    min-height: 58px;
    padding: 0 30px;
    border: 0;
    border-radius: 999px;
    background: #5463b3;
    color: #fcf2d3;
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(1rem, 1.02vw, 1.25rem);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .varty-wholesale-wix__flower {
    position: absolute;
    right: clamp(-146px, -6vw, -82px);
    bottom: clamp(-150px, -6vw, -86px);
    width: clamp(280px, 20vw, 430px);
    height: auto;
    pointer-events: none;
  }

  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .varty-wholesale-wix {
      padding: 28px 16px 48px;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__image-panel,
    #shopify-section-{{ section.id }} .varty-wholesale-wix__content-panel {
      min-height: auto;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__image-panel {
      aspect-ratio: 1 / 1;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__content-panel {
      padding: 34px 24px 150px;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__content {
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__heading {
      font-size: clamp(2.75rem, 13vw, 4rem) !important;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__body {
      font-size: 1.25rem;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__button {
      min-height: 56px;
      padding-inline: 26px;
    }

    #shopify-section-{{ section.id }} .varty-wholesale-wix__flower {
      width: 210px;
      right: -92px;
      bottom: -76px;
    }
  }
{% endstyle %}

<section class="varty-wholesale-wix">
  {% liquid
    assign wholesale_heading = section.settings.heading
    assign wholesale_body = section.settings.body
    assign wholesale_button_label = section.settings.button_label
    if request.locale.iso_code contains 'fr'
      assign wholesale_heading = 'varty.wholesale.page_heading' | t
      assign wholesale_body = 'varty.wholesale.page_body_html' | t
      assign wholesale_button_label = 'varty.wholesale.page_button' | t
    endif
  %}
  <div class="varty-wholesale-wix__grid">
    <div class="varty-wholesale-wix__image-panel" aria-hidden="true">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: '' }}
      {% else %}
        <img src="{{ 'varty-home-wholesale-rich.jpg' | asset_url }}" alt="" width="1200" height="1440" loading="eager">
      {% endif %}
    </div>

    <div class="varty-wholesale-wix__content-panel">
      <div class="varty-wholesale-wix__content">
        {% if wholesale_heading != blank %}
          <h1 class="varty-wholesale-wix__heading custom-heading heading_xl">
            {{ wholesale_heading }}
          </h1>
        {% endif %}

        {% if wholesale_body != blank %}
          <div class="varty-wholesale-wix__body rte">
            {{ wholesale_body }}
          </div>
        {% endif %}

        {% if wholesale_button_label != blank and section.settings.button_link != blank %}
          <a class="varty-wholesale-wix__button" href="{{ section.settings.button_link }}">
            {{ wholesale_button_label }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.flower_image != blank %}
        {{ section.settings.flower_image | image_url: width: 900 | image_tag: class: 'varty-wholesale-wix__flower', loading: 'lazy', alt: '' }}
      {% else %}
        <img class="varty-wholesale-wix__flower" src="{{ 'flower-3_4x-8.avif' | asset_url }}" alt="" width="620" height="620" loading="lazy" aria-hidden="true">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Varty wholesale Wix",
  "tag": "section",
  "class": "section-varty-wholesale-wix",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "flower_image",
      "label": "Flower image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let’s Put Something Great on Your Shelves"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Interested in carrying Varty? Tell us about your store and we’ll be in touch within 3 business days.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "APPLY TO CARRY VARTY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Varty wholesale Wix"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
