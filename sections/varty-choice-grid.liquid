{% style %}
  #shopify-section-{{ section.id }} {
    {% render 'varty-color-vars', scheme: 'scheme_brand_beige' %}
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: rgb(var(--layout-background-color));
    color: rgb(var(--layout-text-color));
  }

  #shopify-section-{{ section.id }} .varty-choice-grid {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__header {
    max-width: 820px;
    margin: 0 auto 44px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__eyebrow,
  #shopify-section-{{ section.id }} .varty-choice-grid__heading,
  #shopify-section-{{ section.id }} .varty-choice-grid__card-title,
  #shopify-section-{{ section.id }} .varty-choice-grid__card-text {
    color: #5463b3;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__eyebrow {
    margin: 0 0 14px;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__heading {
    margin: 0;
    font-size: clamp(48px, 5vw, 72px) !important;
    line-height: 0.96 !important;
    text-transform: uppercase !important;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__card {
    min-height: 100%;
    padding: 30px;
    border: 1px solid rgba(84, 99, 179, 0.24);
    border-radius: 8px;
    background: rgba(84, 99, 179, 0.06);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 18px;
    border: 2px solid #5463b3;
    border-radius: 50%;
    background: #fcf2d3;
    display: grid;
    place-items: center;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__icon img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__card-title {
    margin: 0 0 12px;
    font-size: clamp(22px, 1.67vw, 24px);
    font-weight: 800;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .varty-choice-grid__card-text {
    margin: 0;
  }

  @media screen and (max-width: 920px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.mobile_padding_top }}px;
      --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .varty-choice-grid__cards {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .varty-choice-grid__heading {
      font-size: 40px;
    }

    #shopify-section-{{ section.id }} .varty-choice-grid__card-title {
      font-size: 22px;
    }
  }
{% endstyle %}

<div class="varty-choice-grid section-padding--{{ settings.white_space }}">
  <div class="page-width page-width--{{ settings.max_page_width }}">
    <div class="varty-choice-grid__header">
      <p class="varty-choice-grid__eyebrow custom-heading body_s">{{ section.settings.eyebrow }}</p>
      <h2 class="varty-choice-grid__heading custom-heading content-heading--{{ settings.typography_preset }} heading_l">
        {{ section.settings.heading }}
      </h2>
    </div>
    <div class="varty-choice-grid__cards">
      {% for block in section.blocks %}
        <article class="varty-choice-grid__card" {{ block.shopify_attributes }}>
          <div class="varty-choice-grid__icon" aria-hidden="true">
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | asset_url }}" alt="" loading="lazy" width="64" height="64">
            {% endif %}
          </div>
          <h3 class="varty-choice-grid__card-title custom-heading heading_s">{{ block.settings.heading }}</h3>
          <p class="varty-choice-grid__card-text body-text--{{ settings.typography_preset }}">{{ block.settings.body }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Varty choice grid",
  "tag": "section",
  "class": "section-varty-choice-grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "desktop_padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding top", "default": 80 },
    { "type": "range", "id": "desktop_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding bottom", "default": 80 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "icon", "label": "Icon asset filename", "info": "e.g. mouthwatering.avif" },
        { "type": "text", "id": "icon_todo", "label": "Icon TODO" }
      ]
    }
  ],
  "presets": [
    { "name": "Varty choice grid" }
  ]
}
{% endschema %}
