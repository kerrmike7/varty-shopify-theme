{% if section.blocks.size > 0 %}
{% style %}
    #shopify-section-{{ section.id }} {
        --padding-top: {{ section.settings.desktop_padding_top }}px;
        --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
        --top-sticky-content: {{ section.settings.sticky_offset }}px;
        --focal-point: {{ section.settings.card_focal_point }};
        {% if section.settings.grid_gap_type == 'custom' %}
          --custom-column-gap-desktop: {{ section.settings.custom_column_gap_desktop }}px;
          --custom-column-gap-mobile: {{ section.settings.custom_column_gap_mobile }}px;
          --custom-row-gap-desktop: {{ section.settings.custom_row_gap_desktop }}px;
          --custom-row-gap-mobile: {{ section.settings.custom_row_gap_mobile }}px;
        {% endif %}

        {% if section.settings.color_type == 'invert' %}
            --layout-text-color:
            {{ settings.layout_background_color.red }},
            {{ settings.layout_background_color.green }},
            {{ settings.layout_background_color.blue }};
            --layout-background-color:
            {{ settings.layout_text_color.red }},
            {{ settings.layout_text_color.green }}, 
            {{ settings.layout_text_color.blue }};
            --rating-color: 
            {{ settings.layout_background_color.red }},
            {{ settings.layout_background_color.green }},
            {{ settings.layout_background_color.blue }};
        {% endif %}
        {% if section.settings.color_type == 'custom' %}
            --layout-text-color:
            {{ section.settings.text_color.red }},
            {{ section.settings.text_color.green }}, 
            {{ section.settings.text_color.blue }};
            --layout-background-color:
            {{ section.settings.background_color.red }},
            {{ section.settings.background_color.green }}, 
            {{ section.settings.background_color.blue }};
            --rating-color: 
            {{ section.settings.text_color.red }},
            {{ section.settings.text_color.green }}, 
            {{ section.settings.text_color.blue }};
        {% endif %}  
        {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
        background: {{ section.settings.background_gradient }};
        {%- else %}
        background-color: rgb(var(--layout-background-color));
        {%- endif %}
        color: rgb(var(--layout-text-color));
    }
    {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
      .gradient-heading-text--{{ section.id }} {
        background: {{ section.settings.heading_gradient }};
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
      }
    {% endif %}
    @media screen and (max-width: 920px) {
        #shopify-section-{{ section.id }} {
            --padding-top: {{ section.settings.mobile_padding_top }}px;
            --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
        }
    }
{% endstyle %}

{% liquid
    assign desktop_layout = 2 | plus: 1
    assign mobile_layout = section.settings.mobile_layout | times: 1 | at_least: 1

    if section.blocks.size < mobile_layout
      assign mobile_layout = section.blocks.size | at_least: 1
    endif

    assign desktop_media_width = desktop_layout
    assign mobile_media_width = mobile_layout

    assign disable_layout_margins = false
    if section.settings.layout_margins == 'disable'
      assign disable_layout_margins = true
    elsif section.settings.layout_margins == 'default' and settings.disable_margins
      assign disable_layout_margins = true
    endif

    assign custom_grid_gap_enabled = false
    if section.settings.grid_gap_type == 'custom'
      assign custom_grid_gap_enabled = true
      assign custom_column_gap_desktop = section.settings.custom_column_gap_desktop
      assign custom_column_gap_mobile = section.settings.custom_column_gap_mobile
    endif
    if section.settings.grid_gap_type == 'default' and settings.enable_custom_product_grid_gap
      assign custom_grid_gap_enabled = true
      assign custom_column_gap_desktop = settings.custom_product_column_gap_desktop
      assign custom_column_gap_mobile = settings.custom_product_column_gap_mobile
    endif
  
    if custom_grid_gap_enabled
      assign desktop_content_margin = false
      assign mobile_content_margin = false
      if custom_column_gap_desktop < 8
        assign desktop_content_margin = true
      endif
      if custom_column_gap_mobile < 8
        assign mobile_content_margin = true
      endif
    endif
%}

<div class="featured-products {% if custom_grid_gap_enabled %}featured-products--custom-gap{% endif %} featured-products--{{ section.id }} featured-products--{{ settings.white_space }} ordinal-section ordinal-section--{{ settings.white_space }} {% if settings.show_lines %}ordinal-section--lines lines{% endif %} {% unless disable_layout_margins %}section-padding--{{ settings.white_space }}{% endunless %} {% if disable_layout_margins %}disable-layout-margins{% endif %} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }} color-{{ section.settings.color_type }} {% if section.settings.color_type != 'default' %}no-default-color{% endif %}">
    <div class="featured-products__wrapper">
        <div class="featured-products__content sticky-content {% if section.blocks.size == 0 %}featured-products__content--relative{% endif %}">
            <div class="featured-products__content-wrapper {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %}{% if disable_layout_margins %} only-mobile-padding section-padding--{{ settings.white_space }}{% endif %}">
                {% if section.settings.context_image != blank and section.settings.context_image_position == 'above_content' %}
                  {%- render 'context-image', block_or_section: section, shopify_attributes: false -%}
                {% endif %}
                {% if section.settings.subheading != blank %}
                    {% liquid
                        assign subheading_text = section.settings.subheading
                        assign final_text = ''
                        assign split_text_curly = subheading_text | split: '{'
                        for part in split_text_curly
                            if part contains '}'
                                assign split_curly = part | split: '}'
                                assign styled_text = split_curly[0]
                                assign after_curly = split_curly[1]
                                assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                            else
                                assign final_text = final_text | append: part
                            endif
                        endfor
                    %}
                    <{{ section.settings.subheading_tag }} class="content-subheading custom-heading content-subheading--{{ settings.typography_preset }} {% if section.settings.subheading_size != 'default' %}{{ section.settings.subheading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_label %} uppercase{% endif %}{% if settings.bolder_font_label %} bolder-font{% endif %}{% endif %}{% endif %} {% if settings.dim_text %}dim{% endif %}">{{ final_text }}</{{ section.settings.subheading_tag }}>
                {% endif %}
                {% if section.settings.heading != blank %}
                    {% liquid
                        assign heading_text = section.settings.heading
                        assign final_text = ''
                        assign split_text_curly = heading_text | split: '{'
                        for part in split_text_curly
                            if part contains '}'
                                assign split_curly = part | split: '}'
                                assign styled_text = split_curly[0]
                                assign after_curly = split_curly[1]
                                assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                            else
                                assign final_text = final_text | append: part
                            endif
                        endfor
                      %}
                    <{{ section.settings.heading_tag }} class="content-heading custom-heading {% if section.settings.color_type == 'default' and settings.accent_color_for_headings %}content-heading--accent{% endif %} content-heading--{{ settings.typography_preset }} {% if section.settings.heading_size != 'default' %}{{ section.settings.heading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_heading_xs %} uppercase{% endif %}{% if settings.bolder_font_heading_xs %} bolder-font{% endif %}{% endif %}{% endif %}">
                      {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
                        <span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{{ final_text }}</span>
                      {% else %}
                        {{ final_text }}
                      {% endif %}
                    </{{ section.settings.heading_tag }}>
                {% endif %}
                {% if section.settings.text != blank %}
                    <div class="content-text content-text--{{ settings.typography_preset }} richtext {% if settings.enable_animated_underline %}richtext-link--underline{% endif %} {% if section.settings.main_text_size != 'default' %}{{ section.settings.main_text_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_body_m %} uppercase{% endif %}{% if settings.bolder_font_body_m %} bolder-font{% endif %}{% endif %}{% endif %}">
                        {{ section.settings.text }}
                    </div>
                {% endif %}
                {% if section.settings.button_label != blank %}
                    <div>
                    {% if section.settings.button_link != blank %}<a href="{{ section.settings.button_link }}" {% if section.settings.target_blank %}target="_blank"{% endif %} class="{{ section.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if section.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{% else %}
                    <span disabled class="{{ section.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if section.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{% endif %}
                {{ section.settings.button_label }}
                {% if section.settings.button_link == blank %}</span>{% else %}</a>{% endif %}
                    </div>
                {% endif %}
                {% if section.settings.context_image != blank and section.settings.context_image_position == 'below_content' %}
                  {%- render 'context-image', block_or_section: section, shopify_attributes: false -%}
                {% endif %}
            </div>
        </div>
        <div class="featured-products__cards slider-section--{{ settings.white_space }} {% if custom_grid_gap_enabled %}slider-section--custom-gap{% endif %} {% if settings.show_lines %}slider-section--lines{% endif %} slider-container-js">
            <slider-component id="GalleryViewer-{{ section.id }}" class="slider only-mobile-slider">
                {% style %}
                    .featured-products--{{ section.id }} {
                        --desktop-grid-type: {{ desktop_layout }};
                    }
                    /* Styles for full-width page without sidebars */
                    /* Mobile */
                    @media screen and (max-width: 768px) {
                        .featured-products--{{ section.id }} {
                            --desktop-grid-type: {{ mobile_layout }};
                        }
                    }
                    @media screen and (min-width: 921px) {
                        /* Mobile */
                        @container inside-content (max-width: 768px) {
                            .featured-products--{{ section.id }} {
                                --desktop-grid-type: {{ mobile_layout }};
                            }
                        }
                    }
                {% endstyle %}
                <div class="slider__viewport">
                    <ul id="Slider-Gallery-{{ section.id }}" 
                      data-id="{{ section.id }}" 
                      class="slider__grid slider__grid--{{ settings.white_space }} slider__grid-mobile-{{ mobile_layout }} {% if settings.show_lines %} lines{% endif %}"
                      data-count="{{ desktop_layout }}"
                      data-count-mobile="{{ mobile_layout }}"
                    >
                        {%- for block in section.blocks -%}
                            {% assign lazy_load = false %}
                            {%- if forloop.index > 2 -%}
                            {%- assign lazy_load = true -%}
                            {%- endif -%}
                            <li id="Slide-{{ section.id }}" class="slider__grid-item  snap-align {% if forloop.first %}is-active{% endif %}
                            {% if forloop.last and settings.show_lines and forloop.length >= mobile_layout %}last-mobile{% endif %}" {{ block.shopify_attributes }}>
                            {% if block.settings.product != blank %}
                                {% render 'card-product',
                                card_product: block.settings.product,
                                image_ratio: section.settings.card_image_ratio,
                                show_vendor: section.settings.show_vendor,
                                show_rating: section.settings.show_rating,
                                hover_behavior: section.settings.hover_behavior,
                                show_bullets: section.settings.show_bullets,
                                lazy_load: lazy_load,
                                enable_quick_view: section.settings.enable_quick_view,
                                enable_add_to_cart: section.settings.enable_add_to_cart,
                                price_position: section.settings.price_position,
                                max_product_name_characters: section.settings.max_product_name_characters,
                                show_short_description: section.settings.show_short_description,
                                enable_color_pills: section.settings.enable_color_pills,
                                show_pickup_availability: section.settings.show_pickup_availability,
                                disable_layout_margins: disable_layout_margins,
                                center_text: settings.center_text,
                                desktop_media_width: desktop_media_width,
                                mobile_media_width: mobile_media_width,
                                desktop_content_margin: desktop_content_margin,
                                mobile_content_margin: mobile_content_margin
                                %}
                            {% else %}
                            {% assign index_block = forloop.index %}
                            {% if forloop.index > 6 %}
                                {% assign index_block = '6' %}
                            {% endif %}
                            {% render 'product-placeholder',
                                index_placeholder: index_block,
                                image_ratio: section.settings.card_image_ratio,
                                show_vendor: section.settings.show_vendor,
                                price_position: section.settings.price_position,
                                disable_layout_margins: disable_layout_margins,
                                center_text: settings.center_text,
                                desktop_content_margin: desktop_content_margin,
                                mobile_content_margin: mobile_content_margin
                                %}
                            {% endif %}
                            </li>
                        {%- endfor -%}
                    </ul>

                    <div class="slider-buttons-items slider-buttons-items--bottom slider-buttons-items--{{ settings.white_space }} hidden-desktop
                      {%- if settings.show_lines %} slider-buttons-items--lines {% endif -%} 
                      {%- if disable_layout_margins %} section-padding--{{ settings.white_space }} {% endif -%}
                      {%- if section.blocks.size <= mobile_layout or section.settings.mobile_navigation == 'scrollbar' %} hidden-mobile {% endif %}"
                    >
                        {%- liquid 
                          if settings.typography_preset == 'avant_garde'
                              assign weight_close = settings.accent_icon_weight
                              if settings.swap_fonts
                                  assign weight_close = settings.base_icon_weight
                              endif
                          else 
                              assign weight_close =  settings.base_icon_weight
                              if settings.swap_fonts
                                  assign weight_close = settings.accent_icon_weight
                              endif
                          endif
                          if settings.typography_preset == 'custom'
                              assign weight_close = settings.custom_icon_weight
                          endif
                        -%}
                        <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
                          {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
                          {% render 'icon-accordion-2', icon: icon_full %}
                        </button>
                        <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                          {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
                          {% render 'icon-accordion-2', icon: icon_full %}
                        </button>
                    </div>
                    {% if section.settings.mobile_navigation == 'scrollbar' and section.blocks.size > mobile_layout %}
                        <div role="scrollbar" aria-orientation="horizontal" aria-valuemax="100" aria-valuemin="0" aria-valuenow="39" class="slider-buttons-items slider-scrollbar hidden-desktop {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
                          <span class="slider-scrollbar__track">
                            <span class="slider-scrollbar__thumb"></span>
                          </span>
                        </div>
                      {% endif %}
                </div>
            </slider-component>
        </div>
    </div>
</div>
{% endif %}

{% schema %}
{
    "name": "t:sections.featured-products.name",
    "tag": "section",
    "class": "featured-products",
    "settings": [
        {
            "type": "range",
            "id": "sticky_offset",
            "min": 24,
            "max": 160,
            "step": 4,
            "unit": "px",
            "default": 120,
            "label": "t:sections.all.sticky_offset.label",
            "info": "t:sections.all.sticky_offset.info"
        },
        {
            "type": "text",
            "id": "subheading",
            "label": "t:sections.all.labels.subheading.label",
            "default": "Hot sale"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:sections.all.labels.heading.label",
            "info": "t:sections.all.labels.heading.info",
            "default": "Sale"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:sections.all.labels.text.label",
            "default": "<p>Short description.</p>"
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "t:sections.all.buttons.button_label.label",
            "info": "t:sections.all.buttons.button_label.info",
            "default": "View all"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "t:sections.all.buttons.button_link.label"
        },
        {
            "type": "checkbox",
            "id": "target_blank",
            "default": false,
            "label": "t:sections.all.target_blank.label"
        },
        {
            "type": "select",
            "id": "button_style",
            "options": [
              {
                "value": "solid",
                "label": "t:sections.all.buttons.button_styles.options__1.label"
              }, 
              {
                "value": "outlined",
                "label": "t:sections.all.buttons.button_styles.options__2.label"
              }, 
              {
                "value": "link",
                "label": "t:sections.all.buttons.button_styles.options__3.label"
              }
            ],
            "default": "solid",
            "label": "t:sections.all.buttons.button_styles.button_style.label"
        },
        {
          "type": "select",
          "id": "grid_gap_type",
          "options": [
            {
              "value": "default",
              "label": "t:sections.all.grid_gap_type.options__1.label"
            },
            {
              "value": "custom",
              "label": "t:sections.all.grid_gap_type.options__2.label"
            }
          ],
          "default": "default",
          "label": "t:sections.all.grid_gap_type.label"
        },
        { 
            "type": "range",
            "id": "custom_column_gap_desktop",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "t:sections.all.grid_gap_type.custom_column_gap_desktop.label",
            "visible_if": "{{ section.settings.grid_gap_type == 'custom' }}",
            "default": 48
        },
        { 
          "type": "range",
          "id": "custom_row_gap_desktop",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "t:sections.all.grid_gap_type.custom_row_gap_desktop.label",
          "visible_if": "{{ section.settings.grid_gap_type == 'custom' }}",
          "default": 64
        },
        { 
            "type": "range",
            "id": "custom_column_gap_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "t:sections.all.grid_gap_type.custom_column_gap_mobile.label",
            "visible_if": "{{ section.settings.grid_gap_type == 'custom' }}",
            "default": 16
        },
        { 
            "type": "range",
            "id": "custom_row_gap_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "t:sections.all.grid_gap_type.custom_row_gap_mobile.label",
            "visible_if": "{{ section.settings.grid_gap_type == 'custom' }}",
            "default": 16
        },
        {
            "type": "radio",
            "id": "mobile_layout",
            "options": [
              {
                "value": "1",
                "label": "t:sections.all.mobile_layout.options__1.label"
              },
              {
                "value": "2",
                "label": "t:sections.all.mobile_layout.options__2.label"
              }
            ],
            "default": "2",
            "label": "t:sections.all.mobile_layout.label"
        },
        {
            "type": "select",
            "id": "mobile_navigation",
            "options": [
              {
                "value": "arrows",
                "label": "t:sections.all.mobile_navigation.options__1.label"
              },
              {
                "value": "scrollbar",
                "label": "t:sections.all.mobile_navigation.options__2.label"
              }
            ],
            "default": "arrows",
            "label": "t:sections.all.mobile_navigation.label"
        },
        {
            "type": "header",
            "content": "t:sections.all.labels.subheading.content"
        },
          {
              "type": "select",
              "id": "subheading_size",
              "options": [
                {
                    "value": "default",
                    "label": "t:sections.all.size.options__1.label"
                  },
                  {
                      "value": "heading_xl",
                      "label": "t:sections.all.size.options__2.label"
                  },
                  {
                      "value": "heading_xl_uppercase",
                      "label": "t:sections.all.size.options__3.label"
                  },
                  {
                      "value": "heading_l",
                      "label": "t:sections.all.size.options__4.label"
                  },
                  {
                      "value": "heading_l_uppercase",
                      "label": "t:sections.all.size.options__5.label"
                  },
                  {
                      "value": "heading_m",
                      "label": "t:sections.all.size.options__6.label"
                  },
                  {
                      "value": "heading_m_uppercase",
                      "label": "t:sections.all.size.options__7.label"
                  },
                  {
                      "value": "heading_s",
                      "label": "t:sections.all.size.options__8.label"
                  },
                  {
                      "value": "heading_s_uppercase",
                      "label": "t:sections.all.size.options__9.label"
                  },
                  {
                      "value": "heading_xs",
                      "label": "t:sections.all.size.options__10.label"
                  },
                  {
                      "value": "heading_xs_uppercase",
                      "label": "t:sections.all.size.options__11.label"
                  },
                  {
                      "value": "body_l",
                      "label": "t:sections.all.size.options__12.label"
                  },
                  {
                      "value": "body_l_uppercase",
                      "label": "t:sections.all.size.options__13.label"
                  },
                  {
                      "value": "body_m",
                      "label": "t:sections.all.size.options__14.label"
                  }, 
                  {
                      "value": "body_m_uppercase",
                      "label": "t:sections.all.size.options__15.label"
                  }, 
                  {
                      "value": "body_s",
                      "label": "t:sections.all.size.options__16.label"
                  }, 
                  {
                      "value": "body_s_uppercase",
                      "label": "t:sections.all.size.options__17.label"
                  }, 
                  {
                      "value": "label_font",
                      "label": "t:sections.all.size.options__18.label"
                  },
                  {
                      "value": "label_font_uppercase",
                      "label": "t:sections.all.size.options__19.label"
                  }
              ],
              "default": "default",
              "label": "t:sections.all.size.size.label"
          },
          {
            "type": "select",
            "id": "subheading_tag",
            "options": [
              {
                  "value": "h1",
                  "label": "t:sections.all.tag.options__1.label"
              },
              {
                  "value": "h2",
                  "label": "t:sections.all.tag.options__2.label"
              },
              {
                  "value": "h3",
                  "label": "t:sections.all.tag.options__3.label"
              },
              {
                  "value": "h4",
                  "label": "t:sections.all.tag.options__4.label"
              },
              {
                  "value": "h5",
                  "label": "t:sections.all.tag.options__5.label"
              },
              {
                  "value": "h6",
                  "label": "t:sections.all.tag.options__6.label"
              },
              {
                  "value": "div",
                  "label": "t:sections.all.tag.options__7.label"
              },
              {
                  "value": "span",
                  "label": "t:sections.all.tag.options__8.label"
              }, 
              {
                  "value": "p",
                  "label": "t:sections.all.tag.options__9.label"
              }
              ],
              "default": "h3",
              "label": "t:sections.all.tag.tag_label"
          },
          {
            "type": "header",
            "content": "t:sections.all.labels.heading.content"
          },
          {
              "type": "select",
