{% style %}
  #shopify-section-{{ section.id }} {
    {% render 'varty-color-vars', scheme: 'scheme_brand_purple' %}
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    position: relative;
    overflow: hidden;
    background-color: rgb(var(--layout-background-color));
    color: rgb(var(--layout-text-color));
  }

  #shopify-section-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: -1px 0 auto;
    height: 72px;
    background: #fcf2d3;
    clip-path: ellipse(62% 92% at 50% 0%);
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro {
    position: relative;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro__grid {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(320px, 1.6fr) minmax(220px, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro__content {
    position: relative;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro__arrow {
    position: absolute;
    top: -98px;
    right: -250px;
    width: clamp(150px, 14vw, 220px);
    height: auto;
    pointer-events: none;
    z-index: 2;
    transform: rotate(168deg);
    transform-origin: center;
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro__eyebrow,
  #shopify-section-{{ section.id }} .varty-pantry-intro__heading {
    color: #fcf2d3;
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro__eyebrow {
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro__heading {
    max-width: 30ch;
    margin: 0 auto;
    font-size: clamp(48px, 4.4vw, 64px) !important;
    line-height: 1.08 !important;
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro__image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
  }

  #shopify-section-{{ section.id }} .varty-pantry-intro__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 860px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.mobile_padding_top }}px;
      --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }}::before,
    #shopify-section-{{ section.id }} .varty-pantry-intro__arrow {
      display: none;
    }

    #shopify-section-{{ section.id }} .varty-pantry-intro__grid {
      display: block;
    }

    #shopify-section-{{ section.id }} .varty-pantry-intro__image {
      display: none;
    }

    #shopify-section-{{ section.id }} .varty-pantry-intro__heading {
      max-width: 22ch;
      font-size: 36px !important;
    }
  }
{% endstyle %}

<div class="varty-pantry-intro section-padding--{{ settings.white_space }}">
  <div class="page-width page-width--{{ settings.max_page_width }}">
    <div class="varty-pantry-intro__grid">
      <div class="varty-pantry-intro__image" aria-hidden="true">
        <img src="{{ section.settings.left_image | asset_url }}" alt="" loading="lazy" width="640" height="800">
      </div>
      <div class="varty-pantry-intro__content">
        {% if section.settings.arrow_asset != blank %}
          <img class="varty-pantry-intro__arrow" src="{{ section.settings.arrow_asset | asset_url }}" alt="" aria-hidden="true" loading="lazy" width="418" height="266">
        {% endif %}
        <p class="varty-pantry-intro__eyebrow custom-heading body_s">{{ section.settings.eyebrow }}</p>
        <h2 class="varty-pantry-intro__heading custom-heading content-heading--{{ settings.typography_preset }} heading_l">
          {{ section.settings.heading }}
        </h2>
      </div>
      <div class="varty-pantry-intro__image" aria-hidden="true">
        <img src="{{ section.settings.right_image | asset_url }}" alt="" loading="lazy" width="640" height="800">
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Varty pantry intro",
  "tag": "section",
  "class": "section-varty-pantry-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "left_image", "label": "Left image asset" },
    { "type": "text", "id": "right_image", "label": "Right image asset" },
    { "type": "text", "id": "arrow_asset", "label": "Arrow asset", "default": "arrow.avif" },
    { "type": "range", "id": "desktop_padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Desktop padding top", "default": 104 },
    { "type": "range", "id": "desktop_padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Desktop padding bottom", "default": 96 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 56 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 56 }
  ],
  "presets": [
    { "name": "Varty pantry intro" }
  ]
}
{% endschema %}
