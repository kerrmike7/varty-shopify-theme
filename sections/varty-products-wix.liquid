        {% else %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ 'varty-product-barista-side-2.jpg' | asset_url }}" alt="Barista Unsweetened Varty oat beverage carton story side" width="4000" height="5000" loading="lazy" hidden>
        {% endif %}
