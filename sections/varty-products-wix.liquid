          <img class="varty-product__image" data-varty-carousel-slide src="{{ section.settings.barista_side_one_image | image_url: width: 1200 }}" alt="Barista Unsweetened Varty oat beverage carton nutrition side" width="{{ section.settings.barista_side_one_image.width }}" height="{{ section.settings.barista_side_one_image.height }}" loading="lazy" hidden>
        {% else %}
