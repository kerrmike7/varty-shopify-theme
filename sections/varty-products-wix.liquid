<script>
  (() => {
    const sectionSelector = '#shopify-section-{{ section.id }}';

    function initVartyProductCarousels(root = document) {
      const scope = root.querySelector ? root : document;
      const carousels = scope === document
        ? document.querySelectorAll(`${sectionSelector} [data-varty-product-carousel]`)
        : scope.querySelectorAll('[data-varty-product-carousel]');

      carousels.forEach((carousel) => {
        if (carousel.dataset.vartyCarouselReady === 'true') return;

        const media = carousel.closest('[data-varty-product-media]');
        const slides = Array.from(carousel.querySelectorAll('[data-varty-carousel-slide]'));
        if (!media || slides.length < 2) return;

        carousel.dataset.vartyCarouselReady = 'true';
        let activeIndex = slides.findIndex((slide) => !slide.hidden);
        if (activeIndex < 0) activeIndex = 0;

        function showSlide(nextIndex) {
          slides[activeIndex].hidden = true;
          activeIndex = (nextIndex + slides.length) % slides.length;
          slides[activeIndex].hidden = false;
        }

        media.querySelectorAll('[data-varty-carousel-control]').forEach((control) => {
          control.addEventListener('click', () => {
            const direction = control.dataset.vartyCarouselControl === 'next' ? 1 : -1;
            showSlide(activeIndex + direction);
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initVartyProductCarousels());
    } else {
      initVartyProductCarousels();
    }

    document.addEventListener('shopify:section:load', (event) => initVartyProductCarousels(event.target));
  })();
</script>

