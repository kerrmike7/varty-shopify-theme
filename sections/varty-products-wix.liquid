    </div>
    <div class="varty-product__copy">
      <h2 id="varty-vanilla-title">Vanilla Unsweetened Oat Beverage Canada</h2>
      <p class="varty-product__intro">You don’t need sugar (you’re sweet enough) but a little vanilla goes a long way. Savor the natural flavors of our vanilla-flavored oat beverage, made with just 4 simple ingredients for a smooth, creamy, and subtly-sweet profile.</p>
      <ul class="varty-product__badges">
        <li>100% Certified Organic</li>
        <li>No added sugar</li>
        <li>Naturally Flavoured</li>
        <li>Creamy &amp; Smooth</li>
      </ul>
      <details open>
        <summary>4 Ingredients</summary>
        <div class="varty-product__panel">
          <ul class="varty-product__list">
            <li>Filtered Water</li>
            <li>Organic Canadian Oats</li>
            <li>Sea Salt</li>
            <li>Organic, Real Vanilla</li>
            <li>…That’s It.</li>
          </ul>
        </div>
      </details>
      <details>
        <summary>Perfect for</summary>
        <div class="varty-product__panel">
          <ul class="varty-product__list">
            <li>Morning Coffee</li>
            <li>Warm Tea</li>
            <li>Cozy Oatmeal</li>
            <li>Granola topping</li>
            <li>On its own</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <section class="varty-product" aria-labelledby="varty-barista-title">
    <div class="varty-product__media" data-varty-product-media>
      <button class="varty-product__arrow varty-product__arrow--left" type="button" data-varty-carousel-control="previous" aria-label="Previous Barista Unsweetened product image"></button>
      <div class="varty-product__carousel" data-varty-product-carousel>
        {% if section.settings.barista_image != blank %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ section.settings.barista_image | image_url: width: 1200 }}" alt="Barista Unsweetened Varty oat beverage carton front" width="{{ section.settings.barista_image.width }}" height="{{ section.settings.barista_image.height }}" loading="lazy">
        {% else %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ 'varty-product-barista-front.jpg' | asset_url }}" alt="Barista Unsweetened Varty oat beverage carton front" width="4000" height="5000" loading="lazy">
        {% endif %}
