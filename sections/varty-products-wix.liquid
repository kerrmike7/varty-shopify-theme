{% style %}
  #shopify-section-{{ section.id }} {
    --varty-products-purple: #5865ad;
    --varty-products-cream: #fcf2d3;
    --varty-products-green: #c8dfc0;
    --varty-products-text: #4f5eaa;
    background: var(--varty-products-cream);
    color: var(--varty-products-text);
  }

  #shopify-section-{{ section.id }} .varty-products {
    overflow: hidden;
    background: var(--varty-products-cream);
  }

  #shopify-section-{{ section.id }} .varty-products__hero {
    padding: clamp(142px, 10vw, 198px) clamp(24px, 5vw, 120px) clamp(70px, 6vw, 116px);
    background: var(--varty-products-purple);
    color: var(--varty-products-cream);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .varty-products__hero h1 {
    margin: 0;
    color: var(--varty-products-cream);
    font-family: "Avenir Next", "Arial Black", Arial, sans-serif;
    font-size: clamp(42px, 4.05vw, 78px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .varty-products__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(40px, 7vw, 160px);
    width: min(100%, 1450px);
    margin: clamp(128px, 9vw, 176px) auto 0;
  }

  #shopify-section-{{ section.id }} .varty-products__stat-number {
    display: block;
    color: var(--varty-products-cream);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(70px, 5.4vw, 104px);
    line-height: 0.92;
  }

  #shopify-section-{{ section.id }} .varty-products__stat-label {
    display: block;
    margin-top: 28px;
    color: var(--varty-products-cream);
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(20px, 1.35vw, 28px);
    font-weight: 800;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .varty-products__certs {
    padding: clamp(64px, 5.8vw, 112px) clamp(24px, 5.4vw, 108px) clamp(96px, 8vw, 156px);
  }

  #shopify-section-{{ section.id }} .varty-products__certs img {
    display: block;
    width: min(100%, 1700px);
    height: auto;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .varty-product {
    display: grid;
    grid-template-columns: minmax(320px, 0.78fr) minmax(0, 1.18fr);
    gap: clamp(48px, 4.8vw, 96px);
    align-items: center;
    width: min(100%, 1900px);
    margin: 0 auto;
    padding: clamp(52px, 4.6vw, 86px) clamp(42px, 4vw, 96px);
  }

  #shopify-section-{{ section.id }} .varty-product__media {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(640px, 50vw, 980px);
    border-radius: 28px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .varty-product__carousel {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  #shopify-section-{{ section.id }} .varty-product__image {
    display: block;
    width: auto;
    max-width: 76%;
    max-height: clamp(560px, 44vw, 850px);
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .varty-product__image[hidden] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .varty-product__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--varty-products-text);
    cursor: pointer;
    opacity: 0.82;
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .varty-product__arrow::before {
    content: "";
    display: block;
    width: 28px;
    height: 28px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }

  #shopify-section-{{ section.id }} .varty-product__arrow--left {
    left: 44px;
  }

  #shopify-section-{{ section.id }} .varty-product__arrow--left::before {
    transform: rotate(-135deg);
  }

  #shopify-section-{{ section.id }} .varty-product__arrow--right {
    right: 44px;
  }

  #shopify-section-{{ section.id }} .varty-product__arrow--right::before {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .varty-product__arrow:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .varty-product__copy {
    color: var(--varty-products-text);
    font-family: "Avenir Next", Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .varty-product__copy h2 {
    margin: 0 0 clamp(28px, 2vw, 38px);
    color: var(--varty-products-text);
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(38px, 3vw, 58px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .varty-product__intro {
    max-width: 47em;
    margin: 0 0 clamp(34px, 2.6vw, 52px);
    font-size: clamp(21px, 1.45vw, 30px);
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .varty-product__badges,
  #shopify-section-{{ section.id }} .varty-product__list {
    margin: 0;
    padding-left: 1.35em;
    list-style: disc;
    font-size: clamp(21px, 1.42vw, 29px);
    line-height: 1.48;
  }

  #shopify-section-{{ section.id }} .varty-product__badges {
    margin-bottom: clamp(48px, 3.7vw, 72px);
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .varty-product__badges li::marker,
  #shopify-section-{{ section.id }} .varty-product__list li::marker {
    color: var(--varty-products-text);
    font-size: 0.78em;
  }

  #shopify-section-{{ section.id }} .varty-product details {
    border-bottom: 2px solid rgba(79, 94, 170, 0.78);
  }

  #shopify-section-{{ section.id }} .varty-product summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
    cursor: pointer;
    color: var(--varty-products-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(26px, 1.9vw, 36px);
    line-height: 1.15;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .varty-product summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .varty-product summary::after {
    content: "+";
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(30px, 2.2vw, 40px);
    font-weight: 900;
  }

  #shopify-section-{{ section.id }} .varty-product details[open] summary::after {
    content: "-";
  }

  #shopify-section-{{ section.id }} .varty-product__panel {
    padding: 0 0 32px;
  }

  #shopify-section-{{ section.id }} .varty-products__testimonials {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(26px, 2vw, 34px);
    width: min(100%, 1500px);
    margin: clamp(70px, 6vw, 120px) auto clamp(106px, 8vw, 154px);
    padding-inline: 24px;
  }

  #shopify-section-{{ section.id }} .varty-products__quote {
    min-height: 410px;
    padding: clamp(44px, 4vw, 74px) clamp(32px, 3vw, 54px);
    border-radius: 24px;
    background: var(--varty-products-green);
    color: var(--varty-products-text);
  }

  #shopify-section-{{ section.id }} .varty-products__quote-mark {
    display: block;
    margin-bottom: 42px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 110px;
    font-weight: 900;
    line-height: 0.45;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .varty-products__quote p {
    margin: 0;
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(21px, 1.35vw, 28px);
    line-height: 1.48;
  }

  #shopify-section-{{ section.id }} .varty-products__quote cite {
    display: block;
    margin-top: clamp(48px, 4vw, 70px);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(24px, 1.75vw, 34px);
    font-style: normal;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .varty-products__quote small {
    display: block;
    margin-top: 12px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(17px, 1.2vw, 22px);
  }

  @media screen and (max-width: 920px) {
    #shopify-section-{{ section.id }} .varty-products__hero {
      padding: 70px 22px 58px;
    }

    #shopify-section-{{ section.id }} .varty-products__stats,
    #shopify-section-{{ section.id }} .varty-product,
    #shopify-section-{{ section.id }} .varty-products__testimonials {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .varty-products__stats {
      margin-top: 70px;
      gap: 46px;
    }

    #shopify-section-{{ section.id }} .varty-products__certs {
      padding: 44px 18px 58px;
    }

    #shopify-section-{{ section.id }} .varty-product {
      padding: 32px 20px 58px;
      gap: 34px;
    }

    #shopify-section-{{ section.id }} .varty-product__media {
      min-height: 520px;
    }

    #shopify-section-{{ section.id }} .varty-product__image {
      max-height: 460px;
    }

    #shopify-section-{{ section.id }} .varty-product__arrow--left {
      left: 22px;
    }

    #shopify-section-{{ section.id }} .varty-product__arrow--right {
      right: 22px;
    }

    #shopify-section-{{ section.id }} .varty-products__testimonials {
      margin-top: 36px;
      margin-bottom: 80px;
    }
  }
{% endstyle %}

<div class="varty-products">
  <section class="varty-products__hero" aria-labelledby="varty-products-title">
    <h1 id="varty-products-title">A LITTLE SOMETHING FOR EVERY OAT MOMENT</h1>
    <div class="varty-products__stats" aria-label="Varty product facts">
      <div>
        <span class="varty-products__stat-number">3-4</span>
        <span class="varty-products__stat-label">Ingredients per product</span>
      </div>
      <div>
        <span class="varty-products__stat-number">0%</span>
        <span class="varty-products__stat-label">Gums, fillers, or additives</span>
      </div>
      <div>
        <span class="varty-products__stat-number">100%</span>
        <span class="varty-products__stat-label">Canadian Made</span>
      </div>
    </div>
  </section>

  <section class="varty-products__certs" aria-label="Varty certifications and product attributes">
    {% if section.settings.certifications_image != blank %}
      {{ section.settings.certifications_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: 'Varty certifications and product attributes' }}
    {% else %}
      <img src="{{ 'certs.avif' | asset_url }}" alt="Varty certifications and product attributes" width="1200" height="320" loading="lazy">
    {% endif %}
  </section>

  <section class="varty-product" aria-labelledby="varty-original-title">
    <div class="varty-product__media" data-varty-product-media>
      <button class="varty-product__arrow varty-product__arrow--left" type="button" data-varty-carousel-control="previous" aria-label="Previous Original Unsweetened product image"></button>
      <div class="varty-product__carousel" data-varty-product-carousel>
        {% if section.settings.original_image != blank %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ section.settings.original_image | image_url: width: 1200 }}" alt="Original Unsweetened Varty oat beverage carton front" width="{{ section.settings.original_image.width }}" height="{{ section.settings.original_image.height }}" loading="lazy">
        {% else %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ 'varty-product-original-front.jpg' | asset_url }}" alt="Original Unsweetened Varty oat beverage carton front" width="4000" height="5000" loading="lazy">
        {% endif %}
        {% if section.settings.original_side_one_image != blank %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ section.settings.original_side_one_image | image_url: width: 1200 }}" alt="Original Unsweetened Varty oat beverage carton nutrition side" width="{{ section.settings.original_side_one_image.width }}" height="{{ section.settings.original_side_one_image.height }}" loading="lazy" hidden>
        {% else %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ 'varty-product-original-side-1.jpg' | asset_url }}" alt="Original Unsweetened Varty oat beverage carton nutrition side" width="4000" height="5000" loading="lazy" hidden>
        {% endif %}
        {% if section.settings.original_side_two_image != blank %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ section.settings.original_side_two_image | image_url: width: 1200 }}" alt="Original Unsweetened Varty oat beverage carton story side" width="{{ section.settings.original_side_two_image.width }}" height="{{ section.settings.original_side_two_image.height }}" loading="lazy" hidden>
        {% else %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ 'varty-product-original-side-2.jpg' | asset_url }}" alt="Original Unsweetened Varty oat beverage carton story side" width="4000" height="5000" loading="lazy" hidden>
        {% endif %}
      </div>
      <button class="varty-product__arrow varty-product__arrow--right" type="button" data-varty-carousel-control="next" aria-label="Next Original Unsweetened product image"></button>
    </div>
    <div class="varty-product__copy">
      <h2 id="varty-original-title">Original Unsweetened Oat Beverage Canada</h2>
      <p class="varty-product__intro">Pure. Simple. Seriously Creamy. This unsweetened, organic oat beverage contains just 3 organic ingredients, delivering the goodness of oats without added sugar or additives. Just the way you like it 🙂</p>
      <ul class="varty-product__badges">
        <li>100% Certified Organic</li>
        <li>No added sugar</li>
        <li>Versatile</li>
        <li>Creamy, “Milky” Texture</li>
      </ul>
      <details open>
        <summary>3 Ingredients</summary>
        <div class="varty-product__panel">
          <ul class="varty-product__list">
            <li>Filtered Water</li>
            <li>Organic Canadian Oats</li>
            <li>Sea Salt</li>
            <li>…That’s It.</li>
          </ul>
        </div>
      </details>
      <details>
        <summary>Perfect for</summary>
        <div class="varty-product__panel">
          <ul class="varty-product__list">
            <li>Morning Coffee</li>
            <li>Refreshing Smoothies</li>
            <li>Cereal, Muesli or Oats</li>
            <li>Creamy Baked Treats</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <section class="varty-product" aria-labelledby="varty-vanilla-title">
    <div class="varty-product__media" data-varty-product-media>
      <button class="varty-product__arrow varty-product__arrow--left" type="button" data-varty-carousel-control="previous" aria-label="Previous Vanilla Unsweetened product image"></button>
      <div class="varty-product__carousel" data-varty-product-carousel>
        {% if section.settings.vanilla_image != blank %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ section.settings.vanilla_image | image_url: width: 1200 }}" alt="Vanilla Unsweetened Varty oat beverage carton front" width="{{ section.settings.vanilla_image.width }}" height="{{ section.settings.vanilla_image.height }}" loading="lazy">
        {% else %}
          <img class="varty-product__image" data-varty-carousel-slide src="{{ 'varty-product-vanilla-front.jpg' | asset_url }}" alt="Vanilla Unsweetened Varty oat beverage carton front" width="4000" height="5000" loading="lazy">
        {% endif %}
        {% if section.settings.vanilla_side_one_image != blank %}
