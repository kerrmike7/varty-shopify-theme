{% if section.blocks.size > 0 %}

{% style %}
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.desktop_padding_top }}px;
      --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      {% if section.settings.varty_color_scheme != blank and section.settings.varty_color_scheme != 'none' %}
        {% render 'varty-color-vars', scheme: section.settings.varty_color_scheme %}
      {% elsif section.settings.color_type == 'invert' %}
      --layout-text-color:
        {{ settings.layout_background_color.red }},
        {{ settings.layout_background_color.green }},
        {{ settings.layout_background_color.blue }};
      --layout-background-color:
        {{ settings.layout_text_color.red }},
        {{ settings.layout_text_color.green }}, 
        {{ settings.layout_text_color.blue }};
      {% endif %}
      {% if section.settings.color_type == 'custom' %}
      --layout-text-color:
        {{ section.settings.text_color.red }},
        {{ section.settings.text_color.green }}, 
        {{ section.settings.text_color.blue }};
        --layout-background-color:
        {{ section.settings.background_color.red }},
        {{ section.settings.background_color.green }}, 
        {{ section.settings.background_color.blue }};
      {% endif %}
      {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
      {%- else %}
      background-color: rgb(var(--layout-background-color));
      {%- endif %}
      color: rgb(var(--layout-text-color));
    }
    {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
    .gradient-heading-text--{{ section.id }} {
      background: {{ section.settings.heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }
    {% endif %}
    {% if section.settings.collapsible_tabs_heading_color == 'gradient' and section.settings.collapsible_tabs_heading_gradient != blank %}
    .gradient-collapsible-tabs-heading-text--{{ section.id }} {
      background: {{ section.settings.collapsible_tabs_heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }
    {% endif %}
    {% if section.settings.topic_heading_color == 'gradient' and section.settings.topic_heading_gradient != blank %}
    .gradient-topic-heading-text--{{ section.id }} {
      background: {{ section.settings.topic_heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }
    {% endif %}
    @media screen and (max-width: 920px) {
      #shopify-section-{{ section.id }} {
        --padding-top: {{ section.settings.mobile_padding_top }}px;
        --padding-bottom: {{ section.settings.mobile_padding_bottom }}px; 
      }
    }
  {% endstyle %}

{% liquid
  assign uppercase_title = false
  assign bolder_title = false
  assign uppercase_text = false
  assign bolder_text = false
  if settings.typography_preset == 'custom'
    if settings.uppercase_body_l and section.settings.collapsible_tabs_size == 'default'
        assign uppercase_title = true
    endif
    if settings.bolder_font_body_l and section.settings.collapsible_tabs_size == 'default'
        assign bolder_title = true
    endif
    if settings.uppercase_body_m and section.settings.text_size == 'default'
        assign uppercase_text = true
    endif
    if settings.bolder_font_body_m and section.settings.text_size == 'default'
        assign bolder_text = true
    endif
  endif
%}

<div class="collapsible-tabs ordinal-section ordinal-section--{{ settings.white_space }} {% if settings.show_lines %}ordinal-section--lines{% endif %} collapsible-tabs--{{ settings.white_space }} {% if section.settings.section_width != 'wide' %}collapsible-tabs--{{ section.settings.section_width }}{% endif %} section-padding--{{ settings.white_space }} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }} {% if settings.show_lines %}collapsible-tabs--lines{% endif %} color-{{ section.settings.color_type }} {% if section.settings.color_type != 'default' %}no-default-color{% endif %}">
  <div class="collapsible-tabs__wrapper {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %} {% if settings.center_text %} collapsible-tabs__wrapper--center{% endif %}">
    {% if section.settings.subheading != blank or section.settings.heading != blank or section.settings.text != blank %}
      <div class="collapsible-tabs__header">
        {% if section.settings.subheading != blank %}
          {%- capture subheading_text -%}{%- render 'varty-translate-setting', value: section.settings.subheading -%}{%- endcapture -%}
          {% liquid
            assign final_text = ''
            assign split_text_curly = subheading_text | split: '{'
            for part in split_text_curly
              if part contains '}'
                assign split_curly = part | split: '}'
                assign styled_text = split_curly[0]
                assign after_curly = split_curly[1]
                assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
              else
                assign final_text = final_text | append: part
              endif
            endfor
          %}
          <{{ section.settings.subheading_tag }} class="collapsible-tabs__subheading custom-heading collapsible-tabs__subheading--{{ settings.typography_preset }} {% if section.settings.subheading_size != 'default' %}{{ section.settings.subheading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_label %} uppercase{% endif %}{% if settings.bolder_font_label %} bolder-font{% endif %}{% endif %}{% endif %}">{{ final_text }}</{{ section.settings.subheading_tag }}>
        {% endif %}
        {% if section.settings.heading != blank %}
          {%- capture heading_text -%}{%- render 'varty-translate-setting', value: section.settings.heading -%}{%- endcapture -%}
          {% liquid
            assign final_text = ''
            assign split_text_curly = heading_text | split: '{'
            for part in split_text_curly
              if part contains '}'
                assign split_curly = part | split: '}'
                assign styled_text = split_curly[0]
                assign after_curly = split_curly[1]
                assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
              else
                assign final_text = final_text | append: part
              endif
            endfor
          %}
          <{{ section.settings.heading_tag }} class="collapsible-tabs__heading custom-heading {% if section.settings.color_type == 'default' and settings.accent_color_for_headings %}collapsible-tabs__heading--accent{% endif %} collapsible-tabs__heading--{{ settings.typography_preset }} {% if section.settings.heading_size != 'default' %}{{ section.settings.heading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_heading_xs %} uppercase{% endif %}{% if settings.bolder_font_heading_xs %} bolder-font{% endif %}{% endif %}{% endif %}">
            {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
              <span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{{ final_text }}</span>
            {% else %}
              {{ final_text }}
            {% endif %}
          </{{ section.settings.heading_tag }}>
        {% endif %}
        {% if section.settings.text != blank %}<div class="collapsible-tabs__description richtext body-text--{{ settings.typography_preset }} {% if section.settings.dim_text %}dim{% endif %} {% if section.settings.main_text_size != 'default' %}{{ section.settings.main_text_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_body_m %} uppercase{% endif %}{% if settings.bolder_font_body_m %} bolder-font{% endif %}{% endif %}{% endif %} {% if settings.enable_animated_underline %}richtext-link--underline{% endif %}">{{ section.settings.text }}</div>{% endif %}
      </div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <div class="collapsible-tabs__blocks">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'tab' -%}
              {%- render 'accordion', accordion_settings: block.settings, page: block.settings.page, block_item: block, text_size: section.settings.text_size, title_size: section.settings.collapsible_tabs_size, uppercase_title: uppercase_title, bolder_title: bolder_title, uppercase_text: uppercase_text, bolder_text: bolder_text,
                  collapsible_tabs_heading_color: section.settings.collapsible_tabs_heading_color,
                  collapsible_tabs_heading_gradient: section.settings.collapsible_tabs_heading_gradient,
                  collapsible_tabs_heading_id: section.id
              -%}
            {%- when 'topic' -%}
              {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank and block.settings.button_link != blank %}
              <div class="topic-block {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %}">
                {% if block.settings.heading != blank or block.settings.description != blank %}
                  <div class="topic-block__content">
                    {% if block.settings.heading != blank %}
                      {% liquid
                        assign heading_text = block.settings.heading
                        assign final_text = ''
                        assign split_text_curly = heading_text | split: '{'
                        for part in split_text_curly
                          if part contains '}'
                            assign split_curly = part | split: '}'
                            assign styled_text = split_curly[0]
                            assign after_curly = split_curly[1]
                            assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                          else
                            assign final_text = final_text | append: part
                          endif
                        endfor
                      %}
                      <p class="topic-block__heading custom-heading topic-block__heading--{{ settings.typography_preset }} {% if section.settings.topic_heading_size != 'default' %}{{ section.settings.topic_heading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_label %} uppercase{% endif %}{% if settings.bolder_font_label %} bolder-font{% endif %}{% endif %}{% endif %}">
                        {% if section.settings.topic_heading_color == 'gradient' and section.settings.topic_heading_gradient != blank %}
                          <span class="gradient-heading-text gradient-topic-heading-text--{{ section.id }}">{{ final_text }}</span>
                        {% else %}
                          {{ final_text }}
                        {% endif %}
                      </p>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div class="topic-block__description topic-block__description--{{ settings.typography_preset }} {% if section.settings.topic_text_size != 'default' %}{{ section.settings.topic_text_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_body_m %} uppercase{% endif %}{% if settings.bolder_font_body_m %} bolder-font{% endif %}{% endif %}{% endif %} {% if block.settings.dim_text %}dim{% endif %} richtext {% if settings.enable_animated_underline %}richtext-link--underline{% endif %}">{{ block.settings.text }}</div>{% endif %}
                  </div>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  {% if block.settings.button_link != blank %}
                    <a href="{{ block.settings.button_link }}" {% if block.settings.target_blank %}target="_blank"{% endif %} class="topic-block__button {{ block.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if block.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{{ block.settings.button_label }}</a>
                  {% else %}
                    <span disabled class="topic-block__button {{ block.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if block.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{{ block.settings.button_label }}</span>
                  {% endif %}
                {% endif %}
              </div>
              {% endif %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {% endif %}
        {% if section.settings.button_label != blank %}
          {%- capture button_label -%}{%- render 'varty-translate-setting', value: section.settings.button_label -%}{%- endcapture -%}
          {% if section.settings.button_link != blank %}
            <a href="{{ section.settings.button_link }}" {% if section.settings.target_blank %}target="_blank"{% endif %} class="collapsible-tabs__button {{ section.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if section.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{{ button_label }}</a>
          {% else %}
            <span disabled class="collapsible-tabs__button {{ section.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if section.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{{ button_label }}</span>
          {% endif %}
        {% endif %}
  </div>
</div>
{% endif %}

{% schema %}
  {
    "name": "t:sections.collapsible_tabs.name",
    "tag": "section",
    "class": "section-collapsible-tabs",
    "settings": [
