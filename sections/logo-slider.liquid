            "visible_if": "{{ section.settings.color_type == 'custom' }}",
            "default": "#000000"
        },
        {
            "type": "header",
            "content": "t:sections.all.paddings.desktop_section_paddings.content"
        }, 
        {
          "type": "select",
          "id": "layout_margins",
          "options": [
            {
              "value": "default",
              "label": "t:sections.all.layout_margins.options__1.label"
            },
            {
              "value": "disable",
              "label": "t:sections.all.layout_margins.options__2.label"
            },
            {
