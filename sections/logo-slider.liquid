            "label": "t:sections.logo-slider.settings.show_lines.label"
          },
          {
            "type": "header",
            "content": "t:sections.all.colors.content"
        },
        {
          "type": "select",
          "id": "color_type",
          "label": "t:sections.all.colors.color_type.label",
          "options": [
              {
              "value": "default",
