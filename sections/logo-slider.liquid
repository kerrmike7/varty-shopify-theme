{% liquid 
  assign blocks_size = 0
  for block in section.blocks
      if block.settings.image != blank
          assign blocks_size = blocks_size | plus: 1
      endif
  endfor
  
  if request.design_mode
    assign blocks_size = section.blocks.size
  endif
%}

{% if blocks_size > 0 %}

{% liquid
  assign mobile_layout = section.settings.mobile_layout | times: 1
  if blocks_size == 1
    assign mobile_layout = 1
  endif
%}

{% style %}
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.desktop_padding_top }}px;
      --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --desktop-grid-type: {{ section.settings.desktop_grid_type }};
      max-width: 100%;
      --text-alignment: {% if section.settings.center_text %}center{% else %}flex-start{% endif %};

      {% if section.settings.color_type == 'invert' %}
      --layout-text-color:
          {{ settings.layout_background_color.red }},
          {{ settings.layout_background_color.green }},
          {{ settings.layout_background_color.blue }};
      --layout-background-color:
          {{ settings.layout_text_color.red }},
          {{ settings.layout_text_color.green }}, 
          {{ settings.layout_text_color.blue }};
      {% endif %}
      {% if section.settings.color_type == 'custom' %}
      --layout-text-color:
          {{ section.settings.text_color.red }},
          {{ section.settings.text_color.green }}, 
          {{ section.settings.text_color.blue }};
          --layout-background-color:
          {{ section.settings.background_color.red }},
          {{ section.settings.background_color.green }}, 
          {{ section.settings.background_color.blue }};
      {% endif %}

      {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
      {%- else %}
      background-color: rgb(var(--layout-background-color));
      {%- endif %}
      color: rgb(var(--layout-text-color));
    }

    @media screen and (max-width: 920px) {
      #shopify-section-{{ section.id }} {
        --padding-top: {{ section.settings.mobile_padding_top }}px;
        --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
    }

    /* Styles for full-width page without sidebars */
    /* Mobile */
    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} {
        --desktop-grid-type: {{ mobile_layout }};
      }
    }
    @media screen and (min-width: 921px) {
      /* Mobile */
      @container inside-content (max-width: 768px) {
        #shopify-section-{{ section.id }} {
          --desktop-grid-type: {{ mobile_layout }};
        }
      }
    }
{% endstyle %}

{%- liquid 
    if settings.typography_preset == 'avant_garde'
        assign weight_close = settings.accent_icon_weight
        if settings.swap_fonts
            assign weight_close = settings.base_icon_weight
        endif
    else 
        assign weight_close =  settings.base_icon_weight
        if settings.swap_fonts
            assign weight_close = settings.accent_icon_weight
        endif
    endif
    if settings.typography_preset == 'custom'
        assign weight_close = settings.custom_icon_weight
    endif

    assign settings_page_width = settings.max_page_width | append: 'px'
    if settings.max_page_width == 'full_width'
      assign settings_page_width = '100vw'
    endif

    assign mobile_block_width = '100vw'
    if mobile_layout == 2
      assign mobile_block_width = 'calc(100vw / 2)'
    endif

    assign disable_layout_margins = false
    if section.settings.layout_margins == 'disable'
      assign disable_layout_margins = true
      assign settings_page_width = '100vw'
    elsif section.settings.layout_margins == 'default' and settings.disable_margins
      assign disable_layout_margins = true
      assign settings_page_width = '100vw'
    endif
-%}

<div class="logo-slider color-{{ section.settings.color_type }} {% if section.settings.color_type != 'default' %}no-default-color{% endif %} ordinal-section ordinal-section--{{ settings.white_space }} {% if settings.show_lines %}ordinal-section--lines{% endif %} {% unless disable_layout_margins %}section-padding--{{ settings.white_space }}{% endunless %} {% if disable_layout_margins %}disable-layout-margins{% endif %} slider-container-js slider-section--{{ settings.white_space }} {% if section.settings.show_lines %}slider-section--lines{% endif %}{% if settings.show_lines %} slider-section--lines-global{% endif %} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }} slider-section-container--{{ settings.white_space }}">
    <slider-component id="GalleryViewer-{{ section.id }}" class="slider scroll-to-block">
      <div class="slider__header {% if section.settings.center_text %}slider__header-center{% endif %} {% if section.settings.heading == blank %}slider__header--hidden{% endif %} {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
        {% if section.settings.heading != blank %}
          {% liquid
            assign heading_text = section.settings.heading
            assign final_text = ''
            assign split_text_curly = heading_text | split: '{'
            for part in split_text_curly
                if part contains '}'
                    assign split_curly = part | split: '}'
                    assign styled_text = split_curly[0]
                    assign after_curly = split_curly[1]
                    assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                else
                    assign final_text = final_text | append: part
                endif
            endfor
          %}
          <{{ section.settings.heading_tag }} class="slider__heading custom-heading {% if section.settings.color_type == 'default' and settings.accent_color_for_headings %}slider__heading--accent{% endif %} slider__heading--{{ settings.typography_preset }} {% if section.settings.heading_size != 'default' %}{{ section.settings.heading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_heading_xs %} uppercase{% endif %}{% if settings.bolder_font_heading_xs %} bolder-font{% endif %}{% endif %}{% endif %} 
            {% if disable_layout_margins %} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }}{% endif %}">{{ final_text }}
          </{{ section.settings.heading_tag }}>
        {% endif %}
        {% liquid 
          assign grid_items_desktop = section.settings.desktop_grid_type | times: 1
          assign grid_items_mobile = mobile_layout
        %}
      </div>
        <div class="slider__viewport">
          <ul id="Slider-Gallery-{{ section.id }}" class="slider__grid slider__grid-mobile-{{ mobile_layout }}" role="list" 
            data-count="{{ section.settings.desktop_grid_type }}"
            data-count-mobile="{{ mobile_layout }}">
            {% for block in section.blocks %}
              {% assign mobileItems = mobile_layout %}
              {%- if block.settings.image != blank or request.design_mode -%}
                <li id="Slide-{{ section.id }}" {{ block.shopify_attributes }} class="slider__grid-item snap-align 
                  {% if forloop.first %}is-active{% endif %} 
                  {% if section.settings.desktop_grid_type == '5' and forloop.index == 4 %}no-line{% endif %}
                  {% if forloop.last and section.settings.show_lines and forloop.length >= grid_items_desktop %}last-desktop{% endif %} 
                  {% if forloop.last and section.settings.show_lines and forloop.length >= grid_items_mobile %}last-mobile{% endif %}
                  {% if blocks_size == mobileItems %}last-element{% endif %}"
                  {% if settings.disable_right_click %}oncontextmenu="return false"{% endif %}>
                  {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" {% if block.settings.target_blank %}target="_blank"{% endif %} aria-label="{{ block.settings.image.alt | escape }}" class="logo-slider__card lazy-image-container ratio-original card-js">{% endif %}
                  {% unless block.settings.link != blank %}<div class="logo-slider__card lazy-image-container ratio-original card-js">{% endunless %}
                  {%- if block.settings.image != blank -%}
                    {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
                    {% if settings.images_loading != 'disable' %}
                      <figure class="lazy-image lazy-image--{{ settings.images_loading }}" style="--desktop-asp-rat: {{ block.settings.image.aspect_ratio }}">
                    {% else %}
                      {% liquid 
                        assign lazy_load = false
                        assign items = mobile_layout
                        if forloop.index > items or section.index > 2
                          assign lazy_load = true
                        endif
                      %}
                    {% endif %}
                    <img srcset="{%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
                        {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                        {%- if block.settings.image.width >= 550 -%}{{ block.settings.image | image_url: width: 550 }} 550w,{%- endif -%}
                        {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                        {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                        {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                        {{ block.settings.image | image_url }} {{ block.settings.image.width }}w" 
                        src="{{ block.settings.image | image_url: width: 1200 }}"
                        {% if section.settings.desktop_grid_type == '4' %}
                          sizes="(max-width: 768px) {{ mobile_block_width }},(min-width: {{ settings_page_width }}) calc({{ settings_page_width }} / 4), calc(100vw / 4)"
                        {% else %}
                          sizes="(max-width: 768px) {{ mobile_block_width }}, (min-width: {{ settings_page_width }}) calc({{ settings_page_width }} / 5), calc(100vw / 5)"
                        {% endif %}
                        alt="{{ block.settings.image.alt | escape }}" 
                        {% if settings.images_loading != 'disable' %}
                          loading="lazy"
                          onload="this.parentNode.classList.add('lazyloaded');"
                        {% else %}
                          {% if lazy_load %}loading="lazy"{% endif %}
                        {% endif %}
                        draggable="false"
                        width="{{ block.settings.image.width }}" 
                        height="{{ block.settings.image.height }}" 
                        class="logo-slider__image"
                        style="object-position: {{ block.settings.image.presentation.focal_point }};">
                    {% if settings.images_loading != 'disable' %}
                      {% if settings.images_loading != 'fade_scale' %}
                      <div class="lazy-image__preloader lazy-image__preloader--full lazy-image__preloader-{{ settings.images_loading }}" aria-hidden="true">
                        <img 
                        alt="{{ block.settings.image.alt | escape }}" 
                        src="{{ block.settings.image | image_url: width: 10 }}"
                        draggable="false"
                        width="10" 
                        height="10">
                      </div>
                      {% endif %}
                  </figure>
                  {% endif %}
                      {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                  {% unless block.settings.link != blank %}</div>{% endunless %}
                  {% if block.settings.link != blank %}</a>{% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
            {% liquid 
              assign grid_items_desktop = section.settings.desktop_grid_type | times: 1
              assign grid_items_mobile = mobile_layout
            %}
            <div class="slider-buttons-items slider-buttons-items--bottom slider-buttons-items--{{ settings.white_space }} {% if section.settings.show_lines %}slider-buttons-items--lines{% endif %} {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %} 
              {% if blocks_size <= grid_items_mobile or section.settings.mobile_navigation == 'scrollbar' %}hidden-mobile{% endif %}
              {% if blocks_size <= grid_items_desktop %}hidden-desktop{% endif %}
              {% if section.settings.desktop_grid_type == '5' and blocks_size == 5 %}hidden-desktop-none{% endif %}">
              <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
                {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
                {% render 'icon-accordion-2', icon: icon_full %}
              </button>
              <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
                {% render 'icon-accordion-2', icon: icon_full %}
              </button>
            </div>
            {% if section.settings.mobile_navigation == 'scrollbar' and blocks_size > grid_items_mobile %}
              <div role="scrollbar" aria-orientation="horizontal" aria-valuemax="100" aria-valuemin="0" aria-valuenow="39" class="slider-buttons-items slider-scrollbar hidden-desktop {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
                <span class="slider-scrollbar__track">
                  <span class="slider-scrollbar__thumb"></span>
                </span>
              </div>
            {% endif %}
        </div>
    </slider-component>
    {%- if section.settings.button_label != blank -%}
      <div class="logo-slider__button {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %} {% unless section.settings.button_link != blank %}disabled{% endunless %} {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
        {%- if section.settings.button_link != blank -%}<a href="{{ section.settings.button_link }}" {% if section.settings.target_blank %}target="_blank"{% endif %} class="{{ section.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if section.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">
        {%- else -%}<span disabled class="{{ section.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if section.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{%- endif -%}
            {{ section.settings.button_label }}
          {%- unless section.settings.button_link != blank -%}</span>{%- endunless -%}
        {%- if section.settings.button_link != blank -%}</a>{%- endif -%}
      </div>
    {%- endif -%}
</div>
{% endif %}

{% schema %}
