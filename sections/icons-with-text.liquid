

{% style %}

#shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --media-size: {{ section.settings.icon_or_image_size }}px;
    {% if section.settings.varty_color_scheme != blank and section.settings.varty_color_scheme != 'none' %}
      {% render 'varty-color-vars', scheme: section.settings.varty_color_scheme %}
    {% elsif section.settings.color_type == 'invert' %}
      --layout-text-color:
        {{ settings.layout_background_color.red }},
        {{ settings.layout_background_color.green }},
        {{ settings.layout_background_color.blue }};
      --layout-background-color:
        {{ settings.layout_text_color.red }},
        {{ settings.layout_text_color.green }}, 
        {{ settings.layout_text_color.blue }};
    {% endif %}
    {% if section.settings.color_type == 'custom' %}
      --layout-text-color:
        {{ section.settings.text_color.red }},
        {{ section.settings.text_color.green }}, 
        {{ section.settings.text_color.blue }};
        --layout-background-color:
        {{ section.settings.background_color.red }},
        {{ section.settings.background_color.green }}, 
        {{ section.settings.background_color.blue }};
    {% endif %}
    {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
    background: {{ section.settings.background_gradient }};
    {%- else %}
    background-color: rgb(var(--layout-background-color));
    {%- endif %}
    color: rgb(var(--layout-text-color));
    {% if section.settings.context_icon_radius == 'default' %}
      --context-icon-radius: var(--images-and-section-radius);
    {% else %}
      --context-icon-radius: {{ section.settings.context_icon_radius }};
    {% endif %}
}
{% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
  .gradient-heading-text--{{ section.id }} {
    background: {{ section.settings.heading_gradient }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
{% endif %}
{% if section.settings.item_heading_color == 'gradient' and section.settings.item_heading_gradient != blank %}
  .gradient-item-heading-text--{{ section.id }} {
    background: {{ section.settings.item_heading_gradient }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
{% endif %}
@media screen and (max-width: 920px) {
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.mobile_padding_top }}px;
    --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
}
{% endstyle %}

{%- liquid 
  if settings.typography_preset == 'avant_garde'
    assign close_weight = settings.accent_icon_weight
    if settings.swap_fonts
        assign close_weight = settings.base_icon_weight
    endif
  else 
    assign close_weight =  settings.base_icon_weight
    if settings.swap_fonts
        assign close_weight = settings.accent_icon_weight
    endif
  endif

  if section.settings.max_columns == 'default' 
    if section.settings.desktop_grid_type == 'grid'
      if section.blocks.size == 2 or section.blocks.size == 4 or section.blocks.size > 4
          assign columns = '2'
      elsif section.blocks.size == 3
          assign columns = '3'
      else
          assign columns = '1'
      endif
    elsif section.settings.desktop_grid_type == 'slider'
      if section.blocks.size > 4
        assign columns = '4'
      else
        assign columns = section.blocks.size
      endif
    endif
  else
      assign max_columns = section.settings.max_columns | times: 1
      if section.blocks.size < max_columns
        assign columns = section.blocks.size
      else
        assign columns = max_columns
      endif
  endif
  assign mobileLayout = section.settings.mobile_layout | times: 1
  if section.blocks.size < mobileLayout
    assign mobileLayout = section.blocks.size
  endif
  if settings.typography_preset == 'custom'
    assign close_weight = settings.custom_icon_weight
  endif
  assign uppercase_heading = false
  assign bolder_heading = false
  if settings.typography_preset == 'custom' and section.settings.item_heading_size == 'default'
    if settings.uppercase_body_s
      assign uppercase_heading = true
    endif
    if settings.bolder_font_body_s
      assign bolder_heading = true
    endif
  endif
  assign uppercase_text = false
  assign bolder_text = false
  if settings.typography_preset == 'custom' and section.settings.text_size == 'default'
    if settings.uppercase_body_m
      assign uppercase_text = true
    endif
    if settings.bolder_font_body_m
      assign bolder_text = true
    endif
  endif

  assign item_heading_gradient = false
  if section.settings.item_heading_color == 'gradient' and section.settings.item_heading_gradient != blank
    assign item_heading_gradient = true
  endif
-%}
{% if section.blocks.size > 0 %}
  <div class="product-labels color-{{ section.settings.color_type }} {% if section.settings.color_type != 'default' %}no-default-color{% endif %} ordinal-section ordinal-section--{{ settings.white_space }} {% if settings.show_lines %}ordinal-section--lines{% endif %} slider-container-js product-labels--{{ settings.white_space }} {% if section.settings.desktop_grid_type == 'grid' %}product-labels--grid{% else %}product-labels--slider{% endif %} {% if settings.show_lines %}product-labels--lines{% endif %} section-padding--{{ settings.white_space }} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }}">
    {% if section.settings.desktop_grid_type != 'grid' %}<slider-component id="GalleryViewer-{{ section.id }}" class="slider-wrapper scroll-to-block">{% endif %}
    {% if section.settings.heading != blank or section.settings.heading != blank and settings.center_text == false and section.settings.center_text == false %}  
      <div class="product-labels__header {% if section.settings.center_text or settings.center_text %}center-elements{% endif %}">
          {% if section.settings.heading != blank %}
            {% liquid
              assign uppercase_font = false
              assign bolder_font = false
              if settings.typography_preset == 'custom' and section.settings.heading_size == 'default'
                if section.id contains 'main-product' or section.id contains 'featured-product'
                  if settings.uppercase_body_l
                    assign uppercase_font = true
                  endif
                  if settings.bolder_font_body_l
                    assign bolder_font = true
                  endif
                else
                  if settings.uppercase_heading_xs
                    assign uppercase_font = true
                  endif
                  if settings.bolder_font_heading_xs
                    assign bolder_font = true
                  endif
                endif
              endif
              assign heading_text = section.settings.heading
              assign final_text = ''
              assign split_text_curly = heading_text | split: '{'
              for part in split_text_curly
                  if part contains '}'
                      assign split_curly = part | split: '}'
                      assign styled_text = split_curly[0]
                      assign after_curly = split_curly[1]
                      assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                  else
                      assign final_text = final_text | append: part
                  endif
              endfor
            %}   
            <{{ section.settings.heading_tag }} class="product-labels__heading custom-heading {% unless section.id contains 'main-product' or section.id contains 'featured-product' %}{% if section.settings.color_type == 'default' and settings.accent_color_for_headings %}product-labels__heading--accent{% endif %}{% endunless %} {% if section.id contains 'main-product' or section.id contains 'featured-product' %}block-heading--{{ settings.typography_preset }}{% else %}product-labels__heading--{{ settings.typography_preset }}{% endif %} {% if section.settings.heading_size != 'default' %}{{ section.settings.heading_size }}{% else %}{% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %}{% endif %}">
              {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
                <span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{{ final_text }}</span>
              {% else %}
                {{ final_text }}
              {% endif %}
            </{{ section.settings.heading_tag }}>
          {% endif %}
        </div>
    {% endif %}
      <modal-dialog {% if section.settings.desktop_grid_type == 'slider' %} class="slider__viewport"{% endif %}>
          <div {% if section.settings.desktop_grid_type == 'slider' %}id="Slider-Gallery-{{ section.id }}"{% endif %} 
          class="mobile-grid-{{ section.settings.mobile_layout }} product-labels__container {% if section.settings.desktop_grid_type == 'grid' %}product-labels__container--{{ columns }}{% endif %} {% if section.settings.desktop_grid_type == 'slider' %}slider__grid product-labels__container--{{ columns }}{% endif %} {% if section.blocks.size == 1 %}border-none{% endif %}" 
          style="--icons_with_text-quantity: {% if section.blocks.size > 4 and section.settings.max_columns == 'default' %}4{% elsif section.settings.max_columns == 'default' %}{{ section.blocks.size }}{% elsif section.settings.max_columns != 'default' %}{{ columns }}{% endif %}" 
          data-count="{% if section.settings.max_columns == 'default' %}4{% else %}{{ max_columns }}{% endif %}" data-count-mobile="{{ mobileLayout }}">
            {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when 'item' -%}
                        {% if block.settings.icon != 'none' or block.settings.heading != 'none' or block.settings.image != blank or block.settings.text != blank or block.settings.page != blank %}
                          <div class="product-labels__item-wrapper card-js snap-align {% if forloop.first %}is-active{% endif %}
                            {% if forloop.last and settings.show_lines %}last-desktop{% endif %} 
                            {% if forloop.last and settings.show_lines and forloop.length >= mobileLayout %}last-mobile{% endif %}" {{ block.shopify_attributes }} id="Slide-{{ section.id }}" class="snap-align">
                            {%- render 'product-feature', 
                              id: block.id,
                              product_features_settings: section.settings, 
                              heading: block.settings.heading, 
                              icon: block.settings.icon, 
                              text: block.settings.text, 
                              feature_image: block.settings.image, 
                              feature_page: block.settings.page, 
                              page_content_in_popup: block.settings.page_content_in_popup,
                              uppercase_heading: uppercase_heading,
                              bolder_heading: bolder_heading,
                              uppercase_text: uppercase_text,
                              bolder_text: bolder_text,
                              item_heading_gradient: item_heading_gradient -%}
                          </div>
                        {% endif %}
                {%- endcase -%}
            {%- endfor -%}
          </div>
            {% if section.settings.desktop_grid_type == 'slider' %}
              <div class="slider-buttons-items slider-buttons-items--bottom slider-buttons-items--{{ settings.white_space }} {% if settings.show_lines %}slider-buttons-items--lines{% endif %} center {% if section.blocks.size <= mobileLayout or section.settings.mobile_navigation == 'scrollbar' %}hidden-mobile{% endif %}
              {% if section.blocks.size <= 4 and section.settings.max_columns == 'default' %}hidden-desktop{% elsif section.blocks.size <= max_columns %}hidden-desktop{% endif %}">
                <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
                  {% assign icon_full = 'arrow-long-left' | append: "-" | append: close_weight %}
                  {% render 'icon-accordion-2', icon: icon_full %}
                </button>
                <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                  {% assign icon_full = 'arrow-long-right' | append: "-" | append: close_weight %}
                  {% render 'icon-accordion-2', icon: icon_full %}
                </button>
              </div>
              {% if section.settings.mobile_navigation == 'scrollbar' and section.blocks.size > mobileLayout %}
                <div role="scrollbar" aria-orientation="horizontal" aria-valuemax="100" aria-valuemin="0" aria-valuenow="39" class="slider-buttons-items slider-scrollbar hidden-desktop">
                  <span class="slider-scrollbar__track">
                    <span class="slider-scrollbar__thumb"></span>
                  </span>
                </div>
              {% endif %}
            {% endif %}
      </modal-dialog>
      {% if section.settings.desktop_grid_type != 'grid' %}</slider-component>{% endif %}
  </div>
{% endif %}

