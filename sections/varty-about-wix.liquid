{% style %}
  #shopify-section-{{ section.id }} {
    --varty-about-purple: #5865ad;
    --varty-about-cream: #fcf2d3;
    --varty-about-green: #a8d996;
    --varty-about-blue-text: #4f5eaa;
    background: var(--varty-about-cream);
    color: var(--varty-about-blue-text);
  }

  #shopify-section-{{ section.id }} .varty-about-wix {
    overflow: hidden;
    background: var(--varty-about-cream);
  }

  #shopify-section-{{ section.id }} .varty-about-wix img {
    display: block;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .varty-about-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    min-height: clamp(700px, 50vw, 960px);
    padding: clamp(44px, 4vw, 82px) clamp(44px, 5.1vw, 104px) clamp(40px, 4.2vw, 82px);
    overflow: hidden;
    background: var(--varty-about-purple);
    color: var(--varty-about-cream);
  }

  #shopify-section-{{ section.id }} .varty-about-hero__copy {
    position: relative;
    z-index: 2;
    align-self: center;
    padding-top: 0;
  }

  #shopify-section-{{ section.id }} .varty-about-hero__eyebrow,
  #shopify-section-{{ section.id }} .varty-about-mission__eyebrow {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(24px, 1.75vw, 34px);
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .varty-about-hero__title {
    max-width: 17.5ch;
    margin: clamp(28px, 2.2vw, 42px) 0 0;
    font-family: "Avenir Next", "Arial Black", Arial, sans-serif;
    font-size: clamp(40px, 3.2vw, 66px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .varty-about-hero__stamp {
    position: absolute;
    top: clamp(128px, 15vw, 246px);
    left: min(30vw, 610px);
    z-index: 3;
    width: clamp(210px, 14vw, 310px);
    color: var(--varty-about-green);
    transform: rotate(3deg);
  }

  #shopify-section-{{ section.id }} .varty-about-hero__stamp svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .varty-about-hero__media {
    position: relative;
    z-index: 2;
    align-self: start;
    justify-self: end;
    width: min(100%, 1060px);
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .varty-about-hero__image {
    width: 100%;
    height: auto;
    border-radius: clamp(32px, 2.4vw, 46px);
  }

  #shopify-section-{{ section.id }} .varty-about-hero__flower {
    position: absolute;
    left: clamp(-178px, -8vw, -118px);
    bottom: clamp(-98px, -4.6vw, -62px);
    z-index: 1;
    width: clamp(230px, 16vw, 340px);
    height: auto;
    opacity: 0.96;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .varty-about-mission {
    position: relative;
    min-height: clamp(690px, 48vw, 920px);
    padding: clamp(66px, 5vw, 104px) 6vw 0;
    background: var(--varty-about-cream);
  }

  #shopify-section-{{ section.id }} .varty-about-mission__copy {
    position: relative;
    z-index: 4;
    max-width: 1760px;
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .varty-about-mission__eyebrow {
    color: var(--varty-about-blue-text);
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(22px, 1.45vw, 30px);
  }

  #shopify-section-{{ section.id }} .varty-about-mission__heading {
    max-width: 40ch;
    margin: 18px auto 0;
    color: var(--varty-about-blue-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(34px, 2.55vw, 58px);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .varty-about-collage {
    position: relative;
    z-index: 3;
    width: min(100%, 1780px);
    height: clamp(430px, 32vw, 650px);
    margin: clamp(62px, 5vw, 112px) auto 0;
  }

  #shopify-section-{{ section.id }} .varty-about-collage__image {
    position: absolute;
    overflow: hidden;
    border-radius: clamp(26px, 2vw, 40px);
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .varty-about-collage__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .varty-about-collage__image--left {
    top: 1%;
    left: 1.2%;
    z-index: 1;
    width: 31.5%;
    height: 61%;
  }

  #shopify-section-{{ section.id }} .varty-about-collage__image--center {
    top: 18.5%;
    left: 22%;
    z-index: 2;
    width: 58.5%;
    height: 66%;
  }

  #shopify-section-{{ section.id }} .varty-about-collage__image--right {
    top: 1%;
    right: 2.2%;
    z-index: 3;
    width: 30%;
    height: 66%;
  }

  #shopify-section-{{ section.id }} .varty-about-collage__image--left img {
    object-position: 50% 28%;
  }

  #shopify-section-{{ section.id }} .varty-about-collage__image--center img {
    object-position: 50% 54%;
  }

  #shopify-section-{{ section.id }} .varty-about-collage__image--right img {
    object-position: 50% 48%;
  }

  #shopify-section-{{ section.id }} .varty-about-wave {
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;
    z-index: 2;
    height: clamp(92px, 10vw, 170px);
    color: var(--varty-about-purple);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .varty-about-wave svg {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .varty-about-founder {
    position: relative;
    padding: clamp(58px, 4.8vw, 96px) clamp(44px, 12vw, 300px) clamp(82px, 6vw, 124px);
    z-index: 2;
    overflow: visible;
    background: var(--varty-about-purple);
    color: var(--varty-about-cream);
  }

  #shopify-section-{{ section.id }} .varty-about-founder__inner {
    position: relative;
    z-index: 2;
    max-width: 1320px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .varty-about-founder h2 {
    margin: 0 0 clamp(30px, 2.7vw, 52px);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 3vw, 62px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--varty-about-cream);
  }

  #shopify-section-{{ section.id }} .varty-about-founder__body {
    max-width: 1240px;
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(18px, 1.15vw, 25px);
    line-height: 1.46;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .varty-about-founder__body p {
    margin: 0 0 clamp(24px, 2.1vw, 42px);
  }

  #shopify-section-{{ section.id }} .varty-about-founder__body strong {
    color: var(--varty-about-cream);
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .varty-about-founder__signature {
    margin-top: clamp(34px, 3vw, 58px);
    color: var(--varty-about-green);
    font-family: "Caveat", "Dancing Script", "Brush Script MT", cursive;
    font-size: clamp(42px, 3.3vw, 68px);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .varty-about-founder__caption {
    margin-top: 18px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(16px, 1vw, 23px);
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .varty-about-founder__flower {
    position: absolute;
    right: clamp(-132px, -5.8vw, -74px);
    bottom: clamp(-132px, -5.8vw, -76px);
    z-index: 3;
    width: clamp(210px, 15vw, 300px);
    height: auto;
    opacity: 0.96;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .varty-about-values {
    position: relative;
    z-index: 1;
    padding: clamp(88px, 6.5vw, 136px) clamp(44px, 8vw, 220px) clamp(108px, 7vw, 160px);
    background: var(--varty-about-cream);
    color: var(--varty-about-blue-text);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .varty-about-values h2 {
    position: relative;
    z-index: 2;
    margin: 0;
    color: var(--varty-about-blue-text);
    font-family: "Avenir Next", "Arial Black", Arial, sans-serif;
    font-size: clamp(40px, 3.3vw, 64px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .varty-about-values__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(46px, 5vw, 120px);
    max-width: 1580px;
    margin: clamp(68px, 5.6vw, 108px) auto 0;
  }

  #shopify-section-{{ section.id }} .varty-about-value__icon {
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    margin: 0 auto clamp(24px, 1.6vw, 34px);
    border: 1.5px solid rgba(79, 94, 170, 0.72);
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .varty-about-value__icon svg {
    width: 50px;
    height: 50px;
  }

  #shopify-section-{{ section.id }} .varty-about-value h3 {
    margin: 0 0 20px;
    color: var(--varty-about-blue-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(36px, 2.5vw, 54px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .varty-about-value p {
    max-width: 380px;
    margin: 0 auto;
    color: var(--varty-about-blue-text);
    font-family: "Avenir Next", Arial, sans-serif;
    font-size: clamp(18px, 1.15vw, 25px);
    line-height: 1.42;
    letter-spacing: 0;
  }

  @media screen and (max-width: 980px) {
    #shopify-section-{{ section.id }} .varty-about-hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 56px 22px 92px;
    }

    #shopify-section-{{ section.id }} .varty-about-hero__copy {
      padding-top: 24px;
    }

    #shopify-section-{{ section.id }} .varty-about-hero__title {
      max-width: 14ch;
      font-size: clamp(42px, 13vw, 64px);
    }

    #shopify-section-{{ section.id }} .varty-about-hero__stamp {
      position: relative;
      top: auto;
      left: auto;
      width: 220px;
      margin: 28px 0 0 auto;
    }

    #shopify-section-{{ section.id }} .varty-about-hero__media {
      margin-top: 42px;
    }

    #shopify-section-{{ section.id }} .varty-about-hero__flower {
      width: 176px;
      left: -82px;
      bottom: -48px;
      opacity: 0.96;
    }

    #shopify-section-{{ section.id }} .varty-about-mission {
      min-height: auto;
      padding: 88px 20px 130px;
    }

    #shopify-section-{{ section.id }} .varty-about-mission__heading {
      font-size: clamp(34px, 9vw, 48px);
    }

    #shopify-section-{{ section.id }} .varty-about-collage {
      display: grid;
      height: auto;
      gap: 18px;
      margin-top: 56px;
    }

    #shopify-section-{{ section.id }} .varty-about-collage__image {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 1.35 / 1;
    }

    #shopify-section-{{ section.id }} .varty-about-wave {
      height: 86px;
    }

    #shopify-section-{{ section.id }} .varty-about-founder {
      padding: 76px 22px 116px;
    }

    #shopify-section-{{ section.id }} .varty-about-founder__flower {
      right: -94px;
      bottom: -64px;
      width: 190px;
      opacity: 0.95;
    }

    #shopify-section-{{ section.id }} .varty-about-values {
      padding: 112px 22px 120px;
    }

    #shopify-section-{{ section.id }} .varty-about-values__grid {
      grid-template-columns: 1fr;
      gap: 70px;
    }
  }
{% endstyle %}

<div class="varty-about-wix">
  <section class="varty-about-hero" aria-labelledby="varty-about-hero-title">
    <div class="varty-about-hero__copy">
      <span class="varty-about-hero__eyebrow">Meet Varty:</span>
      <h1 id="varty-about-hero-title" class="varty-about-hero__title" aria-label="Meet Varty: The Real, Organic Oat Beverage Canada Has Been Waiting For">THE REAL, ORGANIC OAT BEVERAGE CANADA HAS BEEN WAITING FOR</h1>
    </div>
    <div class="varty-about-hero__stamp" aria-hidden="true">
      <svg viewBox="0 0 380 130" role="img">
        <ellipse cx="190" cy="65" rx="178" ry="48" fill="none" stroke="currentColor" stroke-width="6"/>
        <text x="190" y="55" text-anchor="middle" fill="currentColor" font-family="Avenir Next, Arial Black, Arial, sans-serif" font-size="34" font-weight="900">THE CLEAN</text>
        <text x="190" y="91" text-anchor="middle" fill="currentColor" font-family="Avenir Next, Arial Black, Arial, sans-serif" font-size="34" font-weight="900">ADVANTAGE</text>
      </svg>
    </div>
    <div class="varty-about-hero__media">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1400 | image_tag: class: 'varty-about-hero__image', loading: 'eager', alt: 'Three Varty oat beverage cartons with Quebec flag illustration' }}
      {% else %}
        <img class="varty-about-hero__image" src="{{ 'varty-about-hero-lifestyle-60.jpg' | asset_url }}" alt="Three Varty oat beverage cartons with Quebec flag illustration" width="2200" height="2750" loading="eager">
      {% endif %}
    </div>
    <img class="varty-about-hero__flower" src="{{ 'varty-about-flower.avif' | asset_url }}" alt="" width="720" height="720" loading="eager" aria-hidden="true">
  </section>

  <section class="varty-about-mission" aria-labelledby="varty-about-mission-title">
    <div class="varty-about-mission__copy">
      <span class="varty-about-mission__eyebrow">Our Mission</span>
      <h2 id="varty-about-mission-title" class="varty-about-mission__heading">To create a natural oat beverage you can trust, with ingredients you’d put in your own kitchen, not a lab.</h2>
    </div>
    <div class="varty-about-collage" aria-label="Varty ingredient and product collage">
      <div class="varty-about-collage__image varty-about-collage__image--left">
        {% if section.settings.mission_left_image != blank %}
          {{ section.settings.mission_left_image | image_url: width: 760 | image_tag: loading: 'lazy', alt: 'Oats, walnuts, cinnamon, and Varty carton on a turquoise surface' }}
        {% else %}
          <img src="{{ 'varty-about-mission-left-lifestyle-7.jpg' | asset_url }}" alt="Oats, walnuts, cinnamon, and Varty carton on a turquoise surface" width="1200" height="1799" loading="lazy">
        {% endif %}
      </div>
      <div class="varty-about-collage__image varty-about-collage__image--center">
        {% if section.settings.mission_center_image != blank %}
          {{ section.settings.mission_center_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Varty cartons with a glass of oat beverage' }}
        {% else %}
          <img src="{{ 'varty-about-mission-center-lifestyle-16.jpg' | asset_url }}" alt="Varty cartons with a glass of oat beverage" width="2200" height="2750" loading="lazy">
        {% endif %}
      </div>
      <div class="varty-about-collage__image varty-about-collage__image--right">
        {% if section.settings.mission_right_image != blank %}
          {{ section.settings.mission_right_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Oats pouring into a mug next to a Varty carton' }}
        {% else %}
          <img src="{{ 'varty-about-mission-right-lifestyle-48.jpg' | asset_url }}" alt="Oats pouring into a mug next to a Varty carton" width="1200" height="1800" loading="lazy">
        {% endif %}
      </div>
    </div>
    <div class="varty-about-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 160" preserveAspectRatio="none">
        <path d="M0 58C216 19 417 5 626 44C826 82 1032 112 1440 58V160H0V58Z" fill="currentColor"/>
      </svg>
    </div>
  </section>

  <section class="varty-about-founder" aria-labelledby="varty-about-founder-title">
    <div class="varty-about-founder__inner">
      <h2 id="varty-about-founder-title">Where it all began</h2>
      <div class="varty-about-founder__body">
        <p>“Hi there! We’re Lina and Tony - the friendly faces behind VARTY, and the most relentless label-readers you’ll ever meet. Like many health-conscious consumers, we used to spend way too much time in grocery aisles, flipping cartons over and wondering how “natural” could still mean gums, fillers, and things we couldn’t pronounce.</p>
        <p>“We started Varty because we couldn’t find an oat beverage we actually felt good about. Not just nutritionally, but ethically too. So, we made our own - something that was clean, organic, and proudly made at home on Canadian soil.</p>
        <p><strong>“At Varty, we truly believe that packaged food should simplify our lives, without sacrificing quality for convenience. In a world where shortcuts are standard, oat beverages stopped tasting like oats. Ingredient lists grew longer and longer, and “natural” lost all its meaning.”</strong></p>
        <p>“But not anymore. Varty is our way of restoring what food was always meant to be: Simple, nourishing, and honest. You won’t ever catch us cutting corners or masking natural flavours.</p>
        <p>“We made Varty for ourselves, and now, we’re thrilled to be sharing it with the world. Whether you’re a health-conscious consumer or wholesaler, Varty was made for you. We made this for us – but now it’s yours. Hope you love it as much as we do.”</p>
      </div>
      <div class="varty-about-founder__signature">Lina &amp; Tony</div>
      <div class="varty-about-founder__caption">Lina &amp; Tony&nbsp;&nbsp;|&nbsp;&nbsp;Co-Founders</div>
    </div>
    <img class="varty-about-founder__flower" src="{{ 'varty-about-flower.avif' | asset_url }}" alt="" width="720" height="720" loading="lazy" aria-hidden="true">
  </section>

  <section class="varty-about-values" aria-labelledby="varty-about-values-title">
    <h2 id="varty-about-values-title">OUR CORE VALUES:</h2>
    <div class="varty-about-values__grid">
      <article class="varty-about-value">
        <div class="varty-about-value__icon" aria-hidden="true">
          <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M40 70V45"/>
            <path d="M40 45L24 61M40 45l16 16"/>
            <path d="M40 10l6 15 15-5-8 15 15 6-16 5 7 15-14-8-5 16-5-16-14 8 7-15-16-5 15-6-8-15 15 5 6-15Z"/>
          </svg>
        </div>
        <h3>Local</h3>
        <p>Proudly Canadian and made in Quebec. Supporting local producers close to home.</p>
      </article>
      <article class="varty-about-value">
        <div class="varty-about-value__icon" aria-hidden="true">
          <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 30h44L40 62 18 30Z"/>
            <path d="M27 18h26l9 12H18l9-12Z"/>
            <path d="M30 30l10 32 10-32M32 18l8 12 8-12"/>
            <path d="M18 16l-4-6M12 24H5M64 18l5-6M69 30h7M61 58l6 6"/>
          </svg>
        </div>
        <h3>Premium</h3>
        <p>Only 3-4 organic ingredients. If it’s not in your kitchen, you won’t find it in our bottle.</p>
      </article>
      <article class="varty-about-value">
        <div class="varty-about-value__icon" aria-hidden="true">
          <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M40 62V38"/>
            <path d="M40 52c-13-1-20-8-23-18 13 1 20 8 23 18Z"/>
            <path d="M40 44c-11-1-17-7-19-15 11 1 17 7 19 15Z"/>
            <path d="M40 52c13-1 20-8 23-18-13 1-20 8-23 18Z"/>
            <path d="M40 44c11-1 17-7 19-15-11 1-17 7-19 15Z"/>
            <path d="M29 65h22M34 70h12"/>
          </svg>
        </div>
        <h3>Truthful</h3>
        <p>We don’t hide behind cryptic jargon and buzzwords. We’ll let our labels do the talking.</p>
      </article>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Varty About Wix",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "mission_left_image",
      "label": "Mission collage left image"
    },
    {
      "type": "image_picker",
      "id": "mission_center_image",
      "label": "Mission collage center image"
    },
    {
      "type": "image_picker",
      "id": "mission_right_image",
      "label": "Mission collage right image"
    }
  ],
  "presets": [
    {
      "name": "Varty About Wix"
    }
  ]
}
{% endschema %}
