{% style %}
#shopify-section-{{ section.id }} {
    --grid-columns: {{ section.settings.grid_columns }};
    --left-and-right-paddings: {{ section.settings.left_and_right_paddings }}px;
    {% if section.settings.color_type == 'invert' %}
      --layout-text-color:
        {{ settings.layout_background_color.red }},
        {{ settings.layout_background_color.green }},
        {{ settings.layout_background_color.blue }};
      --layout-background-color:
        {{ settings.layout_text_color.red }},
        {{ settings.layout_text_color.green }}, 
        {{ settings.layout_text_color.blue }};
      {% endif %}
      {% if section.settings.color_type == 'custom' %}
      --layout-text-color:
        {{ section.settings.text_color.red }},
        {{ section.settings.text_color.green }}, 
        {{ section.settings.text_color.blue }};
        --layout-background-color:
        {{ section.settings.background_color.red }},
        {{ section.settings.background_color.green }}, 
        {{ section.settings.background_color.blue }};
    {% endif %}
}
{% if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
    #shopify-section-{{ section.id }} .default-menu-drawer {
        background: {{ section.settings.background_gradient }};
    }
{% endif %}
{% endstyle %}


{%- liquid
    assign blocks = section.blocks 
    assign animationDuration = 0
    if settings.animation_duration == '0.3'
        assign animationDuration = 'basic'
    elsif settings.animation_duration == '0.5'
        assign animationDuration = 'sophisticated'
    endif
    assign animated_drawer_item_index = 0
  -%}

  {%- liquid
    if settings.typography_preset == 'avant_garde'
            assign close_weight = settings.accent_icon_weight
            if settings.swap_fonts
                    assign close_weight = settings.base_icon_weight
            endif
    else
            assign close_weight =  settings.base_icon_weight
            if settings.swap_fonts
                    assign close_weight = settings.accent_icon_weight
            endif
    endif
    if settings.typography_preset == 'custom'
        assign close_weight = settings.custom_icon_weight
    endif
-%}
<menu-drawer>
<div class="menu-drawer default-menu-drawer hidden color-{{ section.settings.color_type }} {% if section.settings.color_type != 'default' %}no-default-color{% endif %}" id="menu-drawer" hidden>
    <div class="scroll-area hide-scrollbar">
        <div class="default-menu-drawer__content 
            default-menu-drawer__content--{{ settings.white_space }} 
            default-menu-drawer__content--{{ section.settings.grid_columns }}
            default-menu-drawer__content--{{ animationDuration }}{% if settings.enable_drawer_animations %} stagger stagger--{{ animationDuration }}{% endif %}">
              {%- for block in blocks -%}
              {%- assign animated_drawer_item_index = animated_drawer_item_index | plus: 1 -%}
              {%- case block.type -%}
                  {%- when 'text' -%}
                      {%- render 'text', text_settings: block.settings, type: block.type, block_item: block, for_loop: forloop, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                  {%- when 'search' -%}
                      {%- render 'search', search_settings: block.settings, type: block.type, block_item: block, for_loop: forloop, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                  {%- when 'main_menu' -%}
                      {% if block.settings.menu != blank %}
                          {%- render 'menu', menu_settings: block.settings, menu_settings_id: block.settings.menu, block_item: block, type: block.type, for_loop: forloop, menu_id: block.id, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                      {% endif %}
                  {%- when 'secondary_menu' -%}
                      {% if block.settings.menu_1 != blank or block.settings.menu_2 != blank or block.settings.menu_3 != blank or block.settings.menu_4 != blank or block.settings.menu_5 != blank %}
                          <div class="block-{{ forloop.index }} section-navigation-block {% if settings.enable_drawer_animations %} stagger__item {% endif %} menus-block {{ block.settings.menu_vertical_alignment }} menus-block--{{ section.settings.grid_columns }} menus-block--{{ block.settings.block_width }} menus-block--{{ block.settings.menu_alignment }}" style="--menus-vertical-alignment: {{ block.settings.menu_vertical_alignment }}; --menus-horizontal-alignment: {{ block.settings.menu_horizontal_alignment }}; --item-index: {{ animated_drawer_item_index }};" {{ block.shopify_attributes }}>
                              {%- liquid 
                                  assign menu_item_1 = 0 | times: 1
                                  assign menu_item_2 = 0 | times: 1
                                  assign menu_item_3 = 0 | times: 1
                                  assign menu_item_4 = 0 | times: 1
                                  assign menu_item_5 = 0 | times: 1
                                  if block.settings.menu_1 != blank
                                  assign menu_item_1 = 1 | times: 1
                                  endif
                                  if block.settings.menu_2 != blank 
                                  assign menu_item_2 = 1 | times: 1
                                  endif
                                  if block.settings.menu_3 != blank 
                                  assign menu_item_3 = 1 | times: 1
                                  endif
                                  if block.settings.menu_4 != blank 
                                  assign menu_item_4 = 1 | times: 1
                                  endif
                                  if block.settings.menu_5 != blank 
                                  assign menu_item_5 = 1 | times: 1
                                  endif
                                  assign menus_items = menu_item_1 | plus: menu_item_2 | plus: menu_item_3 | plus: menu_item_4 | plus: menu_item_5
                                  assign uppercase_font_heading = false
                                  assign bolder_font_heading = false
                                  if settings.typography_preset == 'custom' and block.settings.heading_size == 'default'
                                      if settings.uppercase_body_s
                                              assign uppercase_font_heading = true
                                      endif
                                      if settings.bolder_font_body_s
                                              assign bolder_font_heading = true
                                      endif
                                  endif
                              -%}
                              <div class="menus menus--{{ block.settings.menu_horizontal_alignment }} menus--{{ block.settings.menu_view }}" style="--menus-items: {{ menus_items }}">
                                  {% if block.settings.menu_1 != blank %}
                                      <div class="menus__item menus__item--{{ settings.white_space }}">
                                          {% if block.settings.menu_1_heading != blank %}
                                            {% liquid
                                                assign heading_text = block.settings.menu_1_heading
                                                assign final_text = ''
                                                assign split_text_curly = heading_text | split: '{'
                                                for part in split_text_curly
                                                    if part contains '}'
                                                        assign split_curly = part | split: '}'
                                                        assign styled_text = split_curly[0]
                                                        assign after_curly = split_curly[1]
                                                        assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                                                    else
                                                        assign final_text = final_text | append: part
                                                    endif
                                                endfor
                                              %}
                                              <p class="menus__item-title custom-heading menus__item-title--{{ settings.typography_preset }} {% if block.settings.heading_size != 'default' %}{{ block.settings.heading_size }}{% else %}{% if uppercase_font_heading %} uppercase{% endif %}{% if bolder_font_heading %} bolder-font{% endif %}{% endif %} subheading {% if settings.dim_text %}dim{% endif %}">{{ final_text }}</p>
                                          {% endif %}
                                          {% assign menu_id = block.id | append: '1' %}
                                          {%- render 'menu', menu_settings: block.settings, menu_settings_id: block.settings.menu_1, block_item: block, type: block.type, menu_id: menu_id -%}
                                      </div>
                                  {% endif %}
                                  {% if block.settings.menu_2 != blank %}
                                      <div class="menus__item menus__item--{{ settings.white_space }}">
                                          {% if block.settings.menu_2_heading != blank %}
                                            {% liquid
                                                assign heading_text = block.settings.menu_2_heading
                                                assign final_text = ''
                                                assign split_text_curly = heading_text | split: '{'
                                                for part in split_text_curly
                                                    if part contains '}'
                                                        assign split_curly = part | split: '}'
                                                        assign styled_text = split_curly[0]
                                                        assign after_curly = split_curly[1]
                                                        assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                                                    else
                                                        assign final_text = final_text | append: part
                                                    endif
                                                endfor
                                              %}
                                              <p class="menus__item-title custom-heading menus__item-title--{{ settings.typography_preset }} {% if block.settings.heading_size != 'default' %}{{ block.settings.heading_size }}{% else %}{% if uppercase_font_heading %} uppercase{% endif %}{% if bolder_font_heading %} bolder-font{% endif %}{% endif %} subheading {% if settings.dim_text %}dim{% endif %}">{{ final_text }}</p>
                                          {% endif %}
                                          {% assign menu_id = block.id | append: '2' %}
                                          {%- render 'menu', menu_settings: block.settings, menu_settings_id: block.settings.menu_2, block_item: block, type: block.type, menu_id: menu_id -%}
                                      </div>
                                  {% endif %}
                                  {% if block.settings.menu_3 != blank %}
                                      <div class="menus__item menus__item--{{ settings.white_space }}">
                                          {% if block.settings.menu_3_heading != blank %}
                                            {% liquid
                                                assign heading_text = block.settings.menu_3_heading
                                                assign final_text = ''
                                                assign split_text_curly = heading_text | split: '{'
                                                for part in split_text_curly
                                                    if part contains '}'
                                                        assign split_curly = part | split: '}'
                                                        assign styled_text = split_curly[0]
                                                        assign after_curly = split_curly[1]
                                                        assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                                                    else
                                                        assign final_text = final_text | append: part
                                                    endif
                                                endfor
                                              %}
                                              <p class="menus__item-title custom-heading menus__item-title--{{ settings.typography_preset }} {% if block.settings.heading_size != 'default' %}{{ block.settings.heading_size }}{% else %}{% if uppercase_font_heading %} uppercase{% endif %}{% if bolder_font_heading %} bolder-font{% endif %}{% endif %} subheading {% if settings.dim_text %}dim{% endif %}">{{ final_text }}</p>
                                          {% endif %}
                                          {% assign menu_id = block.id | append: '3' %}
                                          {%- render 'menu', menu_settings: block.settings, menu_settings_id: block.settings.menu_3, block_item: block, type: block.type, menu_id: menu_id -%}
                                      </div>
                                  {% endif %}
                                  {% if block.settings.menu_4 != blank %}
                                      <div class="menus__item menus__item--{{ settings.white_space }}">
                                          {% if block.settings.menu_4_heading != blank %}
                                            {% liquid
                                                assign heading_text = block.settings.menu_4_heading
                                                assign final_text = ''
                                                assign split_text_curly = heading_text | split: '{'
                                                for part in split_text_curly
                                                    if part contains '}'
                                                        assign split_curly = part | split: '}'
                                                        assign styled_text = split_curly[0]
                                                        assign after_curly = split_curly[1]
                                                        assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                                                    else
                                                        assign final_text = final_text | append: part
                                                    endif
                                                endfor
                                              %}
                                              <p class="menus__item-title custom-heading menus__item-title--{{ settings.typography_preset }} {% if block.settings.heading_size != 'default' %}{{ block.settings.heading_size }}{% else %}{% if uppercase_font_heading %} uppercase{% endif %}{% if bolder_font_heading %} bolder-font{% endif %}{% endif %} subheading {% if settings.dim_text %}dim{% endif %}">{{ final_text }}</p>
                                          {% endif %}
                                          {% assign menu_id = block.id | append: '4' %}
                                          {%- render 'menu', menu_settings: block.settings, menu_settings_id: block.settings.menu_4, block_item: block, type: block.type, menu_id: menu_id -%}
                                      </div>
                                  {% endif %}
                                  {% if block.settings.menu_5 != blank %}
                                      <div class="menus__item menus__item--{{ settings.white_space }}">
                                          {% if block.settings.menu_5_heading != blank %}
                                            {% liquid
                                                assign heading_text = block.settings.menu_5_heading
                                                assign final_text = ''
                                                assign split_text_curly = heading_text | split: '{'
                                                for part in split_text_curly
                                                    if part contains '}'
                                                        assign split_curly = part | split: '}'
                                                        assign styled_text = split_curly[0]
                                                        assign after_curly = split_curly[1]
                                                        assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                                                    else
                                                        assign final_text = final_text | append: part
                                                    endif
                                                endfor
                                              %}
                                              <p class="menus__item-title custom-heading menus__item-title--{{ settings.typography_preset }} {% if block.settings.heading_size != 'default' %}{{ block.settings.heading_size }}{% else %}{% if uppercase_font_heading %} uppercase{% endif %}{% if bolder_font_heading %} bolder-font{% endif %}{% endif %} subheading {% if settings.dim_text %}dim{% endif %}">{{ final_text }}</p>
                                          {% endif %}
                                          {% assign menu_id = block.id | append: '5' %}
                                          {%- render 'menu', menu_settings: block.settings, menu_settings_id: block.settings.menu_5, block_item: block, type: block.type, menu_id: menu_id -%}
                                      </div>
                                  {% endif %}
                              </div>
                          </div>
                      {% endif %}
                  {%- when 'miscellaneous' -%}
                      {%- render 'miscellaneous', miscellaneous_settings: block.settings, type: block.type, block: block, for_loop: forloop, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                  {%- when 'line' -%}
                      <div class="block-{{ forloop.index }} section-navigation-block {% if settings.enable_drawer_animations %} stagger__item {% endif %} line-container line-container--{{ section.settings.grid_columns }} line-container--{{ block.settings.block_width }} line-container--{{ section.id }}" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }} style="--line-alignment: {{ block.settings.line_alignment }}; --item-index: {{ animated_drawer_item_index }};">
                          <span class="line {% if section.settings.color_type == 'custom' %}color-custom{% elsif section.settings.color_type == 'invert' %}color-invert{% endif %}"></span>
                      </div>
                  {%- when 'newsletter' -%}
                      {%- render 'newsletter', newsletter_settings: block.settings, block_item: block, for_loop: forloop, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                  {%- when 'social_media' -%}
                      {%- render 'social-media', social-media_settings: block.settings, type: block.type, block_item: block, for_loop: forloop, section_settings: section.settings, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                  {%- when 'image' -%}
                      {%- render 'image', image_settings: block.settings, type: block.type, block_item: block, for_loop: forloop, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                  {%- when 'empty_space' -%}
                      <div class="block-{{ forloop.index }} empty-space section-navigation-block {% if settings.enable_drawer_animations %} stagger__item {% endif %} empty-space--{{ section.settings.grid_columns }} empty-space--{{ block.settings.block_width }}" {{ block.shopify_attributes }} style="--item-index: {{ animated_drawer_item_index }}"></div>
                  {%- when 'store_selector' -%}
                      <div class="block-{{ forloop.index }} section-navigation-block {% if settings.enable_drawer_animations %} stagger__item {% endif %} store-selector-container store-selector-container--{{ section.settings.grid_columns }} store-selector-container--{{ block.settings.block_width }}" 
                          style="--vertical-alignment: {{ block.settings.store_selector_vertical_alignment }};
                              --horizontal-alignment: {{ block.settings.store_selector_horizontal_alignment }}; 
                              --item-index: {{ animated_drawer_item_index }};"
                          data-block-index="{{ forloop.index0 }}"
                          {{ block.shopify_attributes }}
                      >
                          {% render 'store-selector', store_selector_settings: block.settings %}
                      </div>
                  {%- when 'country_and_language' -%}
                      {%- render 'country-and-language', country-and-language_settings: block.settings, type: block.type, for_loop: forloop, block_item: block, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                  {%- when 'contacts' -%}
                      {%- render 'contacts', contacts_settings: block.settings, for_loop: forloop, block_item: block, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
                  {%- when 'context_image' -%}
                      <div class="context-image-container section-navigation-block {% if settings.enable_drawer_animations %} stagger__item {% endif %} context-image-container--{{ section.settings.grid_columns }} context-image-container--{{ block.settings.block_width }} context-image-container--{{ block.id }}" style="--item-index: {{ animated_drawer_item_index }};" {{ block.shopify_attributes }}>
                      {%- render 'context-image', block_or_section: block, block: block -%}
                      </div>
                  {%- when 'buttons' -%}
                      <div class="navigation-buttons section-navigation-block {% if settings.enable_drawer_animations %} stagger__item {% endif %} navigation-buttons--{{ block.id }} navigation-buttons--{{ section.settings.grid_columns }} navigation-buttons--{{ block.settings.block_width }}" data-block-index="{{ forloop.index0 }}" style="--item-index: {{ animated_drawer_item_index }};" {{ block.shopify_attributes }}>
                          <div class="navigation-buttons__wrapper">
                              {%- render 'button-with-icon', button_settings: block.settings, button_label: block.settings.button_label_1, button_link: block.settings.button_link_1, button_style: block.settings.button_style_1, target_blank: block.settings.target_blank_1, icon: block.settings.icon_1, block: block -%}
                              {%- render 'button-with-icon', button_settings: block.settings, button_label: block.settings.button_label_2, button_link: block.settings.button_link_2, button_style: block.settings.button_style_2, target_blank: block.settings.target_blank_2, icon: block.settings.icon_2, block: block -%}
                          </div>
                      </div>
                  {%- when 'custom_liquid' -%}
                      {%- render 'custom-liquid', block: block, section_navigation_block: true, animated_drawer_item_index: animated_drawer_item_index -%}
              {%- endcase -%}
          {%- endfor -%}
        </div>
        <div class="button-wrapper menu-drawer__close {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %}">
            <button type="button" class="button-close">
            {% assign icon_full = 'cross' | append: "-" | append: close_weight %}
            {% render 'icon', icon: icon_full %}  
            </button>
        </div>
    </div>
</div>
</menu-drawer>

{% schema %}
{
    "name": "t:sections.menu-drawer.name",
    "settings": [
        {
            "type": "paragraph",
            "content": "t:sections.menu-drawer.settings.paragraph__1.content"
        },
        {
            "type": "select",
            "id": "grid_columns",
            "options": [
                {
                    "value": "1",
                    "label": "t:sections.navigation_sections.general.grid_columns.options__1.label"
                },
                {
                    "value": "2",
                    "label": "t:sections.navigation_sections.general.grid_columns.options__2.label"
                },
                {
                    "value": "3",
                    "label": "t:sections.navigation_sections.general.grid_columns.options__3.label"
                }
            ],
            "default": "1",
            "label": "t:sections.navigation_sections.general.grid_columns.label"
        },
        {
            "type": "paragraph",
            "content": "t:sections.navigation_sections.general.block_alignment.paragraph__1.content"
        },
        {
            "type": "header",
            "content": "t:sections.all.colors.name"
        },
        {
            "type": "select",
            "id": "color_type",
            "options": [
                {
                  "value": "default",
                  "label": "t:sections.all.colors.color_type.options__1.label"
                },
                {
                  "value": "invert",
                  "label": "t:sections.all.colors.color_type.options__2.label"
                },
                {
                  "value": "custom",
                  "label": "t:sections.all.colors.color_type.options__3.label"
                }
              ],
              "default": "default",
              "label": "t:sections.all.colors.color_type.label"
        },        
        {
          "type": "select",
          "id": "background_color_type",
          "label": "t:sections.all.colors.background_color_type.label",
          "options": [
            {
              "value": "solid",
              "label": "t:sections.all.colors.background_color_type.options__1.label"
            },
            {
              "value": "gradient",
              "label": "t:sections.all.colors.background_color_type.options__2.label"
            }
          ],
          "visible_if": "{{ section.settings.color_type == 'custom' }}",
          "default": "solid"
        },
        {
          "type": "color_background",
          "id": "background_gradient",
          "label": "t:sections.all.colors.background_gradient_type.label",
          "visible_if": "{{ section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' }}"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "t:sections.all.colors.background_solid_type.label",
          "info": "t:sections.all.colors.background_solid_type.info",
            "visible_if": "{{ section.settings.color_type == 'custom' }}",
            "default": "#FFFFFF"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "t:sections.all.colors.text_color.label",
            "visible_if": "{{ section.settings.color_type == 'custom' }}",
            "default": "#000000"
        },
        {
            "type": "header",
            "content": "t:sections.all.paddings.section_paddings.content"
        },
        {
            "type": "range",
            "id": "left_and_right_paddings",
            "min": 24,
            "max": 240,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.paddings.left_and_right_paddings.label",
            "default": 24
        }
    ],
    "blocks": [
        {
            "type": "text",
            "name": "t:sections.navigation_sections.blocks.text.name",
            "settings": [
                {
                    "type": "select",
                    "id": "block_width",
                    "options": [
                        {
                            "value": "short",
                            "label": "t:sections.navigation_sections.general.block_width.options__1.label"
                        },
                        {
                            "value": "medium",
                            "label": "t:sections.navigation_sections.general.block_width.options__2.label"
                        },
                        {
                            "value": "wide",
                            "label": "t:sections.navigation_sections.general.block_width.options__3.label"
                        }
                    ],
                    "default": "short",
                    "label": "t:sections.navigation_sections.general.block_width.label"
                },
                {
                   "type": "text",
                   "id": "text_subheading",
                   "label": "t:sections.all.labels.subheading.label"
                },
                {
                    "type": "select",
                    "id": "subheading_size",
                    "label": "t:sections.all.size.subheading_size.label",
                    "options": [
                        {
                            "value": "default",
                            "label": "t:sections.all.size.options__1.label"
                        },
                        {
                            "value": "heading_s",
                            "label": "t:sections.all.size.options__8.label"
                        },
                        {
                            "value": "heading_s_uppercase",
                            "label": "t:sections.all.size.options__9.label"
                        },
                        {
                            "value": "heading_xs",
                            "label": "t:sections.all.size.options__10.label"
                        },
                        {
                            "value": "heading_xs_uppercase",
                            "label": "t:sections.all.size.options__11.label"
                        },
                        {
                            "value": "body_l",
                            "label": "t:sections.all.size.options__12.label"
                        },
                        {
                            "value": "body_l_uppercase",
                            "label": "t:sections.all.size.options__13.label"
                        },
                        {
                            "value": "body_m",
                            "label": "t:sections.all.size.options__14.label"
                        }, 
                        {
                            "value": "body_m_uppercase",
                            "label": "t:sections.all.size.options__15.label"
                        }, 
                        {
                            "value": "body_s",
                            "label": "t:sections.all.size.options__16.label"
                        }, 
                        {
                            "value": "body_s_uppercase",
                            "label": "t:sections.all.size.options__17.label"
                        }, 
                        {
                            "value": "label_font",
                            "label": "t:sections.all.size.options__18.label"
                        },
                        {
                            "value": "label_font_uppercase",
                            "label": "t:sections.all.size.options__19.label"
                        }
                    ],
                    "default": "default"
                },
                {
