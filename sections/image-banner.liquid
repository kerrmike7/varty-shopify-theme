{% if request.design_mode or section.settings.first_image != blank or section.settings.second_image != blank %}

{% liquid
    capture is_rtl 
      render 'rtl-check'
    endcapture

    assign image_banner_overlay_background = section.settings.overlay_color
    if section.settings.overlay_gradient != blank
      assign image_banner_overlay_background = section.settings.overlay_gradient
    endif

    assign settings_page_width = settings.max_page_width | append: 'px'
    if settings.max_page_width == 'full_width'
      assign settings_page_width = '100vw'
    endif

    assign lazy_loading_images = false
    if section.index > 2 and settings.images_loading != 'disable'
      assign lazy_loading_images = true
    endif

    assign has_transparent_sidebar_navigation = false
    if section.settings.section_width == 'overlap' and settings.allow_transparent_navigation and settings.navigation_layout == 'sidebar_based'
      assign has_transparent_sidebar_navigation = true
    endif

    assign desktop_aspect = section.settings.first_image.aspect_ratio | default: section.settings.second_image.aspect_ratio | default: 1.5
    assign mobile_aspect = desktop_aspect

    assign sectionWidthInVW = 100
    assign desktopSectionHeightInVW = sectionWidthInVW | divided_by: desktop_aspect
    assign mobileSectionHeightInVW = sectionWidthInVW | divided_by: mobile_aspect

    if section.index == 1
      assign should_high_priority = true
    else
      assign should_high_priority = false
    endif

    if should_high_priority == false and lazy_loading_images or section.index > 2
      assign should_lazy_load = true
    else
      assign should_lazy_load = false
    endif
%}

{% style %}
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.desktop_padding_top }}px;
      --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --vertical-position: {{ section.settings.vertical_content_position }};
      --horizontal-position: {{ section.settings.horizontal_content_position }};
      --overlay-background: {{ image_banner_overlay_background }};
      --banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};

      {% if section.settings.height_mode == 'percents' %}
        --section-height: {{ section.settings.desktop_height }}vh;
        --section-mobile-height: {{ section.settings.mobile_height }}vh;
      {% elsif section.settings.height_mode == 'pixels' %}
        --section-height: {{ section.settings.desktop_pixels_height }}px;
        --section-mobile-height: {{ section.settings.mobile_pixels_height }}px;
      {% elsif section.settings.height_mode == 'adapt' %}
        --section-height: 100%;
        --section-mobile-height: 100%;
      {% endif %}
      
      {% if section.settings.color_type == 'invert' %}
        --layout-text-color:
          {{ settings.layout_background_color.red }},
          {{ settings.layout_background_color.green }},
          {{ settings.layout_background_color.blue }};
        --layout-background-color:
          {{ settings.layout_text_color.red }},
          {{ settings.layout_text_color.green }}, 
          {{ settings.layout_text_color.blue }};
      {% endif %}
      {% if section.settings.color_type == 'custom' %}
        --layout-text-color:
          {{ section.settings.text_color.red }},
          {{ section.settings.text_color.green }}, 
          {{ section.settings.text_color.blue }};
          --layout-background-color:
          {{ section.settings.background_color.red }},
          {{ section.settings.background_color.green }}, 
          {{ section.settings.background_color.blue }};
      {% endif %}  
      {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
            --layout-background-gradient: {{ section.settings.background_gradient }};
      {%- endif %}
      position: relative;
      color: rgb(var(--layout-text-color));
      {% if section.settings.fill_section %}
        {% if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' %}
          background: {{ section.settings.background_gradient }};
        {% else %}
          background-color: rgb(var(--layout-background-color));
        {% endif %}
      {% endif %}
    }
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'heading' %}
          {% if block.settings.heading_color == 'gradient' and block.settings.heading_gradient != blank %}
            .gradient-heading-text--{{ block.id }} {
              background: {{ block.settings.heading_gradient }};
              -webkit-background-clip: text;
              -webkit-text-fill-color: transparent;
              background-clip: text;
              color: transparent;
            }
          {% endif %}
        {% endcase %}
      {% endfor %}
    {% if section.settings.section_width == 'overlap' and settings.allow_transparent_navigation %}
      body:has(main #shopify-section-{{ section.id }}:first-child .overlapping-section) .scroll-color.section-color,
      body:has(main #shopify-section-{{ section.id }}:first-child .overlapping-section) .transparent-header.transparent,
      body:has(main #shopify-section-{{ section.id }}:first-child .overlapping-section) .shopify-section-group-more-header-sections.transparent {
        {% if section.settings.color_type == 'invert' %}
            --layout-text-color:
            {{ settings.layout_background_color.red }},
            {{ settings.layout_background_color.green }},
            {{ settings.layout_background_color.blue }};
            --layout-background-color:
            {{ settings.layout_text_color.red }},
            {{ settings.layout_text_color.green }}, 
            {{ settings.layout_text_color.blue }};
            --accent-button-color:  
            {{ settings.layout_background_color.red }},
            {{ settings.layout_background_color.green }},
            {{ settings.layout_background_color.blue }};
            --base-button-color: 
            {{ settings.layout_text_color.red }},
            {{ settings.layout_text_color.green }}, 
            {{ settings.layout_text_color.blue }};
        {% endif %}
        {% if section.settings.color_type == 'custom' %}
            --layout-text-color:
            {{ section.settings.text_color.red }},
            {{ section.settings.text_color.green }}, 
            {{ section.settings.text_color.blue }};
            --layout-background-color:
            {{ section.settings.background_color.red }},
            {{ section.settings.background_color.green }}, 
            {{ section.settings.background_color.blue }};
            --accent-button-color: 
            {{ section.settings.text_color.red }},
            {{ section.settings.text_color.green }}, 
            {{ section.settings.text_color.blue }};
            --base-button-color: 
            {{ section.settings.background_color.red }},
            {{ section.settings.background_color.green }}, 
            {{ section.settings.background_color.blue }};
        {% endif %} 
      }
      body:has(main #shopify-section-{{ section.id }}:first-child .overlapping-section) .main-sidebar.overlap-slide-out-menu-opened .scroll-color.section-color {
        --layout-background-color: 
        {{ settings.layout_background_color.red }},
        {{ settings.layout_background_color.green }},
        {{ settings.layout_background_color.blue }};
        --layout-text-color: 
        {{ settings.layout_text_color.red }},
        {{ settings.layout_text_color.green }}, 
        {{ settings.layout_text_color.blue }};
        --base-button-color: 
        {{ settings.base_button_color.red }},
        {{ settings.base_button_color.green }},
        {{ settings.base_button_color.blue }};
        --accent-button-color: 
        {{ settings.accent_button_color.red }},
        {{ settings.accent_button_color.green }},
        {{ settings.accent_button_color.blue }};
      }
      @media (hover: hover) {
        body:has(main #shopify-section-{{ section.id }}:first-child .overlapping-section) .main-sidebar.transparent-sidebar:has(.menu__dropdown-container--overlap-wrapper):hover  .scroll-color.section-color {
          --layout-background-color: 
          {{ settings.layout_background_color.red }},
          {{ settings.layout_background_color.green }},
          {{ settings.layout_background_color.blue }};
          --layout-text-color: 
          {{ settings.layout_text_color.red }},
          {{ settings.layout_text_color.green }}, 
          {{ settings.layout_text_color.blue }};
          --base-button-color: 
          {{ settings.base_button_color.red }},
          {{ settings.base_button_color.green }},
          {{ settings.base_button_color.blue }};
          --accent-button-color: 
          {{ settings.accent_button_color.red }},
          {{ settings.accent_button_color.green }},
          {{ settings.accent_button_color.blue }};
        }
      }
      body:has(main #shopify-section-{{ section.id }}:first-child .overlapping-section) .shopify-section-group-more-header-sections.transparent {
        background: transparent;
      }
    {% endif %}
    #shopify-section-{{ section.id }} .banner__content {
      {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
      {%- else %}
      background-color: rgb(var(--layout-background-color));
      {%- endif %}
      color: rgb(var(--layout-text-color));
    }
    #shopify-section-{{ section.id }} .hidden-background .banner__content-wrapper,
    #shopify-section-{{ section.id }} .banner__content {
      background: transparent;
    }
    @media screen and (max-width: 920px) {
      #shopify-section-{{ section.id }} {
        --padding-top: {{ section.settings.mobile_padding_top }}px;
        --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
      #shopify-section-{{ section.id }}:first-child,
      #shopify-section-{{ section.id }}:first-child .overlapping-section .overlapping-content-js {
          margin-top: 0 !important;
      }
    }
    #shopify-section-{{ section.id }} .banner__media::after {
      opacity: var(--banner-overlay-opacity);
      background: var(--overlay-background);
    }
    @media screen and (min-width: 921px) {
      {% if section.settings.section_width == 'overlap' and settings.allow_transparent_navigation %}
            #shopify-section-{{ section.id }}:first-child {
              margin-top: -100px;
          }
          @supports selector(:has(+ *)) {
              #shopify-section-{{ section.id }}:first-child {
                  margin-top: 0px;
              }
          }
          #shopify-section-{{ section.id }}:first-child::after {
            content: "";
            position: absolute;
            width: 100vw;
            height: 100%;
            top:0;
            z-index: 0;
            {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
            background: {{ section.settings.background_gradient }};
            {%- else %}
            background-color: rgb(var(--layout-background-color));
            {%- endif %}
          }
          #shopify-section-{{ section.id }}:first-child .banner {
            position: relative;
            z-index: 1;
          }
      {% endif %}
      #shopify-section-{{ section.id }}:first-child .image-banner__media,
      #shopify-section-{{ section.id }}:first-child::after {
            {% if section.settings.section_width == 'overlap' and settings.allow_transparent_navigation %}
                width: 100vw !important;
            {% endif %}
            {% if is_rtl == 'true' %}
              {% if has_transparent_sidebar_navigation and settings.white_space == 'compact' %}
                    {% if settings.sidebar_template == 'main_xs' or settings.sidebar_template == 'main_xs_with_secondary' %}
                        transform: translate(max(12.5%, 200px));
                    {% elsif settings.sidebar_template == 'main_s' or settings.sidebar_template == 'main_s_with_secondary' %}
                        transform: translate(max(18.75%, 200px));
                    {% elsif settings.sidebar_template == 'main_m' or settings.sidebar_template == 'main_m_with_secondary' %}
                        transform: translate(max(25%, 200px));
                    {% elsif settings.sidebar_template == 'main_l' %}
                        transform: translate(max(50%, 200px));
                    {% endif %}
                {% endif %}
                {% if has_transparent_sidebar_navigation and settings.white_space == 'spacious' %}
                    {% if settings.sidebar_template == 'main_xs' or settings.sidebar_template == 'main_xs_with_secondary' %}
                        transform: translate(max(12.5%, 280px));
                    {% elsif settings.sidebar_template == 'main_s' or settings.sidebar_template == 'main_s_with_secondary' %}
                        transform: translate(max(18.75%, 280px));
                    {% elsif settings.sidebar_template == 'main_m' or settings.sidebar_template == 'main_m_with_secondary' %}
                        transform: translate(max(25%, 280px));
                    {% elsif settings.sidebar_template == 'main_l' %}
                        transform: translate(max(50%, 280px));
                    {% endif %}
                {% endif %}
            {% else %}
              {% if has_transparent_sidebar_navigation and settings.white_space == 'compact' %}
                    {% if settings.sidebar_template == 'main_xs' or settings.sidebar_template == 'main_xs_with_secondary' %}
                        transform: translate(min(-12.5%, -200px));
                    {% elsif settings.sidebar_template == 'main_s' or settings.sidebar_template == 'main_s_with_secondary' %}
                        transform: translate(min(-18.75%, -200px));
                    {% elsif settings.sidebar_template == 'main_m' or settings.sidebar_template == 'main_m_with_secondary' %}
                        transform: translate(min(-25%, -200px));
                    {% elsif settings.sidebar_template == 'main_l' %}
                        transform: translate(min(-50%, -200px));
                    {% endif %}
                {% endif %}
                {% if has_transparent_sidebar_navigation and settings.white_space == 'spacious' %}
                    {% if settings.sidebar_template == 'main_xs' or settings.sidebar_template == 'main_xs_with_secondary' %}
                        transform: translate(min(-12.5%, -280px));
                    {% elsif settings.sidebar_template == 'main_s' or settings.sidebar_template == 'main_s_with_secondary' %}
                        transform: translate(min(-18.75%, -280px));
                    {% elsif settings.sidebar_template == 'main_m' or settings.sidebar_template == 'main_m_with_secondary' %}
                        transform: translate(min(-25%, -280px));
                    {% elsif settings.sidebar_template == 'main_l' %}
                        transform: translate(min(-50%, -280px));
                    {% endif %}
                {% endif %}
            {% endif %}
        }
    }
    #shopify-section-{{ section.id }}:first-child .overlapping-section {
      padding-bottom: 0!important;
      padding-top: 0!important;
    }
    {% if section.settings.section_width == 'overlap' and settings.allow_transparent_navigation and settings.allow_mobile_transparent_navigation %}
      @media screen and (max-width: 920px) {
          #shopify-section-{{ section.id }}:first-child {
              margin-top: -100px;
          }
          @supports selector(:has(+ *)) {
              #shopify-section-{{ section.id }}:first-child {
                  margin-top: 0px;
              }
          }
          #shopify-section-{{ section.id }}:first-child::after {
            content: "";
            position: absolute;
            width: 100vw;
            height: 100%;
            top:0;
            z-index: 0;
            {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
            background: {{ section.settings.background_gradient }};
            {%- else %}
            background-color: rgb(var(--layout-background-color));
            {%- endif %}
          }
          #shopify-section-{{ section.id }}:first-child .banner {
            position: relative;
            z-index: 1;
          }
    }
    #shopify-section-{{ section.id }}:first-child .overlapping-section {
      padding-bottom: 0!important;
      padding-top: 0!important;
    }
    {% endif %}

    {% if section.settings.height_mode == 'adapt' %}   
      #shopify-section-{{ section.id }} .banner__wrapper {
        {% if has_transparent_sidebar_navigation %}  
          height: {{ desktopSectionHeightInVW }}vw;
        {% else %}
          aspect-ratio: {{ desktop_aspect }};
        {% endif %}

        @media screen and (max-width: 768px) {
          {% if has_transparent_sidebar_navigation %}  
            height: {{ mobileSectionHeightInVW }}vw;
          {% else %}
            aspect-ratio: {{ mobile_aspect }};
          {% endif %}
        }
      }
    {% endif %}
{% endstyle %}

<div class="image-banner banner banner--{{ settings.white_space }} ordinal-section ordinal-section--{{ settings.white_space }} color-{{ section.settings.color_type }} 
  {% if settings.allow_transparent_navigation and section.settings.section_width == 'overlap' %} overlapping-section {% if section.index == 1 %} overlapping-section--first {% endif %}{% endif %} 
  {% if section.settings.desktop_height == 100 %} full-height {% endif %} 
  {% if settings.allow_transparent_navigation and section.settings.section_width == 'overlap' %} banner--overlapping {% else %} banner--{{ section.settings.section_width }} {% endif %} 
  {% if section.settings.section_width == 'overlap' %} no-padding {% endif %} 
  {% if settings.show_lines %} ordinal-section--lines lines {% endif -%}  
  {% if section.settings.section_width == 'wide' %}section-padding--{{ settings.white_space }} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %} page-width {% endif %} page-width--{{ settings.max_page_width }} {% endif %} 
  {% if section.settings.color_type != 'default' %} no-default-color {% endif %}
  {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %} section-bg-gradient {% endif -%}">
    {% if section.settings.section_link != blank %}<a href="{{ section.settings.section_link }}" {% if section.settings.target_blank %}target="_blank"{% endif %}  class="banner__wrapper {% if section.settings.center_text %}banner__wrapper--center-content {% endif %}{% if section.settings.content_under_image %}below{% else %}over{% endif %} {% if section.settings.content_on_hover %}hover-content{% endif %} {% if section.settings.section_width == 'overlap' %}hidden-radius{% endif %}">
    {% else %}<div class="not-scaled banner__wrapper {% if section.settings.center_text %}banner__wrapper--center-content {% endif %}{% if section.settings.content_under_image %}below{% else %}over{% endif %} {% if section.settings.content_on_hover %}hover-content{% endif %} {% if section.settings.section_width == 'overlap' %}hidden-radius{% endif %}">{% endif %}
        <div class="banner__media image-banner__media overlapping-container-js{% if section.settings.section_width == 'overlap' and settings.allow_transparent_navigation and settings.allow_mobile_transparent_navigation %} mobile-overlap-enable{% endif %}">
          {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
            {%- if section.settings.first_image != blank -%}
                <div  class="image-banner__media-block {% unless section.settings.second_image != blank %}one-child{% endunless %} {% if section.settings.only_first_image %}hidden-secondary-block{% endif %}" {% if settings.disable_right_click %}oncontextmenu="return false"{% endif %}>
                  {% if lazy_loading_images %}
                  <figure class="lazy-image lazy-image--absolute lazy-image--{{ settings.images_loading }}">
                  {% endif %}
                    <img srcset="{%- if section.settings.first_image.width >= 165 -%}{{ section.settings.first_image | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if section.settings.first_image.width >= 375 -%}{{ section.settings.first_image | image_url: width: 375 }} 375w,{%- endif -%}
                    {%- if section.settings.first_image.width >= 550 -%}{{ section.settings.first_image | image_url: width: 550 }} 550w,{%- endif -%}
                    {%- if section.settings.first_image.width >= 750 -%}{{ section.settings.first_image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if section.settings.first_image.width >= 1100 -%}{{ section.settings.first_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                    {%- if section.settings.first_image.width >= 1500 -%}{{ section.settings.first_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {%- if section.settings.first_image.width >= 2200 -%}{{ section.settings.first_image | image_url: width: 2200 }} 2200w,{%- endif -%}
                    {%- if section.settings.first_image.width >= 3000 -%}{{ section.settings.first_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                    {{ section.settings.first_image | image_url }} {{ section.settings.first_image.width }}w" 
                    src="{{ section.settings.first_image | image_url: width: 1500 }}"
                    {% if section.settings.second_image != blank %}
                      sizes="(min-width: {{ settings_page_width }}) calc({{ settings_page_width }} / 2), calc(100vw / 2)"
                    {% else %}
                      sizes="(min-width: {{ settings_page_width }}) {{ settings_page_width }}, 100vw"
                    {% endif %}
                    {% if should_high_priority %}
                      fetchpriority="high"
                    {% endif %}
                    alt="{{ section.settings.first_image.alt | escape }}" 
                    draggable="false"
                    width="{{ section.settings.first_image.width }}" 
                    height="{{ section.settings.first_image.height }}" 
                    class="banner__image image-banner__image"
                    style="object-position: {{ section.settings.first_image.presentation.focal_point }};"
                    {% if should_lazy_load %}
                      loading="lazy"
                    {% endif %}
                    {% if lazy_loading_images %}
                      onload="this.parentNode.classList.add('lazyloaded');"
                    {% endif %}
                    >
                    {% if lazy_loading_images %}
                    {% if settings.images_loading != 'fade_scale' %}
                    <div class="lazy-image__preloader lazy-image__preloader-{{ settings.images_loading }}" aria-hidden="true">
                      <img 
                      alt="{{ section.settings.first_image.alt | escape }}" 
                      src="{{ section.settings.first_image | image_url: width: 10 }}"
                      draggable="false"
                      width="10" 
                      height="10">
                    </div>
                    {% endif %}
                  </figure>
                  {% endif %}
                </div>
            {%- endif -%}
            {%- if section.settings.second_image != blank -%}
                <div class="image-banner__media-block {% unless section.settings.first_image != blank %}one-child{% endunless %} {% if section.settings.only_first_image %}hidden-block{% endif %}" {% if settings.disable_right_click %}oncontextmenu="return false"{% endif %}>
                  {% if lazy_loading_images %}
                    <figure class="lazy-image lazy-image--absolute lazy-image--{{ settings.images_loading }}">
                  {% endif %}
                  <img srcset="{%- if section.settings.second_image.width >= 165 -%}{{ section.settings.second_image | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if section.settings.second_image.width >= 375 -%}{{ section.settings.second_image | image_url: width: 375 }} 375w,{%- endif -%}
                    {%- if section.settings.second_image.width >= 550 -%}{{ section.settings.second_image | image_url: width: 550 }} 550w,{%- endif -%}
                    {%- if section.settings.second_image.width >= 750 -%}{{ section.settings.second_image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if section.settings.second_image.width >= 1100 -%}{{ section.settings.second_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                    {%- if section.settings.second_image.width >= 1500 -%}{{ section.settings.second_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {%- if section.settings.second_image.width >= 2200 -%}{{ section.settings.second_image | image_url: width: 2200 }} 2200w,{%- endif -%}
                    {%- if section.settings.second_image.width >= 3000 -%}{{ section.settings.second_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                    {{ section.settings.second_image | image_url }} {{ section.settings.second_image.width }}w" 
                    src="{{ section.settings.second_image | image_url: width: 1500 }}"
                    {% if section.settings.first_image != blank %}
                      sizes="(min-width: {{ settings_page_width }}) calc({{ settings_page_width }} / 2), calc(100vw / 2)"
                    {% else %}
                      sizes="(min-width: {{ settings_page_width }}) {{ settings_page_width }}, 100vw"
                    {% endif %}
                    {% if should_high_priority %}
                      fetchpriority="high"
                    {% endif %}
                    alt="{{ section.settings.second_image.alt | escape }}" 
                    draggable="false"
                    width="{{ section.settings.second_image.width }}" 
                    height="{{ section.settings.second_image.height }}" 
                    class="banner__image image-banner__image"
                    style="object-position: {{ section.settings.second_image.presentation.focal_point }};"
                    {% if should_lazy_load %}
                      loading="lazy"
                    {% endif %}
                    {% if lazy_loading_images %}
                      onload="this.parentNode.classList.add('lazyloaded');"
                    {% endif %}
                    >
                    {% if lazy_loading_images %}
                    <div class="lazy-image__preloader lazy-image__preloader-{{ settings.images_loading }}" aria-hidden="true">
                      <img 
                      alt="{{ section.settings.second_image.alt | escape }}" 
                      src="{{ section.settings.second_image | image_url: width: 10 }}"
                      draggable="false"
                      width="10" 
                      height="10">
                    </div>
                  </figure>
                  {% endif %}
                </div>
            {%- endif -%}
            {% if section.settings.first_image == blank and section.settings.second_image == blank %}
                <div class="image-banner__media-block one-child" {% if settings.disable_right_click %}oncontextmenu="return false"{% endif %}>
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
            {% endif %}
            {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
        </div>
        <div class="banner__content overlapping-content-js {% if section.settings.narrow_content %}narrow-container{% else %}wide-container{% endif %} {% if section.settings.fill_content == false %} hidden-background{% endif %}">
            {% if section.blocks.size > 0 %}
            <div class="banner__content-wrapper {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %} {% if section.settings.center_text %}center{% else %}start{% endif %}" style="text-align: {% if section.settings.center_text %}center{% else %}start{% endif %};">
                {%- for block in section.blocks -%}
                    {%- case block.type -%}
                        {%- when 'subheading' -%}
                          {% liquid
                            assign uppercase_font = false
                            assign bolder_font = false
                            if settings.typography_preset == 'custom' and block.settings.subheading_size == 'default'
                              if settings.uppercase_label
                                assign uppercase_font = true
                              endif
                              if settings.bolder_font_label
                                assign bolder_font = true
                              endif
                            endif
                            assign subheading_text = block.settings.subheading
                            assign final_text = ''
                            assign split_text_curly = subheading_text | split: '{'
                            for part in split_text_curly
                              if part contains '}'
                                assign split_curly = part | split: '}'
                                assign styled_text = split_curly[0]
                                assign after_curly = split_curly[1]
                                assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                              else
                                assign final_text = final_text | append: part
                              endif
                            endfor
                          %} 
                            <{{ block.settings.subheading_tag }} {{ block.shopify_attributes }} class="content-subheading custom-heading {% unless forloop.first %}content-wrapper--block{% endunless %} content-subheading--{{ settings.typography_preset }} {% if block.settings.subheading_size != 'default' %}{{ block.settings.subheading_size }}{% endif %} {% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %} {% if settings.dim_text %}dim{% endif %}">{{ final_text }}</{{ block.settings.subheading_tag }}>
                        {%- when 'heading' -%}   
                          {% liquid
                            assign uppercase_font = false
                            assign bolder_font = false
                            if settings.typography_preset == 'custom' and block.settings.heading_size == 'default'
                              if settings.uppercase_heading_xs
                                assign uppercase_font = true
                              endif
                              if settings.bolder_font_heading_xs
                                assign bolder_font = true
                              endif
                            endif
                            assign heading_text = block.settings.heading
                            assign final_text = ''
                            assign split_text_curly = heading_text | split: '{'
                            for part in split_text_curly
                                if part contains '}'
                                    assign split_curly = part | split: '}'
                                    assign styled_text = split_curly[0]
                                    assign after_curly = split_curly[1]
                                    assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                                else
                                    assign final_text = final_text | append: part
                                endif
                            endfor
                          %} 
                            <{{ block.settings.heading_tag }} {{ block.shopify_attributes }} class="content-heading custom-heading {% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %} {% unless forloop.first %}content-wrapper--block{% endunless %} {% if section.settings.color_type == 'default' and settings.accent_color_for_headings %}content-heading--accent{% endif %} content-heading--{{ settings.typography_preset }} {% if block.settings.heading_size != 'default' %}{{ block.settings.heading_size }}{% endif %}">
                              {% if block.settings.heading_color == 'gradient' and block.settings.heading_gradient != blank %}
                                <span class="gradient-heading-text gradient-heading-text--{{ block.id }}">{{ final_text }}</span>
                              {% else %}
                                {{ final_text }}
                              {% endif %}
                            </{{ block.settings.heading_tag }}>
                        {%- when 'text' -%}
                          {% liquid
                            assign uppercase_font = false
                            assign bolder_font = false
                            if settings.typography_preset == 'custom' and block.settings.text_size == 'default'
                              if settings.uppercase_body_m
                                assign uppercase_font = true
                              endif
                              if settings.bolder_font_body_m
                                assign bolder_font = true
                              endif
                            endif
                          %} 
                            <div {{ block.shopify_attributes }} class="content-text {% unless forloop.first %}content-wrapper--block{% endunless %} {% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %} content-text--{{ settings.typography_preset }} {% if block.settings.text_size != 'default' %}{{ block.settings.text_size }}{% endif %} {% if block.settings.dim_text %}dim{% endif %} richtext {% if settings.enable_animated_underline %}richtext-link--underline{% endif %}">
                              {% if section.settings.section_link != blank %}<object>{% endif %}{{ block.settings.text }}{% if section.settings.section_link != blank %}</object>{% endif %}
                            </div>
                        {%- when 'context_image' -%}
                          {%- render 'context-image', block_or_section: block, shopify_attributes: true, double_hover: true, content_wrapper_block: true, forloop_first: forloop.first -%}
                        {%- when 'block_image' -%}
                          {%- render 'block-image', block: block, content_wrapper_block: true, forloop_first: forloop.first -%}
                        {%- when 'button' -%}
                          {%- if block.settings.button_label != blank -%}
                            <div {{ block.shopify_attributes }} class="block__button {% unless forloop.first %}content-wrapper--block{% endunless %} block__button--{{ block.settings.button_style }} {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %} {% unless block.settings.button_link != blank %}disabled{% endunless %}">
                              {% style %}
                                .block__button {
                                    width: fit-content;
                                    display: inline-block;
                                }
                              {% endstyle %}
                          {%- if block.settings.button_link != blank -%}{% if section.settings.section_link != blank %}<object>{% endif %}<a href="{{ block.settings.button_link }}" {% if block.settings.target_blank %}target="_blank"{% endif %}  class="{{ block.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if block.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{%- else -%}
                          <span disabled class="{{ block.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if block.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %}">{%- endif -%}
                            {{ block.settings.button_label }}
                            {%- unless block.settings.button_link != blank -%}</span>{%- endunless -%}{%- if block.settings.button_link != blank -%}</a>{% if section.settings.section_link != blank %}</object>{% endif %}{%- endif -%}
                          </div>
                        {%- endif -%}
                        {%- when 'line' -%}
                          {%- render 'line', block: block -%}
                        {%- when 'empty_space' -%}
                          {%- render 'empty-space', block: block -%}
                        {%- when 'video_button' -%}
                          {%- render 'video-button', block_settings: block.settings, block: block, content_wrapper_block: true, forloop_first: forloop.first -%}
                        {%- when 'custom_liquid' -%}
                          {%- render 'custom-liquid', block: block, content_wrapper_block: true, forloop_first: forloop.first -%}
                        {%- when 'promo_code' -%}
                          {%- render 'promo-code', block: block, promo_code: block.settings.promo_code, content_wrapper_block: true, forloop_first: forloop.first -%}
                        {%- when 'countdown_timer' -%}
                          {%- render 'countdown-timer', block: block, section_id: section.id, section_blocks_count: section.blocks.size, content_wrapper_block: true, forloop_first: forloop.first -%}
                        {%- endcase -%}       
                {%- endfor -%}
            </div>
            {% endif %}
        </div>
    {% if section.settings.section_link != blank %}</a>{% else %}</div>{% endif %}
</div>
{% endif %}

