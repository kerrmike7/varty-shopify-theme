{% if section.settings.collection != blank or request.design_mode %}
{%- liquid
  assign _irx = section.settings.image_radius
  if _irx == 'default'
    assign _irx = settings.images_and_sections_radius
  endif
-%}
{% style %}
    #shopify-section-{{ section.id }} {
        --padding-top: {{ section.settings.desktop_padding_top }}px;
        --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
        --media-focal-point: {{ section.settings.focal_point }};
        --focal-point: {{ section.settings.card_focal_point }};
        --image-position: {% if section.settings.swap_image %}row{% else %}row-reverse{% endif %};
        --horizontal-position: {% if section.settings.center_text %}center{% else %}flex-start{% endif %};
        --top-sticky-content: {{ section.settings.sticky_offset }}px;
        {% if section.settings.grid_gap_type == 'custom' %}
          --custom-column-gap-desktop: {{ section.settings.custom_column_gap_desktop }}px;
          --custom-column-gap-mobile: {{ section.settings.custom_column_gap_mobile }}px;
          --custom-row-gap-desktop: {{ section.settings.custom_row_gap_desktop }}px;
          --custom-row-gap-mobile: {{ section.settings.custom_row_gap_mobile }}px;
        {% endif %}
        --image-radius: {%- render 'radius-xxl-then-var', v: _irx -%};

        {% if section.settings.color_type == 'invert' %}
            --layout-text-color:
            {{ settings.layout_background_color.red }},
            {{ settings.layout_background_color.green }},
            {{ settings.layout_background_color.blue }};
            --layout-background-color:
            {{ settings.layout_text_color.red }},
            {{ settings.layout_text_color.green }}, 
            {{ settings.layout_text_color.blue }};
            --rating-color: 
            {{ settings.layout_background_color.red }},
            {{ settings.layout_background_color.green }},
            {{ settings.layout_background_color.blue }};
        {% endif %}
        {% if section.settings.color_type == 'custom' %}
            --layout-text-color:
            {{ section.settings.text_color.red }},
            {{ section.settings.text_color.green }}, 
            {{ section.settings.text_color.blue }};
            --layout-background-color:
            {{ section.settings.background_color.red }},
            {{ section.settings.background_color.green }}, 
            {{ section.settings.background_color.blue }};
            --rating-color: 
            {{ section.settings.text_color.red }},
            {{ section.settings.text_color.green }}, 
            {{ section.settings.text_color.blue }};
        {% endif %}  
        {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
        background: {{ section.settings.background_gradient }}; 
        {%- else %}
        background-color: rgb(var(--layout-background-color));
        {%- endif %}
        color: rgb(var(--layout-text-color));
    }
    {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
    .gradient-heading-text--{{ section.id }} {
      background: {{ section.settings.heading_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }
    {% endif %}
    @media screen and (max-width: 920px) {
        #shopify-section-{{ section.id }} {
            --padding-top: {{ section.settings.mobile_padding_top }}px;
            --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
        }
    }
{% endstyle %}

{% liquid
    assign collection = section.settings.collection

    assign settings_page_width = settings.max_page_width | append: 'px'
    if settings.max_page_width == 'full_width'
        assign settings_page_width = '100vw'
    endif

    assign disable_layout_margins = false
    if section.settings.layout_margins == 'disable'
      assign disable_layout_margins = true
      assign settings_page_width = '100vw'
    elsif section.settings.layout_margins == 'default' and settings.disable_margins
      assign disable_layout_margins = true
      assign settings_page_width = '100vw'
    endif
    
    if section.index == 1
        assign should_high_priority = true
    else
        assign should_high_priority = false
    endif

    if should_high_priority == false and settings.images_loading != 'disable' or section.index > 2
        assign should_lazy_load = true
    else
        assign should_lazy_load = false
    endif

    assign desktop_layout = 2 | plus: 2
    assign mobile_layout = section.settings.mobile_layout | times: 1 | at_least: 1

    if collection != blank
        assign products_count = collection.products.size

        if products_count < mobile_layout
            assign mobile_layout = products_count | at_least: 1
        endif
    endif

    assign desktop_media_width = desktop_layout
    assign mobile_media_width = mobile_layout

    assign custom_grid_gap_enabled = false
    if section.settings.grid_gap_type == 'custom'
      assign custom_grid_gap_enabled = true
      assign custom_column_gap_desktop = section.settings.custom_column_gap_desktop
      assign custom_column_gap_mobile = section.settings.custom_column_gap_mobile
    endif
    if section.settings.grid_gap_type == 'default' and settings.enable_custom_product_grid_gap
      assign custom_grid_gap_enabled = true
      assign custom_column_gap_desktop = settings.custom_product_column_gap_desktop
      assign custom_column_gap_mobile = settings.custom_product_column_gap_mobile
    endif

    if custom_grid_gap_enabled
      assign desktop_content_margin = false
      assign mobile_content_margin = false
      if custom_column_gap_desktop < 8
        assign desktop_content_margin = true
      endif
      if custom_column_gap_mobile < 8
        assign mobile_content_margin = true
      endif
    endif
%}

<div class="collection-with-products collection-with-products--{{ settings.white_space }} {% if custom_grid_gap_enabled %}collection-with-products--custom-gap{% endif %} collection-with-products--{{ section.id }} ordinal-section ordinal-section--{{ settings.white_space }} {% unless disable_layout_margins %}section-padding--{{ settings.white_space }}{% endunless %} {% if disable_layout_margins %}disable-layout-margins disable-layout-margins--{{ settings.white_space }}{% endif %} {% if settings.show_lines %}ordinal-section--lines lines{% endif %} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }} color-{{ section.settings.color_type }} {% if section.settings.color_type != 'default' %}no-default-color{% endif %}">
    <div class="collection-with-products__wrapper {% if section.settings.swap_image %}image-left{% else %}image-right{% endif %}">
        <div class="collection-with-products__media {% if section.settings.hide_image_on_mobile %}hide-on-mobile{% endif %}">
            <div class="collection-with-products__media-wrapper lazy-image-container ratio-{{ section.settings.image_ratio }} sticky-content" {% if settings.disable_right_click %}oncontextmenu="return false"{% endif %}>
                {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
                {%- if section.settings.video_load != blank -%}
                    {% if settings.images_loading == 'disable' %}
                        {{ section.settings.video_load | video_tag: image_size: "500x", autoplay: false, preload: 'none', loop: true, muted: true, controls: false }}
                    {% else %}
                        <figure class="lazy-video lazy-image--{{ settings.images_loading }}" style="--desktop-asp-rat: {{ section.settings.video_load.aspect_ratio }}">
                            {{ section.settings.video_load | video_tag: image_size: "500x", autoplay: false, preload: 'none', loop: true, muted: true, controls: false, oncanplay: 'this.parentNode.classList.add("lazyloaded");' }}
                            {% if settings.images_loading != 'fade_scale' %}
                            <div class="lazy-image__preloader lazy-image__preloader--full lazy-image__preloader-{{ settings.images_loading }}" aria-hidden="true" >
                                <img 
                                    alt="{{ section.settings.video_load.alt | escape }}" 
                                    src="{{ section.settings.video_load.preview_image | image_url: width: 10 }}"
                                    draggable="false"
                                    width="10" 
                                    height="10">
                            </div>
                            {% endif %}
                        </figure>
                    {% endif %}
                {%- elsif section.settings.custom_image != blank -%}
                {% if settings.images_loading != 'disable' %}
                    <figure class="lazy-image lazy-image--{{ settings.images_loading }}" style="--desktop-asp-rat: {{ section.settings.custom_image.aspect_ratio }}">
                {% endif %}
                    <img srcset="{%- if section.settings.custom_image.width >= 165 -%}{{ section.settings.custom_image | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if section.settings.custom_image.width >= 375 -%}{{ section.settings.custom_image | image_url: width: 375 }} 375w,{%- endif -%}
                    {%- if section.settings.custom_image.width >= 550 -%}{{ section.settings.custom_image | image_url: width: 550 }} 550w,{%- endif -%}
                    {%- if section.settings.custom_image.width >= 750 -%}{{ section.settings.custom_image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if section.settings.custom_image.width >= 1100 -%}{{ section.settings.custom_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                    {%- if section.settings.custom_image.width >= 1500 -%}{{ section.settings.custom_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {%- if section.settings.custom_image.width >= 2200 -%}{{ section.settings.custom_image | image_url: width: 2200 }} 2200w,{%- endif -%}
                    {%- if section.settings.custom_image.width >= 3000 -%}{{ section.settings.custom_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                    {{ section.settings.custom_image | image_url }} {{ section.settings.custom_image.width }}w" 
                    src="{{ section.settings.custom_image | image_url: width: 1500 }}"
                    sizes="(max-width: 768px) 100vw, (min-width: {{ settings_page_width }}) calc({{ settings_page_width }} / 2), calc(100vw / 2)"
                    alt="{{ section.settings.custom_image.alt | escape }}" 
                    {% if should_high_priority %}
                        fetchpriority="high"
                    {% endif %}
                    {% if should_lazy_load %}
                        loading="lazy"
                    {% endif %}
                    {% if settings.images_loading != 'disable' %}
                        onload="this.parentNode.classList.add('lazyloaded');"
                    {% endif %}
                    draggable="false" 
                    width="{{ section.settings.custom_image.width }}" 
                    height="{{ section.settings.custom_image.height }}" 
                    class="collection-with-products__image"
                    style="--media-focal-point: {{ section.settings.custom_image.presentation.focal_point }};">
                    {% if settings.images_loading != 'disable' %}
                        {% if settings.images_loading != 'fade_scale' %}
                        <div class="lazy-image__preloader lazy-image__preloader--full lazy-image__preloader-{{ settings.images_loading }}" aria-hidden="true">
                          <img 
                          alt="{{ section.settings.custom_image.alt | escape }}" 
                          src="{{ section.settings.custom_image | image_url: width: 10 }}"
                          draggable="false"
                          width="10" 
                          height="10">
                        </div>
                        {% endif %}
                    </figure>
                    {% endif %}
                {%- else -%}  
                    {%- if collection.featured_image -%}
                    {% if settings.images_loading != 'disable' %}
                        <figure class="lazy-image lazy-image--{{ settings.images_loading }}" style="--desktop-asp-rat: {{ collection.featured_image.aspect_ratio }}">
                    {% endif %}
                        <img srcset="{%- if collection.featured_image.width >= 165 -%}{{ collection.featured_image | image_url: width: 165 }} 165w,{%- endif -%}
                            {%- if collection.featured_image.width >= 375 -%}{{ collection.featured_image | image_url: width: 375 }} 375w,{%- endif -%}
                            {%- if collection.featured_image.width >= 550 -%}{{ collection.featured_image | image_url: width: 550 }} 550w,{%- endif -%}
                            {%- if collection.featured_image.width >= 750 -%}{{ collection.featured_image | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if collection.featured_image.width >= 1100 -%}{{ collection.featured_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                            {%- if collection.featured_image.width >= 1500 -%}{{ collection.featured_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                            {%- if collection.featured_image.width >= 2200 -%}{{ collection.featured_image | image_url: width: 2200 }} 2200w,{%- endif -%}
                            {%- if collection.featured_image.width >= 3000 -%}{{ collection.featured_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                            {{ collection.featured_image | image_url }} {{ collection.featured_image.width }}w" 
                            src="{{ collection.featured_image | image_url: width: 1700 }}"
                            sizes="(max-width: 768px) 100vw, (min-width: {{ settings_page_width }}) calc({{ settings_page_width }} / 2), calc(100vw / 2)"
                            alt="{{ collection.title | escape }}" 
                            {% if should_high_priority %}
                                fetchpriority="high"
                            {% endif %}
                            {% if should_lazy_load %}
                                loading="lazy"
                            {% endif %}
                            {% if settings.images_loading != 'disable' %}
                                onload="this.parentNode.classList.add('lazyloaded');"
                            {% endif %}
                            draggable="false"
                            width="{{ collection.featured_image.width }}" 
                            height="{{ collection.featured_image.height }}" 
                            class="collection-with-products__image">
                        {% if settings.images_loading != 'disable' %}
                            {% if settings.images_loading != 'fade_scale' %}
                            <div class="lazy-image__preloader lazy-image__preloader--full lazy-image__preloader-{{ settings.images_loading }}" aria-hidden="true">
                                <img 
                                alt="{{ collection.featured_image.alt | escape }}" 
                                src="{{ collection.featured_image | image_url: width: 10 }}"
                                draggable="false"
                                width="10" 
                                height="10">
                            </div>
                            {% endif %}
                        </figure>
                        {% endif %}
                    {%- else -%}
                        {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                {%- endif -%}
                {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
            </div>
        </div>
        <div class="collection-with-products__content">
            <div class="collection-with-products__info {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %} {% if section.settings.center_text %}center{% else %}start{% endif %} {% if disable_layout_margins %}{% if section.settings.swap_image %}desktop-padding-right{% else %}desktop-padding-left{% endif %} only-mobile-padding section-padding--{{ settings.white_space }}{% endif %}" style="text-align: {% if section.settings.center_text %}center{% else %}start{% endif %};">
                {%- if section.settings.subheading != blank -%}
                    {% liquid
                        assign subheading_text = section.settings.subheading
                        assign final_text = ''
                        assign split_text_curly = subheading_text | split: '{'
                        for part in split_text_curly
                            if part contains '}'
                                assign split_curly = part | split: '}'
                                assign styled_text = split_curly[0]
                                assign after_curly = split_curly[1]
                                assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                            else
                                assign final_text = final_text | append: part
                            endif
                        endfor
                    %}
                    <{{ section.settings.subheading_tag }} class="content-subheading custom-heading content-subheading--{{ settings.typography_preset }} {% if section.settings.subheading_size != 'default' %}{{ section.settings.subheading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_label %} uppercase{% endif %}{% if settings.bolder_font_label %} bolder-font{% endif %}{% endif %}{% endif %} {% if settings.dim_text %}dim{% endif %}">{{ final_text }}</{{ section.settings.subheading_tag }}>
                {%- endif -%}
                {%- if section.settings.heading != blank -%}
                    {% liquid
                        assign heading_text = section.settings.heading
                        assign final_text = ''
                        assign split_text_curly = heading_text | split: '{'
                        for part in split_text_curly
                            if part contains '}'
                                assign split_curly = part | split: '}'
                                assign styled_text = split_curly[0]
                                assign after_curly = split_curly[1]
                                assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                            else
                                assign final_text = final_text | append: part
                            endif
                        endfor
                    %}
                    <{{ section.settings.heading_tag }} class="content-heading custom-heading {% if section.settings.color_type == 'default' and settings.accent_color_for_headings %}content-heading--accent{% endif %} content-heading--{{ settings.typography_preset }} {% if section.settings.heading_size != 'default' %}{{ section.settings.heading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_heading_xs %} uppercase{% endif %}{% if settings.bolder_font_heading_xs %} bolder-font{% endif %}{% endif %}{% endif %}">
                        {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
                            <span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{{ final_text }}</span>
                        {% else %}
                            {{ final_text }}
                        {% endif %}
                    </{{ section.settings.heading_tag }}>
                {%- endif -%}
                {%- if section.settings.text != blank -%}
                    <div class="content-text content-text--{{ settings.typography_preset }} richtext {% if settings.enable_animated_underline %}richtext-link--underline{% endif %} {% if section.settings.text_size != 'default' %}{{ section.settings.text_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_body_m %} uppercase{% endif %}{% if settings.bolder_font_body_m %} bolder-font{% endif %}{% endif %}{% endif %}">
                        {{ section.settings.text }}
                    </div>
                {%- endif -%}
                {%- if section.settings.button_label != blank -%}
                    <div>
                        {% if collection.url != blank %}<a href="{{ collection.url }}" class="{{ section.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if section.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %} featured-collection-with-media__button">{% else %}
                        <span disabled class="{{ section.settings.button_style }}-button button--{{ settings.typography_preset }} {% if settings.typography_preset == 'custom' %}{% if settings.regular_button_size == 'default' %}button-font--default{% else %}{{ settings.regular_button_size }}{% endif %}{% endif %} {% if section.settings.button_style == 'link' and settings.enable_animated_underline %}link-button--underline{% endif %} featured-collection-with-media__button">{% endif %}
                        {{ section.settings.button_label }}
                        {% if collection.url == blank %}</span>{% else %}</a>{% endif %}
                    </div>
                {%- endif -%}
            </div>
            <div class="collection-with-products__products slider-section--{{ settings.white_space }} {% if custom_grid_gap_enabled %}slider-section--custom-gap{% endif %} {% if settings.show_lines %}slider-section--lines{% endif %} slider-container-js {% if section.settings.subheading == blank and section.settings.heading == blank and section.settings.text == blank and section.settings.button_label == blank %}without-content{% endif %}">
                <slider-component id="GalleryViewer-{{ section.id }}" class="slider only-mobile-slider">
                    {% style %}
                        .collection-with-products--{{ section.id }} {
                            --desktop-grid-type: {{ section.settings.products_to_show }};
                        }
                        /* Styles for full-width page without sidebars */
                        /* Mobile */
                        @media screen and (max-width: 768px) {
                            .collection-with-products--{{ section.id }} {
                                --desktop-grid-type: {{ mobile_layout }};
                            }
                        }
                        @media screen and (min-width: 921px) {
                            /* Mobile */
                            @container inside-content (max-width: 768px) {
                                .collection-with-products--{{ section.id }} {
                                    --desktop-grid-type: {{ mobile_layout }};
                                }
                            }
                        }
                    {% endstyle %}
                    <div class="slider__viewport slider__viewport--collection-with-products">
                        <ul id="Slider-Gallery-{{ section.id }}" data-id="{{ section.id }}" class="slider__grid slider__grid--{{ settings.white_space }} slider__grid-mobile-{{ section.settings.mobile_layout }} {% if settings.show_lines %} lines{% endif %}"
                            data-count="{{ desktop_layout }}"
                            data-count-mobile="{{ mobile_layout }}"
                        >
                            {% liquid
                                assign desktopItems = section.settings.products_to_show | times: 1
                                assign mobileItems = mobile_layout
                                assign min = 0
                                assign max = collection.products.size | minus: desktopItems
                                assign randomNumber = "now" | date: "%N" | modulo: max | plus: min
                              
                                if collection.products.size <= desktopItems
                                  assign randomNumber = 0
                                endif
                              
                                if section.settings.products_order == 'collection'
                                  assign randomNumber = 0
                                endif
                            %}

                            {%- if collection != blank -%}
                            {% for item in collection.products limit: desktopItems offset: randomNumber %}
                                {% assign lazy_load = false %}
                                {%- if forloop.index > 2 -%}
                                {%- assign lazy_load = true -%}
                                {%- endif -%}
                                <li id="Slide-{{ section.id }}" class="slider__grid-item  snap-align {% if forloop.first %}is-active{% endif %} {% if forloop.last and settings.show_lines and forloop.length >= 4 %}last-desktop{% endif %} 
                                {% if forloop.last and settings.show_lines and forloop.length >= mobileItems %}last-mobile{% endif %}">
                                    {% render 'card-product',
                                        card_product: item,
                                        image_ratio: section.settings.card_image_ratio,
                                        show_vendor: section.settings.show_vendor,
                                        show_rating: section.settings.show_rating,
                                        hover_behavior: section.settings.hover_behavior,
                                        show_bullets: section.settings.show_bullets,
                                        lazy_load: lazy_load,
                                        enable_quick_view: section.settings.enable_quick_view,
                                        enable_add_to_cart: section.settings.enable_add_to_cart,
                                        price_position: section.settings.price_position,
                                        max_product_name_characters: section.settings.max_product_name_characters,
                                        show_short_description: section.settings.show_short_description,
                                        enable_color_pills: section.settings.enable_color_pills,
                                        show_pickup_availability: section.settings.show_pickup_availability,
                                        disable_layout_margins: disable_layout_margins,
                                        center_text: settings.center_text,
                                        desktop_media_width: desktop_media_width,
                                        mobile_media_width: mobile_media_width,
                                        desktop_content_margin: desktop_content_margin,
                                        mobile_content_margin: mobile_content_margin
                                    %}
                                </li>
                            {% endfor %}
                            {% else %}
                            {% for item in (1..desktopItems) %}
                                {% assign lazy_load = false %}
                                {%- if forloop.index > 2 -%}
                                {%- assign lazy_load = true -%}
                                {%- endif -%}
                                {%- assign placeholder_index =  forloop.index -%}
                                {%- if forloop.index > 6 -%}
                                    {%- assign placeholder_index =  '6' -%}
                                {%- endif -%}
                                <li id="Slide-{{ section.id }}" class="slider__grid-item  snap-align {% if forloop.first %}is-active{% endif %} {% if forloop.last and settings.show_lines and forloop.length >= 4 %}last-desktop{% endif %} 
                                {% if forloop.last and settings.show_lines and forloop.length >= mobileItems %}last-mobile{% endif %}">
                                    {% render 'product-placeholder',
                                    index_placeholder: placeholder_index,
                                    image_ratio: section.settings.card_image_ratio,
                                    show_vendor: section.settings.show_vendor,
                                    price_position: section.settings.price_position,
                                    disable_layout_margins: disable_layout_margins,
                                    center_text: settings.center_text,
                                    desktop_content_margin: desktop_content_margin,
                                    mobile_content_margin: mobile_content_margin
                                    %}
                                </li>
                            {% endfor %}
                            {%- endif -%}
                        </ul>
                        {% assign mobileItems = mobile_layout %}
                        {% liquid
                            assign product_size = collection.products.size
                            if collection == blank
                                assign product_size = desktopItems
                            endif
                        %}
                        <div class="slider-buttons-items  slider-buttons-items--bottom slider-buttons-items--{{ settings.white_space }} {% if settings.show_lines %}slider-buttons-items--lines{% endif %} {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %} 
                            hidden-desktop
                            {% if section.settings.desktop_grid_type == '5' %}hidden-desktop-none{% endif %}
                            {% if product_size <= mobileItems or section.settings.mobile_navigation == 'scrollbar' %}hidden-mobile{% endif %}">
                                {%- liquid 
                                    if settings.typography_preset == 'avant_garde'
                                        assign weight_close = settings.accent_icon_weight
                                        if settings.swap_fonts
                                            assign weight_close = settings.base_icon_weight
                                        endif
                                    else 
                                        assign weight_close =  settings.base_icon_weight
                                        if settings.swap_fonts
                                            assign weight_close = settings.accent_icon_weight
                                        endif
                                    endif
                                    if settings.typography_preset == 'custom'
                                        assign weight_close = settings.custom_icon_weight
                                    endif
                                -%}
                            <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
                                {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
                                {% render 'icon-accordion-2', icon: icon_full %}
                            </button>
                            <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                                {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
                                {% render 'icon-accordion-2', icon: icon_full %}
                            </button>
                        </div>
                        {% if section.settings.mobile_navigation == 'scrollbar' and product_size > mobileItems %}
                            <div role="scrollbar" aria-orientation="horizontal" aria-valuemax="100" aria-valuemin="0" aria-valuenow="39" class="slider-buttons-items slider-scrollbar hidden-desktop {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
                              <span class="slider-scrollbar__track">
                                <span class="slider-scrollbar__thumb"></span>
                              </span>
                            </div>
                        {% endif %}
                    </div>
                </slider-component>
            </div>
        </div>
    </div>
</div>
{% endif %}

