{%- liquid 
  assign top_padding_mobile = section.settings.top_padding | divided_by: 4
  assign bottom_padding_mobile = section.settings.bottom_padding | divided_by: 4

  if settings.typography_preset == 'avant_garde'
    assign weight_close = settings.accent_icon_weight
    if settings.swap_fonts
      assign weight_close = settings.base_icon_weight
    endif
	else 
    assign weight_close =  settings.base_icon_weight
    if settings.swap_fonts
      assign weight_close = settings.accent_icon_weight
    endif
	endif
  if settings.typography_preset == 'custom'
    assign weight_close = settings.custom_icon_weight
  endif

  assign disable_layout_margins = false

    if section.settings.layout_margins == 'disable'
      assign disable_layout_margins = true
    elsif section.settings.layout_margins == 'default' and settings.disable_margins
      assign disable_layout_margins = true
    endif

    assign custom_grid_gap_enabled = false
    if section.settings.grid_gap_type == 'custom'
      assign custom_grid_gap_enabled = true
      assign custom_column_gap_desktop = section.settings.custom_column_gap_desktop
      assign custom_column_gap_mobile = section.settings.custom_column_gap_mobile
    endif
    if section.settings.grid_gap_type == 'default' and settings.enable_custom_product_grid_gap
      assign custom_grid_gap_enabled = true
      assign custom_column_gap_desktop = settings.custom_product_column_gap_desktop
      assign custom_column_gap_mobile = settings.custom_product_column_gap_mobile
    endif

    if custom_grid_gap_enabled
      assign desktop_content_margin = false
      assign mobile_content_margin = false
      if custom_column_gap_desktop < 8
        assign desktop_content_margin = true
      endif
      if custom_column_gap_mobile < 8
        assign mobile_content_margin = true
      endif
    endif
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --desktop-grid-type: {% if section.settings.desktop_grid_type == 'heading_with_two' %}2{% elsif section.settings.desktop_grid_type == 'heading_with_three' %}3{% else %}{{ section.settings.desktop_grid_type }}{% endif %};
    {% if section.settings.grid_gap_type == 'custom' %}
      --custom-column-gap-desktop: {{ section.settings.custom_column_gap_desktop }}px;
      --custom-column-gap-mobile: {{ section.settings.custom_column_gap_mobile }}px;
    {% endif %}
    {% if section.settings.color_type == 'invert' %}
      --layout-text-color:
        {{ settings.layout_background_color.red }},
        {{ settings.layout_background_color.green }},
        {{ settings.layout_background_color.blue }};
      --layout-background-color:
        {{ settings.layout_text_color.red }},
        {{ settings.layout_text_color.green }}, 
        {{ settings.layout_text_color.blue }};
      --rating-color: 
        {{ settings.layout_background_color.red }},
        {{ settings.layout_background_color.green }},
        {{ settings.layout_background_color.blue }};
    {% endif %}
    {% if section.settings.color_type == 'custom' %}
      --layout-text-color:
        {{ section.settings.text_color.red }},
        {{ section.settings.text_color.green }}, 
        {{ section.settings.text_color.blue }};
        --layout-background-color:
        {{ section.settings.background_color.red }},
        {{ section.settings.background_color.green }}, 
        {{ section.settings.background_color.blue }};
      --rating-color: 
        {{ section.settings.text_color.red }},
        {{ section.settings.text_color.green }}, 
        {{ section.settings.text_color.blue }};
    {% endif %}

    {%- if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' %}
    background: {{ section.settings.background_gradient }};
    {%- else %}
    background-color: rgb(var(--layout-background-color));
    {%- endif %}
    color: rgb(var(--layout-text-color));
  }
  {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}
  .gradient-heading-text--{{ section.id }} {
    background: {{ section.settings.heading_gradient }};
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  {% endif %}

  @media screen and (max-width: 920px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.mobile_padding_top }}px;
      --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<recently-viewed-products class="{{ search.results_count }} recently-viewed-products ordinal-section ordinal-section--{{ settings.white_space }} {% if settings.show_lines %}ordinal-section--lines{% endif %} color-{{ section.settings.color_type }} {% unless disable_layout_margins %}section-padding--{{ settings.white_space }}{% endunless %} {% if disable_layout_margins %}disable-layout-margins disable-layout-margins--{{ settings.white_space }}{% endif %} slider-container-js slider-section {% if custom_grid_gap_enabled %}slider-section--custom-gap{% endif %} slider-section--{{ settings.white_space }}  {% if settings.show_lines %}slider-section--lines{% endif %} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }} slider-section-container--{{ settings.white_space }} {% if section.settings.color_type != 'default' %}no-default-color{% endif %}" 
  data-url="{{ routes.search_url }}?section_id={{ section.id }}&type=product&q=" {% if request.page_type == 'product' %} data-product-id="{{ product.id }}"{% endif %}>
  {%- if request.page_type == 'search' and search.performed and search.results_count > 0 -%}
    {% liquid 
      assign desktop_layout = section.settings.desktop_grid_type | times: 1
      if section.settings.desktop_grid_type == 'heading_with_two'
        assign desktop_layout = 2
      elsif section.settings.desktop_grid_type == 'heading_with_three'
        assign desktop_layout = 3
      endif
    
      assign mobile_layout = section.settings.mobile_layout | times: 1 | at_least: 1
    
      if search.results_count < mobile_layout
        assign mobile_layout = search.results_count | at_least: 1
      endif

      case section.settings.desktop_grid_type
        when '3'
          assign desktop_media_width = 3
        when '4'
          assign desktop_media_width = 4
        when '5'
          assign desktop_media_width = 5
        when 'heading_with_two'
          assign desktop_media_width = 3
        when 'heading_with_three'
          assign desktop_media_width = 4
        else
          assign desktop_media_width = 3
      endcase

      assign mobile_media_width = mobile_layout
    %}

    {% style %}
      /* Styles for full-width page without sidebars */
      /* Mobile */
      @media screen and (max-width: 768px) {
        #shopify-section-{{ section.id }} {
          --desktop-grid-type: {{ mobile_layout }};
        }
      }
      @media screen and (min-width: 921px) {
        /* Mobile */
        @container inside-content (max-width: 768px) {
          #shopify-section-{{ section.id }} {
            --desktop-grid-type: {{ mobile_layout }};
          }
        }
      }
    {% endstyle %}

    <slider-component id="GalleryViewer-{{ section.id }}" class="slider {% if section.settings.desktop_grid_type == 'heading_with_two' or section.settings.desktop_grid_type == 'heading_with_three' %}slider--row{% endif %} {% if section.settings.desktop_grid_type == 'heading_with_two' %}slider--row-two{% endif %} {% if section.settings.desktop_grid_type == 'heading_with_three' %}slider--row-three{% endif %}">
        <div class="slider__header {% if settings.center_text %}slider__header-center{% endif %} {% if section.settings.heading == blank and section.settings.desktop_grid_type == '3' or section.settings.heading == blank and section.settings.desktop_grid_type == '4' or section.settings.heading == blank and section.settings.desktop_grid_type == '5' %}slider__header--hidden{% endif %} 
        {% if disable_layout_margins %}{% if section.settings.desktop_grid_type == 'heading_with_two' or section.settings.desktop_grid_type == 'heading_with_three' %} desktop-padding-left{% else %}section-padding--{{ settings.white_space }}{% endif %}{% endif %}">
          {% if section.settings.heading != blank %}
            {% liquid
              assign heading_text = section.settings.heading
              assign final_text = ''
              assign split_text_curly = heading_text | split: '{'
              for part in split_text_curly
                  if part contains '}'
                      assign split_curly = part | split: '}'
                      assign styled_text = split_curly[0]
                      assign after_curly = split_curly[1]
                      assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                  else
                      assign final_text = final_text | append: part
                  endif
              endfor
            %}
            <{{ section.settings.heading_tag }} class="slider__heading custom-heading {% if settings.accent_color_for_headings %}slider__heading--accent{% endif %} slider__heading--{{ settings.typography_preset }} {% if section.settings.heading_size != 'default' %}{{ section.settings.heading_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_heading_xs %} uppercase{% endif %}{% if settings.bolder_font_heading_xs %} bolder-font{% endif %}{% endif %}{% endif %} 
              {% if disable_layout_margins %}{% if section.settings.desktop_grid_type == 'heading_with_two' or section.settings.desktop_grid_type == 'heading_with_three' %}{% else %} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }}{% endif %}{% endif %}">
              {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}<span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{% endif %}
              {{ final_text }}
              {% if section.settings.heading_color == 'gradient' and section.settings.heading_gradient != blank %}</span>{% endif %}
            </{{ section.settings.heading_tag }}>
          {% endif %}
          {% if section.settings.desktop_grid_type == 'heading_with_two' or section.settings.desktop_grid_type == 'heading_with_three' %}
            <div class="slider-buttons-items 
              {% if search.results_count <= desktop_layout or settings.center_text == true and section.settings.desktop_grid_type != 'heading_with_two' and settings.center_text == true and section.settings.desktop_grid_type != 'heading_with_three' %}hidden-desktop{% endif %} hidden-mobile">
              <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
                {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
                {% render 'icon-accordion-2', icon: icon_full %}
              </button>
              <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
                {% render 'icon-accordion-2', icon: icon_full %}
              </button>
            </div>
          {% endif %}
        </div>

        {%- assign parsed_terms = search.terms | split: ' OR ' -%}
        <div class="slider__viewport">
          <ul id="Slider-Gallery-{{ section.id }}" class="slider__grid slider__grid-mobile-{{ mobile_layout }} recently-viewed" role="list" 
            data-count="{{ desktop_layout }}"
            data-count-mobile="{{ mobile_layout }}"
          >
            {%- assign card_product_settings = section.settings -%}
            {%- for parsed_term in parsed_terms -%}
              {%- assign id = parsed_term | split: 'id:' | last | times: 1 -%}
              {%- for product in search.results -%}
                {%- if product.id == id -%}
                  <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="slider__grid-item snap-align">
                    {% render 'card-product',
                      card_product: product,
                      image_ratio: card_product_settings.image_ratio,
                      show_vendor: card_product_settings.show_vendor,
                      hover_behavior: card_product_settings.hover_behavior,
                      show_bullets: card_product_settings.show_bullets,
                      enable_quick_view: card_product_settings.enable_quick_view,
                      enable_add_to_cart: card_product_settings.enable_add_to_cart,
                      price_position: card_product_settings.price_position,
                      max_product_name_characters: card_product_settings.max_product_name_characters,
                      show_short_description: card_product_settings.show_short_description,
                      enable_color_pills: card_product_settings.enable_color_pills,
                      show_rating: card_product_settings.show_rating,
                      show_pickup_availability: section.settings.show_pickup_availability,
                      disable_layout_margins: disable_layout_margins,
                      center_text: settings.center_text,
                      desktop_media_width: desktop_media_width,
                      mobile_media_width: mobile_media_width,
                      desktop_content_margin: desktop_content_margin,
                      mobile_content_margin: mobile_content_margin
                    %}
                  </li>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </ul>

          <div class="slider-buttons-items slider-buttons-items--bottom slider-buttons-items--{{ settings.white_space }} {% if settings.show_lines %}slider-buttons-items--lines{% endif %} {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %} 
            {% if section.settings.desktop_grid_type != '3' and section.settings.desktop_grid_type != '4' and section.settings.desktop_grid_type != '5' %}hidden-desktop{% endif %} {% if search.results_count <= mobile_layout or section.settings.mobile_navigation == 'scrollbar' %}hidden-mobile{% endif %}
            {% if search.results_count <= desktop_layout %}hidden-desktop{% endif %}
              {% if section.settings.desktop_grid_type == '5' and search.results_count == 5 %}hidden-desktop-none{% endif %}">
            <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
              {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
              {% render 'icon-accordion-2', icon: icon_full %}
            </button>
            <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
              {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
              {% render 'icon-accordion-2', icon: icon_full %}
            </button>
          </div>

          {% if section.settings.mobile_navigation == 'scrollbar' and search.results_count > mobile_layout %}
            <div role="scrollbar" aria-orientation="horizontal" aria-valuemax="100" aria-valuemin="0" aria-valuenow="39" class="slider-buttons-items slider-scrollbar hidden-desktop {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
              <span class="slider-scrollbar__track">
                <span class="slider-scrollbar__thumb"></span>
              </span>
            </div>
          {% endif %}
        </div>
    </slider-component>
  {%- endif -%}
</recently-viewed-products>

