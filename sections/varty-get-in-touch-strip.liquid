{% style %}
  #shopify-section-{{ section.id }} {
    {% render 'varty-color-vars', scheme: 'scheme_brand_beige' %}
    background: rgb(var(--layout-background-color));
    color: rgb(var(--layout-text-color));
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip-wrap {
    width: min(100% - 112px, 1720px);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__title {
    margin: 0 0 2.25rem;
    color: inherit;
    font: var(--base-heading-l-font);
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: clamp(2.75rem, 3.55vw, 4.2rem) !important;
    font-weight: 800;
    line-height: 0.98 !important;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__card {
    min-height: clamp(300px, 20vw, 360px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 3.1vw, 44px);
    overflow: hidden;
    border-radius: 8px;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__card--purple {
    {% render 'varty-color-vars', scheme: 'scheme_brand_purple' %}
    background: rgb(var(--layout-background-color));
    color: rgb(var(--layout-text-color));
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__heading {
    margin: 0 0 1.75rem;
    color: inherit;
    font: var(--base-body-l-font);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: clamp(1.3rem, 1.45vw, 1.7rem) !important;
    font-weight: 500;
    line-height: 1.1 !important;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__body {
    margin: 0;
    color: inherit;
    font: var(--base-body-m-font);
    font-size: clamp(1.05rem, 1.15vw, 1.28rem);
    line-height: 1.45;
    overflow-wrap: normal;
    word-break: normal;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__body a {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__social {
    display: grid;
    grid-template-columns: repeat(4, 42px);
    justify-content: start;
    gap: clamp(12px, 1.1vw, 18px);
    margin-top: 1.5rem;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__social span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__image {
    padding: 0;
  }

  #shopify-section-{{ section.id }} .varty-touch-strip__image img {
    width: 100%;
    height: 100%;
    min-height: clamp(300px, 20vw, 360px);
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media screen and (max-width: 920px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .varty-touch-strip-wrap {
      width: min(100% - 32px, 1720px);
    }

    #shopify-section-{{ section.id }} .varty-touch-strip {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstyle %}

<section class="varty-touch-strip-wrap">
  {% if section.settings.heading != blank %}
    <h2 class="varty-touch-strip__title custom-heading heading_l">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="varty-touch-strip">
    <div class="varty-touch-strip__card varty-touch-strip__card--purple">
      <h3 class="varty-touch-strip__heading custom-heading heading_m">FOLLOW</h3>
      <p class="varty-touch-strip__body">@VARTYALLNATURAL</p>
      <div class="varty-touch-strip__social" aria-label="Social links">
        <span aria-label="Instagram">◎</span>
        <span aria-label="Facebook">f</span>
        <span aria-label="LinkedIn">in</span>
        <span aria-label="TikTok">♪</span>
      </div>
    </div>

    <div class="varty-touch-strip__card varty-touch-strip__image">
      {% if section.settings.image_1 != blank %}
        {{ section.settings.image_1 | image_url: width: 900 | image_tag: alt: '', loading: 'lazy' }}
      {% else %}
        <img src="{{ 'varty-finder-touch-vanilla.jpg' | asset_url }}" alt="" loading="lazy" width="720" height="960">
      {% endif %}
    </div>

    <div class="varty-touch-strip__card varty-touch-strip__card--purple">
      <h3 class="varty-touch-strip__heading custom-heading heading_m">CONTACT</h3>
      <p class="varty-touch-strip__body">Varty All Natural Inc.<br>Montreal, QC, Canada<br><br><a href="mailto:info@vartyallnatural.ca">info@vartyallnatural.ca</a></p>
    </div>

    <div class="varty-touch-strip__card varty-touch-strip__image">
      {% if section.settings.image_2 != blank %}
        {{ section.settings.image_2 | image_url: width: 900 | image_tag: alt: '', loading: 'lazy' }}
      {% else %}
        <img src="{{ 'varty-finder-touch-bag.jpg' | asset_url }}" alt="" loading="lazy" width="720" height="960">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Varty get in touch strip",
  "tag": "section",
  "class": "section-varty-get-in-touch-strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET IN TOUCH"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Varty get in touch strip"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
