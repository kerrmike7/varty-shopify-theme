{% style %}
#shopify-section-{{ section.id }} {
    {% if section.settings.sticky_header == 'always_stick' %}
        position: sticky;
        position: -webkit-sticky;
        top: -0.5px;
    {% else %}
        position: relative;
    {% endif %}
    z-index: 5;
    --bottom-menu-alignment: {{ section.settings.menu_horizontal_alignment }};
    --header-alignment: {{ section.settings.block_alignment }};
    --padding: {{ section.settings.section_paddings }}px;
    {% if section.settings.color_type == 'invert' %}
      --layout-text-color:
        {{ settings.layout_background_color.red }},
        {{ settings.layout_background_color.green }},
        {{ settings.layout_background_color.blue }};
      --layout-background-color:
        {{ settings.layout_text_color.red }},
        {{ settings.layout_text_color.green }}, 
        {{ settings.layout_text_color.blue }};
      {% endif %}
      {% if section.settings.color_type == 'custom' %}
      --layout-text-color:
        {{ section.settings.text_color.red }},
        {{ section.settings.text_color.green }}, 
        {{ section.settings.text_color.blue }};
        --layout-background-color:
        {{ section.settings.background_color.red }},
        {{ section.settings.background_color.green }}, 
        {{ section.settings.background_color.blue }};
    {% endif %}
    }
    {% if section.settings.color_type == 'custom' and section.settings.background_color_type == 'gradient' and section.settings.background_gradient != blank %}
        #shopify-section-{{ section.id }} .header-section {
          background: {{ section.settings.background_gradient }};
        }
    {% endif %}
    @media screen and (max-width: 920px) {
        #shopify-section-{{ section.id }} {
            display: none;
        }
    }
{% endstyle %}

{% liquid
    assign mega_menu_blocks = section.blocks | where: 'type', "mega_menu"
    assign hover_mega_menu_blocks = section.blocks | where: 'type', "hover_mega_menu"
    assign hover_mega_menu_banners_blocks = section.blocks | where: 'type', "hover_mega_menu_banners"
    assign blocksSize = section.blocks.size | minus: mega_menu_blocks.size | minus: hover_mega_menu_blocks.size | minus: hover_mega_menu_banners_blocks.size
    assign blocks = section.blocks 
%}

    <{% if section.settings.sticky_header == 'stick_on_scroll' %}sticky-header{% else %}div{% endif %} class="header-section {{ section.settings.sticky_header }} {% if settings.allow_transparent_navigation %}transparent-header{% endif %} color-{{ section.settings.color_type }} {% if section.settings.color_type != 'default' %}no-default-color{% endif %} header-without-sidebars">
    <header class="header header--{{ settings.white_space }} section-padding--{{ settings.white_space }} 
        {%- if section.settings.sticky_header == 'disable' %} header--disable-sticky {% endif -%}
        {%- if section.settings.sticky_header == 'always_stick' %} header--sticky {% endif -%}
        {%- if settings.include_header_footer %}{% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %} page-width {% endif %} page-width--{{ settings.max_page_width }} {% endif -%}"
    >
        <div class="header__wrapper {% if section.settings.show_bottom_line %}header__wrapper--line{% endif %}">
            {% if blocks.size > 0 %}
                <div class="header__content {% if section.settings.block_alignment == 'stretched' %}header__content--stretched{% endif %}">
                    {%- for block in blocks -%}
                        {%- case block.type -%}
                            {%- when 'logo' -%}
                                {%- render 'logo', logo_settings: block.settings, block_item: block, section_navigation_block: true -%}
                            {%- when 'main_menu' -%}
                                {% liquid
                                    if block.settings.menu == blank 
                                        assign blocksSize = blocksSize | minus : 1
                                    endif
                                %}
                                {% if block.settings.menu != blank %}
                                    {%- render 'menu', menu_settings: block.settings, menu_settings_id: block.settings.menu, block_item: block, type: block.type, for_loop: forloop, blocks: section.blocks, menu_id: block.id, menu_in_header: true, section_navigation_block: true -%}
                                {% endif %}
                            {%- when 'miscellaneous' -%}
                                {%- render 'miscellaneous', miscellaneous_settings: block.settings, block: block, blocks: section.blocks, menu_id: block.id, menu_in_header: true, section_navigation_block: true -%}
                            {%- when 'burger_menu' -%}
                                {%- render 'burger-menu', burger-menu_settings: block.settings, block_item: block, section_navigation_block: true -%}
                            {%- when 'cart' -%}
                                {% liquid
                                    if settings.disable_shopping_functionality == true 
                                        assign blocksSize = blocksSize | minus : 1
                                    endif
                                %}
                                {%- if settings.disable_shopping_functionality == false -%}
                                {%- render 'cart', cart_settings: block.settings, block: block, section_navigation_block: true -%}
                                {%- endif -%}
                            {%- when 'account' -%}
                                {%- render 'account', account_settings: block.settings, block_item: block, section_navigation_block: true -%}
                            {%- when 'news' -%}
                                {%- render 'news', news_settings: block.settings, block_item: block, section_navigation_block: true -%}
                            {%- when 'search' -%}
                                {%- render 'search', search_settings: block.settings, type: block.type, block_item: block, section_navigation_block: true -%}
                            {%- when 'social_media' -%}
                                {% liquid
                                    if settings.instagram_link == blank and settings.twitter_link == blank and settings.tiktok_link == blank and settings.snapchat_link == blank and settings.pinterest_link == blank and settings.tumblr_link == blank and settings.facebook_link == blank and settings.linkedin_link == blank and settings.youtube_link == blank and settings.vimeo_link == blank and settings.reddit_link == blank and settings.trustpilot_link == blank and settings.tripadvisor_link == blank and settings.telegram_link == blank and settings.line_link == blank 
                                        assign blocksSize = blocksSize | minus : 1
                                    endif
                                %}
                                {%- render 'social-media', social-media_settings: block.settings, block_item: block, section_settings: section.settings, section_navigation_block: true -%}
                            {%- when 'store_selector' -%}
                                {% render 'store-selector', block: block, section_navigation_block: true %}
                            {%- when 'country_and_language' -%}
                                {% liquid
                                    if localization.available_countries.size == 1 and localization.available_languages.size == 1
                                        assign blocksSize = blocksSize | minus : 1
                                    endif
                                %}
                                {%- render 'country-and-language', country-and-language_settings: block.settings, type: block.type, block_item: block, section_navigation_block: true -%}
                            {%- when 'secondary_menu' -%}
                                {% liquid
                                    if block.settings.menu == blank 
                                        assign blocksSize = blocksSize | minus : 1
                                    endif
                                %}
                                {% if block.settings.menu != blank %}
                                    {%- render 'menu', menu_settings: block.settings, menu_settings_id: block.settings.menu, block_item: block, type: block.type, menu_id: block.id, menu_in_header: true, section_navigation_block: true -%}
                                {% endif %}
                            {%- when 'empty_space' -%}
                                <div class="empty-space section-navigation-block"></div>
                            {%- when 'contacts' -%}
                                {%- render 'contacts', contacts_settings: block.settings, block_item: block, section_navigation_block: true -%}
                            {%- when 'buttons' -%}
                                {% liquid
                                    if block.settings.button_label_1 == blank and block.settings.button_label_2 == blank
                                        assign blocksSize = blocksSize | minus : 1
                                    endif
                                %}
                                {% if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank %}
                                    <div class="navigation-buttons section-navigation-block navigation-buttons--{{ block.id }}" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                                        <div class="navigation-buttons__wrapper">
                                            {%- render 'button-with-icon', button_settings: block.settings, button_label: block.settings.button_label_1, button_link: block.settings.button_link_1, button_style: block.settings.button_style_1, target_blank: block.settings.target_blank_1, icon: block.settings.icon_1, block: block -%}
                                            {%- render 'button-with-icon', button_settings: block.settings, button_label: block.settings.button_label_2, button_link: block.settings.button_link_2, button_style: block.settings.button_style_2, target_blank: block.settings.target_blank_2, icon: block.settings.icon_2, block: block -%}
                                        </div>
                                    </div>
                                {% endif %}
                            {%- when 'custom_liquid' -%}
                                {%- render 'custom-liquid', block: block, section_navigation_block: true -%}
                        {%- endcase -%}
                    {%- endfor -%}
                    {% if localization.available_languages.size > 1 %}
                      {% form 'localization', class: 'varty-lang-switch section-navigation-block' %}
                        <input type="hidden" name="return_to" value="{{ request.path }}">
                        {% for lang in localization.available_languages %}
                          {% liquid
                            assign lang_code = lang.iso_code | split: '-' | first | upcase
                            if lang_code != 'EN' and lang_code != 'FR'
                              assign lang_code = lang.iso_code | upcase
                            endif
                          %}
                          <button
                            type="submit"
                            name="locale_code"
                            value="{{ lang.iso_code }}"
                            class="{% if lang.iso_code == localization.language.iso_code %}is-active{% endif %}"
                            aria-label="{{ lang.endonym_name | escape }}"
                          >
                            {{ lang_code }}
                          </button>
                        {% endfor %}
                      {% endform %}
                    {% endif %}
                </div>
            {% endif %}
            {%- if section.settings.menu != blank -%}
            <div class="bottom-menu bottom-menu--{% if blocks.size > 0 %}padding{% endif %}">
            {%- liquid
                assign enable_mega_menu = false
                assign link_title_handle = link.title | handle
                for block in blocks
                    assign menu_heading_handle = block.settings.menu_heading | handle
                    if menu_heading_handle == link_title_handle
                        assign enable_mega_menu = true
                        assign mega_menu_block = block
                        assign mega_menu_block_id = block.id
                        break
                    endif
                endfor
        
            -%}
                {%- render 'menu', menu_settings: section.settings, menu_settings_id: section.settings.menu, blocks: section.blocks, menu_id: section.id, mega_menu_block_id: mega_menu_block_id, menu_in_header: true -%}
            </div>
            {%- endif -%}
        </div>
    </header>
<{% if section.settings.sticky_header == 'stick_on_scroll' %}/sticky-header{% else %}/div{% endif %}>

{% style %}
.header__content {
    --blocks-amount: {{ blocksSize }};
}
{% endstyle %}


{% javascript %}
class StickyHeader extends HTMLElement {
  constructor() {
    super();

    this.header = null;
    this.headerSection = null;
    this.headerBounds = { top: 0, bottom: 0 };
    this.currentScrollTop = 0;
    this.preventReveal = false;
    this.preventHide = false;
    this.isScrolling = null;
    this.predictiveSearch = null;
    this._rafScroll = 0;
    this._pendingScrollTop = 0;

    this._state = 'reset';
    this.THRESHOLD_EPS = 4;

    this._started = false;
    this.onScroll = this.onScroll.bind(this);
    this._runScroll = this._runScroll.bind(this);
    this._measure = this._measure.bind(this);
    this._start = this._start.bind(this);

    this.hideHeaderOnScrollUp = () => { this.preventReveal = true; };

    this._wakeOnScroll = this._wakeOnScroll.bind(this);
    this._wakeOnPointer = this._wakeOnPointer.bind(this);
    this._wakeOnKey = this._wakeOnKey.bind(this);
    this._onResize = this._onResize.bind(this);
    this._ensureStartedOnResize = this._ensureStartedOnResize.bind(this);
    this._resizeTimer = 0;
  }

  _getDocumentTop(el) {
    let top = 0;
    let node = el;
    while (node) {
      top += node.offsetTop || 0;
      node = node.offsetParent;
    }
    return top;
  }

  connectedCallback() {
    window.addEventListener('scroll', this._wakeOnScroll, { passive: true, once: true });
    window.addEventListener('pointerdown', this._wakeOnPointer, { passive: true, once: true });
    window.addEventListener('touchstart', this._wakeOnPointer, { passive: true, once: true });
    window.addEventListener('keydown', this._wakeOnKey, { passive: true, once: true });
    window.addEventListener('resize', this._ensureStartedOnResize, { passive: true });
  }

  disconnectedCallback() {
    window.removeEventListener('scroll', this._wakeOnScroll);
    window.removeEventListener('pointerdown', this._wakeOnPointer);
    window.removeEventListener('touchstart', this._wakeOnPointer);
    window.removeEventListener('keydown', this._wakeOnKey);
    window.removeEventListener('resize', this._ensureStartedOnResize);
    window.removeEventListener('scroll', this.onScroll);
    window.removeEventListener('resize', this._onResize);

    this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);

    if (this._rafScroll) cancelAnimationFrame(this._rafScroll);
    this._rafScroll = 0;
    if (this._resizeTimer) clearTimeout(this._resizeTimer);
    this._resizeTimer = 0;
  }

  _onResize() {
    if (this._resizeTimer) clearTimeout(this._resizeTimer);
    this._resizeTimer = setTimeout(() => {
      this._resizeTimer = 0;
      if (!this._started || !this.header) return;
      this._measure();

      this.currentScrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
      const eps = this.THRESHOLD_EPS;
      if (this.currentScrollTop <= (this.headerBounds.top + eps)) {
        this._setState('reset');
      }
      this.onScroll();
    }, 120);
  }

  _wakeOnScroll() { this._start(); }
  _wakeOnPointer() { this._start(); }
  _wakeOnKey() { this._start(); }

  _ensureStartedOnResize() {
    if (!this._started) this._start();
  }

  _start() {
    if (this._started) return;

    window.removeEventListener('pointerdown', this._wakeOnPointer);
    window.removeEventListener('touchstart', this._wakeOnPointer);
    window.removeEventListener('keydown', this._wakeOnKey);

    this.header =
      document.getElementById('shopify-section-header') ||
      document.querySelector('.shopify-section-header') ||
      null;

    if (!this.header) return;

    this._started = true;

    window.removeEventListener('resize', this._ensureStartedOnResize);

    this.headerSection = this.header.querySelector('.header-section') || this.header;
    this.predictiveSearch = this.querySelector('predictive-search');

    this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
    this._measure();

    window.addEventListener('scroll', this.onScroll, { passive: true });
    window.addEventListener('resize', this._onResize, { passive: true });
    this.onScroll();
  }

  _measure() {
    if (!this.header) return;

    const outerH = Math.ceil(this.header.getBoundingClientRect().height || 0);
    const innerH = this.headerSection
      ? Math.ceil(this.headerSection.getBoundingClientRect().height || 0)
      : 0;
    const h = Math.max(outerH, innerH);
    const next = `${h}px`;
    const prev = document.documentElement.style.getPropertyValue('--header-height');
    if (prev !== next) {
      document.documentElement.style.setProperty('--header-height', next);
    }

    const top = this.headerSection ? this._getDocumentTop(this.headerSection) : 0;
    this.headerBounds = { top, bottom: top + h };
  }

  onScroll() {
    this._pendingScrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
    if (this._rafScroll) return;
    this._rafScroll = requestAnimationFrame(this._runScroll);
  }

  _runScroll() {
    this._rafScroll = 0;

    const scrollTop = this._pendingScrollTop;

    if (this.predictiveSearch && this.predictiveSearch.isOpen) {
      this.currentScrollTop = scrollTop;
      return;
    }

    if (window.getComputedStyle(this.header).display === 'none') {
      this.currentScrollTop = scrollTop;
      return;
    }

    const layoutRect = this.headerSection?.getBoundingClientRect();
    if (!layoutRect || layoutRect.height < 1) {
      this.currentScrollTop = scrollTop;
      return;
    }

    const eps = this.THRESHOLD_EPS;
    let hb = this.headerBounds;
    if (!(hb.bottom > hb.top + eps)) {
      this._measure();
      hb = this.headerBounds;
    }
    if (!(hb.bottom > hb.top + eps)) {
      this.currentScrollTop = scrollTop;
      return;
    }

    const pastBottom = scrollTop > (hb.bottom + eps);
    const beforeTop  = scrollTop <= (hb.top + eps);

    if (!pastBottom) {
      if (beforeTop) {
        this._setState('reset');
      } else if (scrollTop < this.currentScrollTop) {
        this._setState('revealed');
      } else {
        this._setState('reset');
      }
      this.currentScrollTop = scrollTop;
      return;
    }

    if (scrollTop > this.currentScrollTop && pastBottom) {
      if (!this.preventHide) this._setState('hidden');
    } else if (scrollTop < this.currentScrollTop && pastBottom) {
      if (!this.preventReveal) {
        this._setState('revealed');
      } else {
        clearTimeout(this.isScrolling);
        this.isScrolling = setTimeout(() => { this.preventReveal = false; }, 66);
        this._setState('hidden');
      }
    } else if (beforeTop) {
      this._setState('reset');
    }

    this.currentScrollTop = scrollTop;
  }

  _setState(next) {
    if (!this.header || this._state === next) return;
    this._state = next;

    if (next === 'hidden') {
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      return;
    }

    if (next === 'revealed') {
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
      return;
    }

    this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
  }
}

customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

