{% style %}
  #shopify-section-{{ section.id }} {
    {% render 'varty-color-vars', scheme: 'scheme_brand_beige' %}
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: rgb(var(--layout-background-color));
    color: rgb(var(--layout-text-color));
  }

  #shopify-section-{{ section.id }} .varty-awards-card {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  #shopify-section-{{ section.id }} .varty-awards-card__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(220px, 0.65fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    overflow: hidden;
    padding: clamp(32px, 5vw, 64px);
    border-radius: 8px;
    background: #5463b3;
    color: #fcf2d3;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__eyebrow {
    display: inline-block;
    margin: 0 0 22px;
    padding-bottom: 8px;
    border-bottom: 2px solid #fcf2d3;
    color: #fcf2d3;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__year,
  #shopify-section-{{ section.id }} .varty-awards-card__heading,
  #shopify-section-{{ section.id }} .varty-awards-card__body {
    color: #fcf2d3;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__year {
    margin: 0 0 8px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__heading {
    margin: 0;
    font-size: clamp(40px, 4vw, 56px);
    line-height: 0.96;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__body {
    max-width: 58ch;
    margin-top: 22px;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__button {
    margin-top: 28px;
    border-color: #fcf2d3 !important;
    color: #fcf2d3 !important;
    border-radius: 9999px !important;
    padding: 14px 36px !important;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__star {
    position: absolute;
    top: 24px;
    right: 38%;
    width: clamp(120px, 12vw, 180px);
    height: auto;
    pointer-events: none;
    z-index: 2;
    transform: rotate(8deg);
  }

  @media screen and (max-width: 820px) {
    #shopify-section-{{ section.id }} .varty-awards-card__star {
      top: 16px;
      right: 24px;
      width: 96px;
    }
  }

  #shopify-section-{{ section.id }} .varty-awards-card__logo {
    position: relative;
    min-height: 220px;
    display: grid;
    place-items: center;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__logo img {
    display: block;
    max-width: min(100%, 320px);
    height: auto;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__dots {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: repeat(3, 10px);
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .varty-awards-card__dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #bfe4d0;
  }

  @media screen and (max-width: 820px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.mobile_padding_top }}px;
      --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .varty-awards-card__inner {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .varty-awards-card__logo {
      min-height: 120px;
      justify-items: start;
    }
  }
{% endstyle %}

<div class="varty-awards-card section-padding--{{ settings.white_space }}">
  <div class="page-width page-width--{{ settings.max_page_width }}">
    <div class="varty-awards-card__inner">
      {% if section.settings.star_asset != blank %}
        <img class="varty-awards-card__star" src="{{ section.settings.star_asset | asset_url }}" alt="" aria-hidden="true" loading="lazy" width="350" height="350">
      {% endif %}
      <div>
        <p class="varty-awards-card__eyebrow custom-heading body_s">{{ section.settings.eyebrow }}</p>
        <p class="varty-awards-card__year body-text--{{ settings.typography_preset }}">{{ section.settings.year }}</p>
        <h2 class="varty-awards-card__heading custom-heading content-heading--{{ settings.typography_preset }} heading_l">
          {{ section.settings.heading }}
        </h2>
        <div class="varty-awards-card__body richtext body-text--{{ settings.typography_preset }}">{{ section.settings.body }}</div>
        <a class="varty-awards-card__button outlined-button button--{{ settings.typography_preset }}" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      </div>
      <div class="varty-awards-card__logo" aria-hidden="true">
        {% if section.settings.logo_asset != blank %}
          <img src="{{ section.settings.logo_asset | asset_url }}" alt="" loading="lazy" width="320" height="160">
        {% else %}
          <!-- TODO(asset): futurpreneur-logo.svg missing from theme assets -->
        {% endif %}
        <div class="varty-awards-card__dots">
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Varty awards card",
  "tag": "section",
  "class": "section-varty-awards-card",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "year", "label": "Year" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "logo_asset", "label": "Logo asset" },
    { "type": "text", "id": "star_asset", "label": "Star asset", "default": "awards-star.avif" },
    { "type": "range", "id": "desktop_padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding top", "default": 56 },
    { "type": "range", "id": "desktop_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding bottom", "default": 72 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 40 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 48 }
  ],
  "presets": [
    { "name": "Varty awards card" }
  ]
}
{% endschema %}
