{% style %}
  #shopify-section-{{ section.id }} {
    {% render 'varty-color-vars', scheme: 'scheme_brand_beige' %}
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: rgb(var(--layout-background-color));
    color: rgb(var(--layout-text-color));
  }

  #shopify-section-{{ section.id }} .varty-label-truth {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  #shopify-section-{{ section.id }} .varty-label-truth__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 0.96fr);
    gap: clamp(28px, 4.2vw, 56px);
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__heading {
    margin: 0;
    color: #5463b3;
    font-size: clamp(44px, 4.4vw, 64px) !important;
    line-height: 1 !important;
    text-transform: uppercase !important;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__body {
    max-width: 68ch;
    margin-top: 24px;
    color: #5463b3;
    font-size: 20px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__body p {
    font-size: inherit;
    line-height: inherit;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__thumbs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 34px;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__media,
  #shopify-section-{{ section.id }} .varty-label-truth__thumb {
    overflow: hidden;
    border-radius: 8px;
    background: rgba(84, 99, 179, 0.08);
  }

  #shopify-section-{{ section.id }} .varty-label-truth__media img,
  #shopify-section-{{ section.id }} .varty-label-truth__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__media {
    min-height: 100%;
    aspect-ratio: auto;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__media img {
    object-position: center 48%;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__thumb {
    aspect-ratio: 1.06 / 1;
  }

  #shopify-section-{{ section.id }} .varty-label-truth__thumb img {
    object-position: center center;
  }

  @media screen and (max-width: 920px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.mobile_padding_top }}px;
      --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .varty-label-truth__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .varty-label-truth__media {
      order: -1;
      aspect-ratio: 1 / 1;
    }

    #shopify-section-{{ section.id }} .varty-label-truth__heading {
      font-size: 48px !important;
    }

    #shopify-section-{{ section.id }} .varty-label-truth__body {
      font-size: 18px;
    }
  }
{% endstyle %}

<div class="varty-label-truth section-padding--{{ settings.white_space }}">
  <div class="page-width page-width--{{ settings.max_page_width }}">
    <div class="varty-label-truth__grid">
      <div class="varty-label-truth__content">
        <h2 class="varty-label-truth__heading custom-heading content-heading--{{ settings.typography_preset }} heading_xl">
          {{ section.settings.heading }}
        </h2>
        <div class="varty-label-truth__body richtext body-text--{{ settings.typography_preset }}">
          {{ section.settings.body }}
        </div>
        <div class="varty-label-truth__thumbs" aria-hidden="true">
          {% if section.settings.thumb_1 != blank %}
            <div class="varty-label-truth__thumb">
              <img src="{{ section.settings.thumb_1 | asset_url }}" alt="" loading="lazy" width="600" height="600">
            </div>
          {% endif %}
          {% if section.settings.thumb_2 != blank %}
            <div class="varty-label-truth__thumb">
              <img src="{{ section.settings.thumb_2 | asset_url }}" alt="" loading="lazy" width="600" height="600">
            </div>
          {% endif %}
        </div>
      </div>
      {% if section.settings.main_image != blank %}
        <div class="varty-label-truth__media">
          <img src="{{ section.settings.main_image | asset_url }}" alt="" loading="lazy" width="900" height="1125">
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Varty label truth",
  "tag": "section",
  "class": "section-varty-label-truth",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "main_image", "label": "Main image asset" },
    { "type": "text", "id": "thumb_1", "label": "Thumb 1 asset" },
    { "type": "text", "id": "thumb_2", "label": "Thumb 2 asset" },
    { "type": "range", "id": "desktop_padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding top", "default": 72 },
    { "type": "range", "id": "desktop_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Desktop padding bottom", "default": 72 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 44 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 44 }
  ],
  "presets": [
    { "name": "Varty label truth" }
  ]
}
{% endschema %}
