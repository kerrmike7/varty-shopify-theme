{% liquid
  assign scheme = section.settings.scheme | default: 'cream'
  assign image_position = section.settings.image_position | default: 'right'
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --varty-purple: #5463b3;
    --varty-cream: #fcf2d3;
    --varty-green: #bfe4d0;
    --varty-pink: #f6c5d1;
    --varty-text: var(--varty-purple);
    --varty-bg: var(--varty-cream);
    --varty-button-bg: var(--varty-purple);
    --varty-button-text: var(--varty-cream);
    --padding-top: {{ section.settings.desktop_padding_top }}px;
    --padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    position: relative;
    overflow: hidden;
    background: var(--varty-bg);
    color: var(--varty-text);
  }

  #shopify-section-{{ section.id }} .varty-home-feature[data-scheme="purple"] {
    --varty-bg: var(--varty-purple);
    --varty-text: var(--varty-cream);
    --varty-button-bg: var(--varty-cream);
    --varty-button-text: var(--varty-purple);
  }

  #shopify-section-{{ section.id }} .varty-home-feature[data-scheme="green"] {
    --varty-bg: var(--varty-green);
    --varty-text: var(--varty-purple);
  }

  #shopify-section-{{ section.id }} .varty-home-feature[data-scheme="pink"] {
    --varty-bg: var(--varty-pink);
    --varty-text: var(--varty-purple);
  }

  #shopify-section-{{ section.id }} .varty-home-feature {
    position: relative;
    z-index: 1;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background: var(--varty-bg);
    color: var(--varty-text);
  }

  #shopify-section-{{ section.id }} .varty-home-feature__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.92fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__grid--image-left {
    grid-template-columns: minmax(320px, 0.92fr) minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .varty-home-feature__grid--image-left .varty-home-feature__media {
    order: -1;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__content {
    max-width: 710px;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__eyebrow {
    margin: 0 0 14px;
    color: var(--varty-text);
  }

  #shopify-section-{{ section.id }} .varty-home-feature__heading {
    margin: 0;
    color: var(--varty-text);
    font-size: clamp(42px, 4.6vw, 70px) !important;
    line-height: 0.98 !important;
    letter-spacing: 0;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__body {
    max-width: 58ch;
    margin-top: 24px;
    color: var(--varty-text);
    font-size: clamp(17px, 1.25vw, 20px);
    line-height: 1.48;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__body p {
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__bullets {
    display: grid;
    gap: 11px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__bullets li {
    display: flex;
    gap: 12px;
    align-items: center;
    color: var(--varty-text);
    font-weight: 700;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__bullets li::before {
    content: "♥";
    color: #4f9f68;
    font-size: 1.05em;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 34px;
    padding: 16px 34px;
    border: 2px solid var(--varty-button-bg);
    border-radius: 999px;
    background: var(--varty-button-bg);
    color: var(--varty-button-text);
    font-weight: 800;
    line-height: 1;
    text-align: center;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__media {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border-radius: 0;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .varty-home-feature__flower {
    position: absolute;
    z-index: 0;
    right: clamp(-90px, -5vw, -34px);
    bottom: clamp(-90px, -5vw, -34px);
    width: clamp(210px, 20vw, 360px);
    height: auto;
    pointer-events: none;
  }

  @media screen and (max-width: 920px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.mobile_padding_top }}px;
      --padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .varty-home-feature__grid,
    #shopify-section-{{ section.id }} .varty-home-feature__grid--image-left {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    #shopify-section-{{ section.id }} .varty-home-feature__grid--image-left .varty-home-feature__media {
      order: 0;
    }

    #shopify-section-{{ section.id }} .varty-home-feature__heading {
      font-size: 40px !important;
    }

    #shopify-section-{{ section.id }} .varty-home-feature__media {
      min-height: 340px;
    }

    #shopify-section-{{ section.id }} .varty-home-feature__flower {
      width: 180px;
      opacity: 0.55;
    }
  }
{% endstyle %}

<section class="varty-home-feature" data-scheme="{{ scheme }}">
  <div class="page-width page-width--{{ settings.max_page_width }}">
    <div class="varty-home-feature__grid varty-home-feature__grid--image-{{ image_position }}">
      <div class="varty-home-feature__content">
        {% if section.settings.eyebrow != blank %}
          <p class="varty-home-feature__eyebrow custom-heading body_s">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="varty-home-feature__heading custom-heading content-heading--{{ settings.typography_preset }} heading_l">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <div class="varty-home-feature__body richtext body-text--{{ settings.typography_preset }}">
            {{ section.settings.body }}
          </div>
        {% endif %}
        {% if section.blocks.size > 0 %}
          <ul class="varty-home-feature__bullets">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a class="varty-home-feature__button" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.image != blank %}
        <div class="varty-home-feature__media" aria-hidden="true">
          <img src="{{ section.settings.image | asset_url }}" alt="" loading="lazy" width="720" height="900">
        </div>
      {% endif %}
    </div>
  </div>
  {% if section.settings.show_flower %}
    <img class="varty-home-feature__flower" src="{{ 'flower-3_4x-8.avif' | asset_url }}" alt="" width="360" height="360" loading="lazy" aria-hidden="true">
  {% endif %}
</section>

{% schema %}
{
  "name": "Varty home feature",
  "tag": "section",
  "class": "section-varty-home-feature",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "purple", "label": "Purple" },
        { "value": "green", "label": "Green" },
        { "value": "pink", "label": "Pink" }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "text", "id": "image", "label": "Image asset filename" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_flower", "label": "Show flower", "default": false },
    { "type": "range", "id": "desktop_padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Desktop padding top", "default": 80 },
    { "type": "range", "id": "desktop_padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Desktop padding bottom", "default": 80 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Mobile padding top", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Mobile padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    { "name": "Varty home feature" }
  ]
}
{% endschema %}
