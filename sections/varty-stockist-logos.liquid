<style>
  #shopify-section-{{ section.id }} {
    {% if section.settings.varty_color_scheme != blank %}
      {% render 'varty-color-vars', scheme: section.settings.varty_color_scheme %}
    {% endif %}
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos-section {
    background: rgb(var(--layout-background-color, 252, 242, 211));
    color: rgb(var(--layout-text-color, 84, 99, 179));
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__inner {
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__heading {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 2rem;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(34px, 5.8vw, 76px);
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__link {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__img {
    max-height: {{ section.settings.logo_max_height }}px;
    width: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 132px;
    min-height: 86px;
    color: #424242;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(2rem, 3vw, 3.4rem);
    font-weight: 800;
    line-height: 0.9;
    text-align: center;
    white-space: nowrap;
    word-break: normal;
    overflow-wrap: normal;
    padding: 0;
    border: 0;
    border-radius: 0;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__placeholder small {
    display: block;
    margin-top: 0.25rem;
    color: #96b84d;
    font-size: 0.28em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__placeholder--tau {
    width: 122px;
    min-width: 122px;
    height: 122px;
    border: 4px solid #1d1d1d;
    border-radius: 50%;
    color: #198d48;
    font-size: 2.15rem;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__placeholder--tau small {
    color: #1d1d1d;
    font-size: 0.2em;
    letter-spacing: 0.18em;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__placeholder--oda {
    width: 122px;
    min-width: 122px;
    height: 122px;
    border: 5px solid #4f9f68;
    border-radius: 50%;
    color: #1d1d1d;
    font-size: 1.85rem;
    font-weight: 500;
    line-height: 0.88;
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__placeholder--iga {
    color: #e3362f;
    font-style: italic;
    font-size: clamp(2.9rem, 4vw, 4.35rem);
  }

  #shopify-section-{{ section.id }} .varty-stockist-logos__placeholder--iga small {
    color: #3ca547;
    font-size: 0.44em;
    letter-spacing: 0;
    text-transform: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .varty-stockist-logos-section {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .varty-stockist-logos__list {
      gap: 16px;
    }
  }
</style>

<section class="varty-stockist-logos-section">
  <div class="varty-stockist-logos__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="varty-stockist-logos__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <ul class="varty-stockist-logos__list" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign logo_alt = block.settings.alt | default: 'Stockist logo'
          assign logo_url = block.settings.url
          assign has_logo_url = false
          if logo_url != blank
            unless logo_url contains '<<TBD:'
              assign has_logo_url = true
            endunless
          endif
        %}
        <li class="varty-stockist-logos__item" {{ block.shopify_attributes }}>
          {% if has_logo_url %}
            <a href="{{ logo_url }}" target="_blank" rel="noopener" class="varty-stockist-logos__link" aria-label="{{ logo_alt | escape }}">
          {% endif %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 300 | image_tag: alt: logo_alt, class: 'varty-stockist-logos__img', loading: 'lazy' }}
            {% else %}
              {% liquid
                assign logo_key = ''
                assign logo_alt_downcase = logo_alt | downcase
                if logo_alt_downcase contains 'avril'
                  assign logo_key = 'avril'
                elsif logo_alt_downcase contains 'tau'
                  assign logo_key = 'tau'
                elsif logo_alt_downcase contains 'oda'
                  assign logo_key = 'oda'
                elsif logo_alt_downcase contains 'iga'
                  assign logo_key = 'iga'
                endif
              %}
              <span class="varty-stockist-logos__placeholder{% if logo_key != blank %} varty-stockist-logos__placeholder--{{ logo_key }}{% endif %}">
                {% case logo_key %}
                  {% when 'avril' %}
                    avril<small>Supermarché Santé</small>
                  {% when 'tau' %}
                    TAU<small>Marchés Naturels</small>
                  {% when 'oda' %}
                    Marché<br>Oda
                  {% when 'iga' %}
                    IGA<small>extra</small>
                  {% else %}
                    {{ logo_alt | escape }}
                {% endcase %}
              </span>
            {% endif %}
          {% if has_logo_url %}
            </a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Varty Stockist Logos",
  "tag": "section",
  "class": "varty-stockist-logos",
  "settings": [
    {
      "type": "select",
      "id": "varty_color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme_brand_beige", "label": "Brand beige" },
        { "value": "scheme_brand_purple", "label": "Brand purple" }
      ],
      "default": "scheme_brand_beige"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Logo max height",
      "default": 72
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Varty Stockist Logos",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Marché TAU" } },
        { "type": "logo", "settings": { "alt": "Marché Oda" } },
        { "type": "logo", "settings": { "alt": "IGA Extra" } },
        { "type": "logo", "settings": { "alt": "Ave Greene" } },
        { "type": "logo", "settings": { "alt": "Maison Pho 1929" } },
        { "type": "logo", "settings": { "alt": "SmoothiesGo" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
