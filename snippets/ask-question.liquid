<modal-opener
      class="product-popup-modal__opener no-js-hidden quick-add-hidden popup{% if product_block %} section-block{% if block_settings.show_lines %} with-lines{% endif %}{% endif %}"
      data-modal="#PopupModal-{{ block.id }}"
      {% if product_block %}style="--spacing: {{ block_settings.top_spacing }}; --mobile-spacing: {{ block_settings.mobile_top_spacing }};"{% endif %}
      {{ block.shopify_attributes }}
    >
    {% style %}
        {% if settings.typography_preset != 'custom' %}
        .popup__icon {
            height: max(24px, var(--fluid-preset-body-s-lh));
        }
        .heading_s .popup__icon,
        .heading_s_uppercase .popup__icon {
          height: max(16px, var(--fluid-preset-s-lh));
        }
        .heading_xs .popup__icon,
        .heading_xs_uppercase .popup__icon {
          height: max(16px, var(--fluid-preset-xs-lh));
        }
        .body_l .popup__icon,
        .body_l_uppercase .popup__icon {
            height: max(16px, var(--fluid-preset-body-l-lh));
        }
        .body_m .popup__icon,
        .body_m_uppercase .popup__icon {
            height: max(16px, var(--fluid-preset-body-m-lh));
        }
        .label_font .popup__icon,
        .label_font_uppercase .popup__icon {
            height: max(16px, var(--fluid-preset-label-lh));
        }
        {% else %}
        .popup__icon {
            height: max(24px, calc(var(--body-s-font-size) * var(--body-s-line-height)));
        }
        .heading_s .popup__icon,
        .heading_s_uppercase .popup__icon {
          height: max(16px, calc(var(--heading-s-font-size) * var(--heading-s-line-height)));
        }
        .heading_xs .popup__icon,
        .heading_xs_uppercase .popup__icon {
          height: max(16px, calc(var(--heading-xs-font-size) * var(--heading-xs-line-height)));
        }
        .body_l .popup__icon,
        .body_l_uppercase .popup__icon {
            height: max(16px, calc(var(--body-l-font-size) * var(--body-l-line-height)));
        }
        .body_m .popup__icon,
        .body_m_uppercase .popup__icon {
            height: max(16px, calc(var(--body-m-font-size) * var(--body-m-line-height)));
        }
        .label_font .popup__icon,
        .label_font_uppercase .popup__icon {
            height: max(16px, calc(var(--label-font-size) * var(--label-line-height)));
        }
        {% endif %}
    {% endstyle %}

    {%- liquid 
        if settings.typography_preset == 'avant_garde'
          assign weight = settings.accent_icon_weight
          if settings.swap_fonts
              assign weight = settings.base_icon_weight
          endif
      else 
          assign weight =  settings.base_icon_weight
          if settings.swap_fonts
              assign weight = settings.accent_icon_weight
          endif
      endif
      if settings.typography_preset == 'custom'
        assign weight = settings.custom_icon_weight
      endif
    -%}
    
      <button aria-haspopup="dialog" type="button" id="ProductPopup-{{ block.id }}" class="popup-button popup-button--form popup-button--form-question hover-opacity open-popup popup-button--{{ settings.typography_preset }} {% if block.settings.link_size != 'default' %}{{ block.settings.link_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_body_s %} uppercase{% endif %}{% if settings.bolder_font_body_s %} bolder-font{% endif %}{% endif %}{% endif %}">
        {% unless block_settings.icon == 'none' %}
        <div class="popup__icon popup__icon--{{ settings.typography_preset }}">
          {% assign icon_name = block_settings.icon | replace: "_", "-" %}
          {% assign icon_full = icon_name | append: "-" | append: weight %}
          {% case icon_name %}
          {% when 'search' or 'eye' or 'user' or 'settings' or 'shopping-cart' %}
              {% render 'icon', icon: icon_full %}
          {% when 'scissors' or 'security-badge' or 'share' or 'stiletto' or 'stop-watch'
              or 'sunflower' or 't-shirt' or 'trash' or 'truck' or 'washing-symbol'
              or 'water-bottle' or 'zoom-in' or 'zoom-out' %}
              {% render 'icon-accordion-2', icon: icon_full %}
          {% when 'house' or 'store-front' or 'map' or 'compass' or 'road-sign'
              or 'map-pin' or 'exclamation-mark' or 'warning-sign' or 'customer-support' or 'lightbulb'
              or 'lightbulb-lighting-up' or 'trending-item' or 'kids-friendly' or 'soft' or 'water-proof' or 'multi-language' or 'star' or 'satisfied' or 'flag' or 'freehand' or 'bubble' or 'connector' or 'battery' or 'camera' or 'beach' or 'terrain' or 'food' or 'fitness' or 'hotel' or 'subscription' or 'folder' or 'note'%}
              {% render 'icons-3', icon: icon_full %}
          {% else %}
              {% render 'icon-accordion', icon: icon_full %}
          {% endcase %}
        </div>
        {% endunless %}
        <span>{{ block_settings.link_text }}</span>
        {% if block_settings.show_lines and product_block %}
          <div class="popup__icon popup__icon--{{ settings.typography_preset }} popup__icon--chevron" aria-hidden="true">
              {% assign icon_full = 'close-chevron' | append: "-" | append: weight %}
              {% render 'icon', icon: icon_full %}  
          </div>
        {% endif %}
      </button>
</modal-opener>
