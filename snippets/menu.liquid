{% style %}
        {% liquid
          assign menu_link_size = 'body_s'
          assign menu_link_scale_var = '--menu-ic-bs'
          assign menu_link_scale_desktop_px = 24

          if settings.navigation_item_size != 'default'
            assign menu_link_size = settings.navigation_item_size
          endif

          if menu_settings.link_size != 'default'
            assign menu_link_size = menu_settings.link_size
          endif

          if type == 'main_menu' and menu_settings.menu_font_size != 'default'
            if section.id contains 'main-sidebar'
              assign menu_link_size = menu_settings.menu_font_size
            endif
          endif

          if menu_link_size contains 'heading_xl'
            assign menu_link_scale_var = '--menu-ic-xl'
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.heading_xl_desktop_size | times: settings.heading_xl_line_height
            else
              assign menu_link_scale_desktop_px = 128 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16 | at_most: 128
            endif
          elsif menu_link_size contains 'heading_l'
            assign menu_link_scale_var = '--menu-ic-l'
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.heading_l_desktop_size | times: settings.heading_l_line_height
            else
              assign menu_link_scale_desktop_px = 96 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16 | at_most: 128
            endif
          elsif menu_link_size contains 'heading_m'
            assign menu_link_scale_var = '--menu-ic-m'
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.heading_m_desktop_size | times: settings.heading_m_line_height
            else
              assign menu_link_scale_desktop_px = 64 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16 | at_most: 128
            endif
          elsif menu_link_size contains 'heading_s'
            assign menu_link_scale_var = '--menu-ic-s'
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.heading_s_desktop_size | times: settings.heading_s_line_height
            else
              assign menu_link_scale_desktop_px = 46 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16 | at_most: 128
            endif
          elsif menu_link_size contains 'heading_xs'
            assign menu_link_scale_var = '--menu-ic-xs'
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.heading_xs_desktop_size | times: settings.heading_xs_line_height
            else
              assign menu_link_scale_desktop_px = 36 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16 | at_most: 128
            endif
          elsif menu_link_size contains 'body_l'
            assign menu_link_scale_var = '--menu-ic-bl'
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.body_l_desktop_size | times: settings.body_l_line_height
            else
              assign menu_link_scale_desktop_px = 28 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16
            endif
          elsif menu_link_size contains 'body_m'
            assign menu_link_scale_var = '--menu-ic-bm'
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.body_m_desktop_size | times: settings.body_m_line_height
            else
              assign menu_link_scale_desktop_px = 26 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16
            endif
          elsif menu_link_size contains 'label'
            assign menu_link_scale_var = '--menu-ic-lb'
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.label_desktop_size | times: settings.label_line_height
            else
              assign menu_link_scale_desktop_px = 16 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16
            endif
          else
            assign menu_link_scale_desktop_px = 24 | times: settings.desktop_font_scale | divided_by: 100.0 | round | at_least: 16
            if settings.typography_preset == 'custom'
              assign menu_link_scale_desktop_px = settings.body_s_desktop_size | times: settings.body_s_line_height
            endif
          endif

          assign animationDuration = 0
        if settings.animation_duration == '0.3'
                assign animationDuration = 'basic'
        elsif settings.animation_duration == '0.5'
                assign animationDuration = 'sophisticated'
        endif
        %}
        .menu__list--{{ menu_id }} {
          --highlight-color: {{ menu_settings.highlight_menu_item_color.red }},
                {{ menu_settings.highlight_menu_item_color.green }},
                {{ menu_settings.highlight_menu_item_color.blue }};
        --links-gap-base: {{ links_gap | divided_by: 16.0 | round: 4 }}rem;
        --links-padding-base: {{ links_padding | divided_by: 16.0 | round: 4 }}rem;
        --links-gap: min(var(--links-gap-base), calc(var(--links-gap-base) * (var({{ menu_link_scale_var }}) / {{ menu_link_scale_desktop_px | divided_by: 16.0 | round: 4 }}rem)));
        --links-padding: min(var(--links-padding-base), calc(var(--links-padding-base) * (var({{ menu_link_scale_var }}) / {{ menu_link_scale_desktop_px | divided_by: 16.0 | round: 4 }}rem)));
        }
