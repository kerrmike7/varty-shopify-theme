{% if cart != empty %}
  <product-recommendations 
    class="slider-section slider-section--{{ settings.white_space }} {% if settings.show_lines %}slider-section--lines{% endif %} {% if cart_drawer %}cart-drawer__animated-wrap{% if settings.enable_drawer_animations %} stagger__item{% endif %}{% endif %}"
    {% if cart_drawer and settings.enable_drawer_animations %} 
      style="--item-index: {{ animated_drawer_item_index }};"
    {% endif %} 
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ cart.items.first.product_id }}&limit=10" 
    {% if parent %}
      data-parent="{{ parent }}"
    {% endif %}
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      {%- liquid 
        if settings.typography_preset == 'avant_garde'
          assign weight_close = settings.accent_icon_weight
          if settings.swap_fonts
            assign weight_close = settings.base_icon_weight
          endif
        else 
          assign weight_close =  settings.base_icon_weight
          if settings.swap_fonts
            assign weight_close = settings.accent_icon_weight
          endif
        endif

        assign desktop_layout = cart_recommendations_settings.desktop_grid_type | times: 1
        if cart_recommendations_settings.desktop_grid_type == 'heading_with_two'
          assign desktop_layout = 2
        elsif cart_recommendations_settings.desktop_grid_type == 'heading_with_three' or section.id contains 'cart-drawer'
          assign desktop_layout = 3
        endif
      
        assign mobile_layout = cart_recommendations_settings.mobile_layout | times: 1 | at_least: 1
      
        if recommendations.products_count < mobile_layout
          assign mobile_layout = recommendations.products_count | at_least: 1
        endif

        unless desktop_media_width
          case cart_recommendations_settings.desktop_grid_type
            when '3'
              assign desktop_media_width = 3
            when '4'
              assign desktop_media_width = 4
            when '5'
              assign desktop_media_width = 5
            when 'heading_with_two'
              assign desktop_media_width = 3
            when 'heading_with_three'
              assign desktop_media_width = 4
            else
              assign desktop_media_width = 3
          endcase
        endunless

        assign mobile_media_width = mobile_layout

        assign uppercase_font = false
        assign bolder_font = false
        if settings.typography_preset == 'custom'
          assign weight_close = settings.custom_icon_weight
          if cart_recommendations_settings.heading_size == 'default'
            if section.id contains 'cart-drawer'
              if settings.uppercase_body_s
                assign uppercase_font = true
              endif
              if settings.bolder_font_body_s
                assign bolder_font = true
              endif
            else
              if settings.uppercase_heading_xs
                assign uppercase_font = true
              endif
              if settings.bolder_font_heading_xs
                assign bolder_font = true
              endif
            endif
          endif
        endif
      -%}

      {% style %}
        {% unless section.id contains 'cart-drawer' %}     
          #Slider-Gallery-{{ section.id }} {
            {% if cart_recommendations_settings.desktop_grid_type == 'heading_with_two' %}
              --desktop-grid-type: 2;
            {% elsif cart_recommendations_settings.desktop_grid_type == 'heading_with_three' %}
              --desktop-grid-type: 3;
            {% else %}
            --desktop-grid-type: {{ cart_recommendations_settings.desktop_grid_type }};
            {% endif %}
          }

          /* Styles for full-width page without sidebars */
          /* Mobile */
          @media screen and (max-width: 768px) {
            #Slider-Gallery-{{ section.id }} {
              --desktop-grid-type: {{ mobile_layout }};
            }
          }
          @media screen and (min-width: 921px) {
            /* Mobile */
            @container inside-content (max-width: 768px) {
              #Slider-Gallery-{{ section.id }} {
                --desktop-grid-type: {{ mobile_layout }};
              }
            }
          }
        {% endunless %}
      {% endstyle %}

      <slider-component id="GalleryViewer-{{ section.id }}" class="slider {% if cart_recommendations_settings.desktop_grid_type == 'heading_with_two' or cart_recommendations_settings.desktop_grid_type == 'heading_with_three' %}slider--row{% endif %} {% if cart_recommendations_settings.desktop_grid_type == 'heading_with_two' %}slider--row-two{% endif %} {% if cart_recommendations_settings.desktop_grid_type == 'heading_with_three' %}slider--row-three{% endif %}">
        <div class="slider__header {% if settings.center_text %}slider__header-center{% endif %} {% if cart_recommendations_settings.heading == blank and cart_recommendations_settings.desktop_grid_type == '3' or cart_recommendations_settings.heading == blank and cart_recommendations_settings.desktop_grid_type == '4' or cart_recommendations_settings.heading == blank and cart_recommendations_settings.desktop_grid_type == '5' %}slider__header--hidden{% endif %} {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
          {% if cart_recommendations_settings.heading != blank %}
            {% liquid
              assign heading_text = cart_recommendations_settings.heading | escape
              assign final_text = ''
              assign split_text_curly = heading_text | split: '{'
              for part in split_text_curly
                  if part contains '}'
                      assign split_curly = part | split: '}'
                      assign styled_text = split_curly[0]
                      assign after_curly = split_curly[1]
                      assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                  else
                      assign final_text = final_text | append: part
                  endif
              endfor
            %}
            {% liquid
              if section.id contains 'cart-drawer'
                assign cart_recommendations_heading_tag = 'h2'
              else
                assign cart_recommendations_heading_tag = cart_recommendations_settings.heading_tag
              endif
            %}
            <{{ cart_recommendations_heading_tag }} class="slider__heading custom-heading {% if settings.accent_color_for_headings %}slider__heading--accent{% endif %} slider__heading--{{ settings.typography_preset }} {% if cart_recommendations_settings.heading_size != 'default' %}{{ cart_recommendations_settings.heading_size }}{% else %}{% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %}{% endif %}
              {% if disable_layout_margins %} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }}{% endif %}">
              {% if cart_recommendations_settings.heading_color == 'gradient' and cart_recommendations_settings.heading_gradient != blank %}
                <span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{{ final_text }}</span>
              {% else %}
                {{ final_text }}
              {% endif %}
            </{{ cart_recommendations_heading_tag }}>
          {% endif %}

          {% if cart_recommendations_settings.desktop_grid_type == 'heading_with_two' or cart_recommendations_settings.desktop_grid_type == 'heading_with_three' %}
            
            <div class="slider-buttons-items {% if recommendations.products_count <= desktop_layout or settings.center_text == true and cart_recommendations_settings.desktop_grid_type != 'heading_with_two' and settings.center_text == true and cart_recommendations_settings.desktop_grid_type != 'heading_with_three' %}hidden-desktop{% endif %} hidden-mobile">
              <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
                {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
                {% render 'icon-accordion-2', icon: icon_full %}
              </button>
              <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
                {% render 'icon-accordion-2', icon: icon_full %}
              </button>
            </div>
          {% endif %}
        </div>

        <div class="slider__viewport">
          {%- liquid
            assign card_product_settings = section.settings
            if section.id contains 'cart-drawer'
              assign card_product_settings = settings
            endif
          -%}
          <ul id="Slider-Gallery-{{ section.id }}" class="slider__grid slider__grid-mobile-{{ mobile_layout }}" role="list"  
            data-count="{{ desktop_layout }}"
            data-count-mobile="{{ mobile_layout }}"
          >
            {% for recommendation in recommendations.products %}
              {% assign mobileItems = mobile_layout %}
              <li id="Slide-{{ section.id }}" class="slider__grid-item snap-align {% if forloop.first %}is-active{% endif %} 
                {% if cart_recommendations_settings.desktop_grid_type == '5' and forloop.index == 4 %}no-line{% endif %}
                {% if forloop.last and settings.show_lines and forloop.length >= desktop_layout %}last-desktop{% endif %} 
                {% if forloop.last and settings.show_lines and forloop.length >= mobile_layout %}last-mobile{% endif %}
                {% if recommendations.products_count == mobileItems %}last-element{% endif %}" {% if section.id == 'cart-drawer' %}style="--focal-point: {{ settings.focal_point }};"{% endif %}>
                {% render 'card-product',
                  card_product: recommendation,
                  image_ratio: card_product_settings.image_ratio,
                  show_vendor: card_product_settings.show_vendor,
                  enable_quick_view: card_product_settings.enable_quick_view,
                  enable_add_to_cart: card_product_settings.enable_add_to_cart,
                  price_position: card_product_settings.price_position,
                  max_product_name_characters: card_product_settings.max_product_name_characters,
                  show_short_description: card_product_settings.show_short_description,
                  enable_color_pills: card_product_settings.enable_color_pills,
                  show_rating: card_product_settings.show_rating,
                  hover_behavior: card_product_settings.hover_behavior,
                  show_bullets: card_product_settings.show_bullets,
                  show_pickup_availability: section.settings.show_pickup_availability,
                  disable_layout_margins: disable_layout_margins,
                  center_text: settings.center_text,
                  desktop_media_width: desktop_media_width,
                  mobile_media_width: mobile_media_width,
                  modal_container_width: modal_container_width,
                  desktop_content_margin: desktop_content_margin,
                  mobile_content_margin: mobile_content_margin
                %}
              </li>
            {% endfor %}
          </ul>

          <div class="slider-buttons-items slider-buttons-items--bottom {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %} 
            {% if is_compact %} slider-buttons-items--compact {% else %} slider-buttons-items--{{ settings.white_space }}{% endif %} 
            {% if settings.show_lines %}slider-buttons-items--lines{% endif %} 
            {% if cart_recommendations_settings.desktop_grid_type != '3' and cart_recommendations_settings.desktop_grid_type != '4' and cart_recommendations_settings.desktop_grid_type != '5' and section.id != 'cart-drawer' %}hidden-desktop{% endif %} 
            {% if recommendations.products_count <= desktop_layout %}hidden-desktop{% endif %}
            {% if cart_recommendations_settings.desktop_grid_type == '5' and recommendations.products_count == 5 %}hidden-desktop-none{% endif %}
            {% if recommendations.products_count <= mobile_layout or cart_recommendations_settings.mobile_navigation == 'scrollbar' %}hidden-mobile{% endif %}"
          >
            <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
              {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
              {% render 'icon-accordion-2', icon: icon_full %}
            </button>
            <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
              {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
              {% render 'icon-accordion-2', icon: icon_full %}
            </button>
          </div>
          {% if cart_recommendations_settings.mobile_navigation == 'scrollbar' and recommendations.products_count > mobile_layout %}
            <div role="scrollbar" aria-orientation="horizontal" aria-valuemax="100" aria-valuemin="0" aria-valuenow="39" class="slider-buttons-items slider-scrollbar hidden-desktop {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
              <span class="slider-scrollbar__track">
                <span class="slider-scrollbar__thumb"></span>
              </span>
            </div>
          {% endif %}
        </div>
      </slider-component>
    {% endif %}
  </product-recommendations>
{% endif %}
