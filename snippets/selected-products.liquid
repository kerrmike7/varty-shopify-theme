<div class="slider-section {% if section_content == false %}block-content{% endif %} slider-section--{{ settings.white_space }} {% if settings.show_lines %}{% if section_content %}slider-section--lines{% endif %}{% endif %}">
  {%- liquid 
    if settings.typography_preset == 'avant_garde'
      assign weight_close = settings.accent_icon_weight
      if settings.swap_fonts
        assign weight_close = settings.base_icon_weight
      endif
    elsif settings.typography_preset != 'custom'
      assign weight_close =  settings.base_icon_weight
      if settings.swap_fonts
        assign weight_close = settings.accent_icon_weight
      endif
    else 
      assign weight_close =  settings.custom_icon_weight
    endif

    assign desktop_layout = selected_products_settings.desktop_grid_type | times: 1
    if selected_products_settings.desktop_grid_type == 'heading_with_two'
      assign desktop_layout = 2
    elsif selected_products_settings.desktop_grid_type == 'heading_with_three'
      assign desktop_layout = 3
    endif

    assign mobile_layout = selected_products_settings.mobile_layout | times: 1 | at_least: 1

    assign products_count = selected_products_settings.product_list.count

    if products_count < mobile_layout
      assign mobile_layout = products_count | at_least: 1
    endif

    case selected_products_settings.desktop_grid_type
      when '3'
        assign desktop_media_width = 3
      when '4'
        assign desktop_media_width = 4
      when '5'
        assign desktop_media_width = 5
      when 'heading_with_two'
        assign desktop_media_width = 3
      when 'heading_with_three'
        assign desktop_media_width = 4
      else
        assign desktop_media_width = 3
    endcase

    assign mobile_media_width = mobile_layout
  -%}

  {% style %}
    #Slider-Gallery-{{ section.id }} {
      {% if selected_products_settings.desktop_grid_type == 'heading_with_two' %}
        --desktop-grid-type: 2;
      {% elsif selected_products_settings.desktop_grid_type == 'heading_with_three' %}
        --desktop-grid-type: 3;
      {% else %}
      --desktop-grid-type: {{ selected_products_settings.desktop_grid_type }};
      {% endif %}
    }

    /* Styles for full-width page without sidebars */
    /* Mobile */
    @media screen and (max-width: 768px) {
      #Slider-Gallery-{{ section.id }} {
        --desktop-grid-type: {{ mobile_layout }};
      }
    }

    @media screen and (min-width: 921px) {
      /* Mobile */
      @container inside-content (max-width: 768px) {
        #Slider-Gallery-{{ section.id }} {
          --desktop-grid-type: {{ mobile_layout }};
        }
      }
    }
  {% endstyle %}

  <slider-component id="GalleryViewer-{{ section.id }}" class="slider {% if selected_products_settings.desktop_grid_type == 'heading_with_two' or selected_products_settings.desktop_grid_type == 'heading_with_three' %}slider--row{% endif %} {% if selected_products_settings.desktop_grid_type == 'heading_with_two' %}slider--row-two{% endif %} {% if selected_products_settings.desktop_grid_type == 'heading_with_three' %}slider--row-three{% endif %}">
      <div class="slider__header {% if settings.center_text %}slider__header-center{% endif %} {% if selected_products_settings.heading == blank and selected_products_settings.desktop_grid_type == '3' or selected_products_settings.heading == blank and selected_products_settings.desktop_grid_type == '4' or selected_products_settings.heading == blank and selected_products_settings.desktop_grid_type == '5' %}slider__header--hidden{% endif %} 
        {% if disable_layout_margins %}{% if section.settings.desktop_grid_type == 'heading_with_two' or section.settings.desktop_grid_type == 'heading_with_three' %} desktop-padding-left{% else %}section-padding--{{ settings.white_space }}{% endif %}{% endif %}">
        {% if selected_products_settings.heading != blank %}
          {% liquid
            assign uppercase_font = false
            assign bolder_font = false
            if settings.typography_preset == 'custom' and selected_products_settings.heading_size == 'default'
              if section_content
                if settings.uppercase_heading_xs
                  assign uppercase_font = true
                endif
                if settings.bolder_font_heading_xs
                  assign bolder_font = true
                endif
              else
                if settings.uppercase_body_s
                  assign uppercase_font = true
                endif
                if settings.bolder_font_body_s
                  assign bolder_font = true
                endif
              endif
            endif
            assign heading_text = selected_products_settings.heading
            assign final_text = ''
            assign split_text_curly = heading_text | split: '{'
            for part in split_text_curly
                if part contains '}'
                    assign split_curly = part | split: '}'
                    assign styled_text = split_curly[0]
                    assign after_curly = split_curly[1]
                    assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                else
                    assign final_text = final_text | append: part
                endif
            endfor
          %} 
          <{% if section_content %}{{ selected_products_settings.heading_tag }}{% else %}h2{% endif %} class="slider__heading custom-heading {% if section_content %}{% if settings.accent_color_for_headings %}slider__heading--accent{% endif %}{% endif %} {% if section_content == false %}block-heading--{{ settings.typography_preset }}{% else %}slider__heading--{{ settings.typography_preset }}{% endif %} {% if uppercase_font %} uppercase{% endif %}{% if bolder_font %} bolder-font{% endif %} {% unless selected_products_settings.heading_size == 'default' %}{{ selected_products_settings.heading_size }}{% endunless %} 
            {% if disable_layout_margins %}{% if section.settings.desktop_grid_type == 'heading_with_two' or section.settings.desktop_grid_type == 'heading_with_three' %}{% else %} {% if settings.max_page_width == '1400' or settings.max_page_width == '1200' %}page-width {% endif %} page-width--{{ settings.max_page_width }}{% endif %}{% endif %}">
            {% if selected_products_settings.heading_color == 'gradient' and selected_products_settings.heading_gradient != blank %}<span class="gradient-heading-text gradient-heading-text--{{ section.id }}">{% endif %}
            {{ final_text }}
            {% if selected_products_settings.heading_color == 'gradient' and selected_products_settings.heading_gradient != blank %}</span>{% endif %}
            </{% if section_content %}{{ selected_products_settings.heading_tag }}{% else %}h2{% endif %}>
        {% endif %}
        {% if selected_products_settings.desktop_grid_type == 'heading_with_two' or selected_products_settings.desktop_grid_type == 'heading_with_three' %}
            {% if section_content %}
              <div class="slider-buttons-items {% if products_count <= desktop_layout or settings.center_text == true and selected_products_settings.desktop_grid_type != 'heading_with_two' and settings.center_text == true and selected_products_settings.desktop_grid_type != 'heading_with_three' %}hidden-desktop{% endif %} hidden-mobile">
                <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
                  {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
                  {% render 'icon-accordion-2', icon: icon_full %}
                </button>
                <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                  {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
                  {% render 'icon-accordion-2', icon: icon_full %}
                </button>
              </div>
            {% endif %}
        {% endif %}
      </div>
        {% if selected_products_settings.product_list != blank %}
          <div class="slider__viewport">
            <ul 
              id="Slider-Gallery-{{ section.id }}" 
              data-id="{{ section.id }}" 
              class="slider__grid slider__grid--{{ settings.white_space }} slider__grid-mobile-{{ selected_products_settings.mobile_layout }} {% if settings.show_lines %} lines{% endif %}" 
              data-count="{{ desktop_layout }}" 
              data-count-mobile="{{ mobile_layout }}"
            >
              {%- liquid 
                assign card_product_settings = section.settings
                if section_content == false
                  assign card_product_settings = selected_products_settings
                endif
              -%}
              {%- for product in selected_products_settings.product_list -%}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li id="Slide-{{ section.id }}" class="slider__grid-item snap-align 
                  {% if forloop.first %}is-active{% endif %} 
                  {% if selected_products_settings.desktop_grid_type == '5' and forloop.index == 4 %}no-line{% endif %}
                  {% if forloop.last and settings.show_lines and forloop.length >= desktop_layout %}last-desktop{% endif %} 
                  {% if forloop.last and settings.show_lines and forloop.length >= mobile_layout %}last-mobile{% endif %} 
                  {% if products_count == mobile_layout %}last-element{% endif %}" style="--focal-point: {{ selected_products_settings.focal_point }};">
                  {% render 'card-product',
                    block_type: block.type,
                    card_product: product,
                    image_ratio: card_product_settings.image_ratio,
                    show_vendor: card_product_settings.show_vendor,
                    hover_behavior: card_product_settings.hover_behavior,
                    show_bullets: card_product_settings.show_bullets,
                    enable_quick_view: card_product_settings.enable_quick_view,
                    enable_add_to_cart: card_product_settings.enable_add_to_cart,
                    price_position: card_product_settings.price_position,
                    max_product_name_characters: card_product_settings.max_product_name_characters,
                    show_short_description: card_product_settings.show_short_description,
                    enable_color_pills: card_product_settings.enable_color_pills,
                    show_rating: card_product_settings.show_rating,
                    show_pickup_availability: section.settings.show_pickup_availability,
                    disable_layout_margins: disable_layout_margins,
                    center_text: settings.center_text,
                    desktop_media_width: desktop_media_width,
                    mobile_media_width: mobile_media_width,
                    desktop_content_margin: desktop_content_margin,
                    mobile_content_margin: mobile_content_margin
                  %}
                </li>
              {%- endfor -%}
            </ul>
              {% if section_content %}
                <div class="slider-buttons-items slider-buttons-items--bottom slider-buttons-items--{{ settings.white_space }} {% if settings.show_lines %}slider-buttons-items--lines{% endif %} {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %} 
                  {% if selected_products_settings.desktop_grid_type != '3' and selected_products_settings.desktop_grid_type != '4' and selected_products_settings.desktop_grid_type != '5' %}hidden-desktop{% endif %}
                  {% if products_count <= desktop_layout %}hidden-desktop{% endif %} 
                  {% if selected_products_settings.desktop_grid_type == '5' and products_count == 5 %}hidden-desktop-none{% endif %}
                  {% if products_count <= mobile_layout or selected_products_settings.mobile_navigation == 'scrollbar' %}hidden-mobile{% endif %}">
                  <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
                    {% assign icon_full = 'arrow-long-left' | append: "-" | append: weight_close %}
                    {% render 'icon-accordion-2', icon: icon_full %}
                  </button>
                  <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
                    {% assign icon_full = 'arrow-long-right' | append: "-" | append: weight_close %}
                    {% render 'icon-accordion-2', icon: icon_full %}
                  </button>
                </div>
                {% if selected_products_settings.mobile_navigation == 'scrollbar' and products_count > mobile_layout %}
                  <div role="scrollbar" aria-orientation="horizontal" aria-valuemax="100" aria-valuemin="0" aria-valuenow="39" class="slider-buttons-items slider-scrollbar hidden-desktop {% if disable_layout_margins %} section-padding--{{ settings.white_space }}{% endif %}">
                    <span class="slider-scrollbar__track">
                      <span class="slider-scrollbar__thumb"></span>
                    </span>
                  </div>
                {% endif %}
              {% endif %}
          </div>
        {% endif %}
    </slider-component>
</div> 
