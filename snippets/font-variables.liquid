        --accent-heading-s-font: var(--accent-font-style) var(--accent-font-weight) var(--fluid-preset-s-fs) / var(--fluid-preset-s-lh) var(--accent-font-family);
        --accent-heading-xs-font: var(--accent-font-style) var(--accent-font-weight) var(--fluid-preset-xs-fs) / var(--fluid-preset-xs-lh) var(--accent-font-family);
        --accent-body-l-font: var(--accent-font-style) var(--accent-font-weight) var(--fluid-preset-body-l-fs) / var(--fluid-preset-body-l-lh) var(--accent-font-family);
        --accent-body-m-font: var(--accent-font-style) var(--accent-font-weight) var(--fluid-preset-body-m-fs) / var(--fluid-preset-body-m-lh) var(--accent-font-family);
        --accent-body-s-font: var(--accent-font-style) var(--accent-font-weight) var(--fluid-preset-body-s-fs) / var(--fluid-preset-body-s-lh) var(--accent-font-family);
        --accent-label-font: var(--accent-font-style) var(--accent-font-weight) var(--fluid-preset-label-fs) / var(--fluid-preset-label-lh) var(--accent-font-family);

