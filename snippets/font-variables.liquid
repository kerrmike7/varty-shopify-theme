        --base-body-l-font: var(--base-font-style) var(--base-font-weight) var(--fluid-preset-body-l-fs) / var(--fluid-preset-body-l-lh) var(--base-font-family);
        --base-body-m-font: var(--base-font-style) var(--base-font-weight) var(--fluid-preset-body-m-fs) / var(--fluid-preset-body-m-lh) var(--base-font-family);
        --base-body-s-font: var(--base-font-style) var(--base-font-weight) var(--fluid-preset-body-s-fs) / var(--fluid-preset-body-s-lh) var(--base-font-family);
        --base-label-font: var(--base-font-style) var(--base-font-weight) var(--fluid-preset-label-fs) / var(--fluid-preset-label-lh) var(--base-font-family);
