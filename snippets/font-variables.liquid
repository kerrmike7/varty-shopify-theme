        --fluid-challenge-lh: clamp({{ ch_lh_m | at_most: ch_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ ch_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ ch_lh_d | minus: ch_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ ch_lh_m | at_least: ch_lh_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-rating-star: clamp({{ rating_unit_m | at_most: rating_unit_d }}, calc({{ rating_unit_m }} + (min(100vw, 1920px) - 375px) / {{ fluid_range }}px * ({{ rating_unit_d | minus: rating_unit_m }})), {{ rating_unit_m | at_least: rating_unit_d }});
        --base-heading-xl-font: var(--base-font-style) var(--base-font-weight) var(--fluid-preset-xl-fs) / var(--fluid-preset-xl-lh) var(--base-font-family);
        --base-heading-l-font: var(--base-font-style) var(--base-font-weight) var(--fluid-preset-l-fs) / var(--fluid-preset-l-lh) var(--base-font-family);
        --base-heading-m-font: var(--base-font-style) var(--base-font-weight) var(--fluid-preset-m-fs) / var(--fluid-preset-m-lh) var(--base-font-family);
        --base-heading-s-font: var(--base-font-style) var(--base-font-weight) var(--fluid-preset-s-fs) / var(--fluid-preset-s-lh) var(--base-font-family);
