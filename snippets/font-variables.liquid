        --fluid-preset-label-lh: clamp({{ p_lb_lh_m | at_most: p_lb_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_lb_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_lb_lh_d | minus: p_lb_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_lb_lh_m | at_least: p_lb_lh_d | divided_by: 16.0 | round: 4 }}rem);
