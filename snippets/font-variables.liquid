{% style %}
{% liquid
  assign fluid_range = 1545
  assign mob_s = settings.mobile_font_scale | times: 1.0 | divided_by: 100.0
  assign desk_s = settings.desktop_font_scale | times: 1.0 | divided_by: 100.0
  assign mob_xlm_fs = 32 | times: mob_s | round | at_least: 12 | at_most: 128
  assign mob_xlm_lh = 46 | times: mob_s | round | at_least: 16 | at_most: 128
  assign p_xl_fs_m = mob_xlm_fs
  assign p_xl_fs_d = 128 | times: desk_s | round | at_least: 12 | at_most: 128
  assign p_xl_lh_m = mob_xlm_lh
  assign p_xl_lh_d = 128 | times: desk_s | round | at_least: 16 | at_most: 128
  assign p_l_fs_m = mob_xlm_fs
  assign p_l_fs_d = 80 | times: desk_s | round | at_least: 12 | at_most: 128
  assign p_l_lh_m = mob_xlm_lh
  assign p_l_lh_d = 96 | times: desk_s | round | at_least: 16 | at_most: 128
  assign p_m_fs_m = mob_xlm_fs
  assign p_m_fs_d = 48 | times: desk_s | round | at_least: 12 | at_most: 128
  assign p_m_lh_m = mob_xlm_lh
  assign p_m_lh_d = 64 | times: desk_s | round | at_least: 16 | at_most: 128
  assign p_s_fs_m = 32 | times: mob_s | round | at_least: 12 | at_most: 128
  assign p_s_fs_d = 32 | times: desk_s | round | at_least: 12 | at_most: 128
  assign p_s_lh_m = 46 | times: mob_s | round | at_least: 16 | at_most: 128
  assign p_s_lh_d = 46 | times: desk_s | round | at_least: 16 | at_most: 128
  assign p_xs_fs_m = 24 | times: mob_s | round | at_least: 12 | at_most: 128
  assign p_xs_fs_d = 24 | times: desk_s | round | at_least: 12 | at_most: 128
  assign p_xs_lh_m = 36 | times: mob_s | round | at_least: 16 | at_most: 128
  assign p_xs_lh_d = 36 | times: desk_s | round | at_least: 16 | at_most: 128
  assign p_bl_fs_m = 18 | times: mob_s | round | at_least: 12
  assign p_bl_fs_d = 18 | times: desk_s | round | at_least: 12
  assign p_bl_lh_m = 28 | times: mob_s | round | at_least: 16
  assign p_bl_lh_d = 28 | times: desk_s | round | at_least: 16
  assign p_bm_fs_m = 16 | times: mob_s | round | at_least: 12
  assign p_bm_fs_d = 16 | times: desk_s | round | at_least: 12
  assign p_bm_lh_m = 26 | times: mob_s | round | at_least: 16
  assign p_bm_lh_d = 26 | times: desk_s | round | at_least: 16
  assign p_bs_fs_m = 14 | times: mob_s | round | at_least: 12
  assign p_bs_fs_d = 14 | times: desk_s | round | at_least: 12
  assign p_bs_lh_m = 24 | times: mob_s | round | at_least: 16
  assign p_bs_lh_d = 24 | times: desk_s | round | at_least: 16
  assign p_lb_fs_m = 12 | times: mob_s | round | at_least: 12
  assign p_lb_fs_d = 12 | times: desk_s | round | at_least: 12
  assign p_lb_lh_m = 16 | times: mob_s | round | at_least: 16
  assign p_lb_lh_d = 16 | times: desk_s | round | at_least: 16
  assign ch_fs_m = 24 | times: mob_s | round | at_least: 12
  assign ch_fs_d = 24 | times: desk_s | round | at_least: 12
  assign ch_lh_m = 36 | times: mob_s | round | at_least: 16
  assign ch_lh_d = 36 | times: desk_s | round | at_least: 16
  assign rating_unit_m = 17 | times: mob_s | divided_by: 10.0 | round: 1
  assign rating_unit_d = 17 | times: desk_s | divided_by: 10.0 | round: 1
  assign ui24_m = 24 | times: mob_s | round | at_least: 16
  assign ui24_d = 24 | times: desk_s | round | at_least: 16
  assign ui28_m = 28 | times: mob_s | round | at_least: 16
  assign ui28_d = 28 | times: desk_s | round | at_least: 16
  assign ui16_m = 16 | times: mob_s | round | at_least: 16
  assign ui16_d = 16 | times: desk_s | round | at_least: 16
  assign ui26_m = 26 | times: mob_s | round | at_least: 16
  assign ui26_d = 26 | times: desk_s | round | at_least: 16
  assign ui36_m = 36 | times: mob_s | round | at_least: 16
  assign ui36_d = 36 | times: desk_s | round | at_least: 16
  if settings.typography_preset == 'custom'
    assign cxl_m = settings.heading_xl_mobile_size
    assign cxl_d = settings.heading_xl_desktop_size
    assign cl_m = settings.heading_l_mobile_size
    assign cl_d = settings.heading_l_desktop_size
    assign cm_m = settings.heading_m_mobile_size
    assign cm_d = settings.heading_m_desktop_size
    assign cs_m = settings.heading_s_mobile_size
    assign cs_d = settings.heading_s_desktop_size
    assign cxs_m = settings.heading_xs_mobile_size
    assign cxs_d = settings.heading_xs_desktop_size
    assign cbl_m = settings.body_l_mobile_size
    assign cbl_d = settings.body_l_desktop_size
    assign cbm_m = settings.body_m_mobile_size
    assign cbm_d = settings.body_m_desktop_size
    assign cbs_m = settings.body_s_mobile_size
    assign cbs_d = settings.body_s_desktop_size
    assign clb_m = settings.label_mobile_size
    assign clb_d = settings.label_desktop_size
  endif
%}
    :root {
        {% if settings.swap_fonts %}
          --base-font-family: {{ settings.accent_font.family }}, {{ settings.accent_font.fallback_families }};
          --base-font-style: {{ settings.accent_font.style }};
          --base-font-weight: {{ settings.accent_font.weight }};
          --accent-font-family: {{ settings.base_font.family }}, {{ settings.base_font.fallback_families }};
          --accent-font-style: {{ settings.base_font.style }};
          --accent-font-weight: {{ settings.base_font.weight }};
        {% else %}
          --base-font-family: {{ settings.base_font.family }}, {{ settings.base_font.fallback_families }};
          --base-font-style: {{ settings.base_font.style }};
          --base-font-weight: {{ settings.base_font.weight }};
          --accent-font-family: {{ settings.accent_font.family }}, {{ settings.accent_font.fallback_families }};
          --accent-font-style: {{ settings.accent_font.style }};
          --accent-font-weight: {{ settings.accent_font.weight }};
        {% endif %}
        --custom-font-family: {{ settings.custom_font.family }}, {{ settings.custom_font.fallback_families }};
        --custom-font-style: {{ settings.custom_font.style }};
        --custom-font-weight: {{ settings.custom_font.weight }};

        --fluid-menu-ui-24: clamp({{ ui24_m | at_most: ui24_d | divided_by: 16.0 | round: 4 }}rem, calc({{ ui24_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ ui24_d | minus: ui24_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ ui24_m | at_least: ui24_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-menu-ui-28: clamp({{ ui28_m | at_most: ui28_d | divided_by: 16.0 | round: 4 }}rem, calc({{ ui28_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ ui28_d | minus: ui28_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ ui28_m | at_least: ui28_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-menu-ui-16: clamp({{ ui16_m | at_most: ui16_d | divided_by: 16.0 | round: 4 }}rem, calc({{ ui16_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ ui16_d | minus: ui16_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ ui16_m | at_least: ui16_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-menu-ui-26: clamp({{ ui26_m | at_most: ui26_d | divided_by: 16.0 | round: 4 }}rem, calc({{ ui26_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ ui26_d | minus: ui26_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ ui26_m | at_least: ui26_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-menu-ui-36: clamp({{ ui36_m | at_most: ui36_d | divided_by: 16.0 | round: 4 }}rem, calc({{ ui36_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ ui36_d | minus: ui36_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ ui36_m | at_least: ui36_d | divided_by: 16.0 | round: 4 }}rem);

        {% if settings.typography_preset != 'custom' %}
        --fluid-preset-xl-fs: clamp({{ p_xl_fs_m | at_most: p_xl_fs_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_xl_fs_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_xl_fs_d | minus: p_xl_fs_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_xl_fs_m | at_least: p_xl_fs_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-xl-lh: clamp({{ p_xl_lh_m | at_most: p_xl_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_xl_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_xl_lh_d | minus: p_xl_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_xl_lh_m | at_least: p_xl_lh_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-l-fs: clamp({{ p_l_fs_m | at_most: p_l_fs_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_l_fs_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_l_fs_d | minus: p_l_fs_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_l_fs_m | at_least: p_l_fs_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-l-lh: clamp({{ p_l_lh_m | at_most: p_l_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_l_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_l_lh_d | minus: p_l_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_l_lh_m | at_least: p_l_lh_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-m-fs: clamp({{ p_m_fs_m | at_most: p_m_fs_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_m_fs_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_m_fs_d | minus: p_m_fs_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_m_fs_m | at_least: p_m_fs_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-m-lh: clamp({{ p_m_lh_m | at_most: p_m_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_m_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_m_lh_d | minus: p_m_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_m_lh_m | at_least: p_m_lh_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-s-fs: clamp({{ p_s_fs_m | at_most: p_s_fs_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_s_fs_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_s_fs_d | minus: p_s_fs_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_s_fs_m | at_least: p_s_fs_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-s-lh: clamp({{ p_s_lh_m | at_most: p_s_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_s_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_s_lh_d | minus: p_s_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_s_lh_m | at_least: p_s_lh_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-xs-fs: clamp({{ p_xs_fs_m | at_most: p_xs_fs_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_xs_fs_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_xs_fs_d | minus: p_xs_fs_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_xs_fs_m | at_least: p_xs_fs_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-xs-lh: clamp({{ p_xs_lh_m | at_most: p_xs_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_xs_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_xs_lh_d | minus: p_xs_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_xs_lh_m | at_least: p_xs_lh_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-body-l-fs: clamp({{ p_bl_fs_m | at_most: p_bl_fs_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_bl_fs_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_bl_fs_d | minus: p_bl_fs_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_bl_fs_m | at_least: p_bl_fs_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-body-l-lh: clamp({{ p_bl_lh_m | at_most: p_bl_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_bl_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_bl_lh_d | minus: p_bl_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_bl_lh_m | at_least: p_bl_lh_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-body-m-fs: clamp({{ p_bm_fs_m | at_most: p_bm_fs_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_bm_fs_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_bm_fs_d | minus: p_bm_fs_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_bm_fs_m | at_least: p_bm_fs_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-body-m-lh: clamp({{ p_bm_lh_m | at_most: p_bm_lh_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_bm_lh_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_bm_lh_d | minus: p_bm_lh_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_bm_lh_m | at_least: p_bm_lh_d | divided_by: 16.0 | round: 4 }}rem);
        --fluid-preset-body-s-fs: clamp({{ p_bs_fs_m | at_most: p_bs_fs_d | divided_by: 16.0 | round: 4 }}rem, calc({{ p_bs_fs_m | divided_by: 16.0 | round: 4 }}rem + (min(100vw, 1920px) - 375px) * ({{ p_bs_fs_d | minus: p_bs_fs_m }}) / {{ fluid_range | times: 16 }}px * 1rem), {{ p_bs_fs_m | at_least: p_bs_fs_d | divided_by: 16.0 | round: 4 }}rem);
