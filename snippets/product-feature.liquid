{%- liquid 
    if settings.typography_preset == 'avant_garde'
			assign close_weight = settings.accent_icon_weight
			if settings.swap_fonts
					assign close_weight = settings.base_icon_weight
			endif
	else 
			assign close_weight =  settings.base_icon_weight
			if settings.swap_fonts
					assign close_weight = settings.accent_icon_weight
			endif
	endif

    if settings.typography_preset == 'avant_garde' or settings.typography_preset == 'classic' or settings.typography_preset == 'duet'
			assign title_weight = settings.accent_icon_weight
			if settings.swap_fonts
					assign title_weight = settings.base_icon_weight
			endif
	else 
			assign title_weight =  settings.base_icon_weight
			if settings.swap_fonts
					assign title_weight = settings.accent_icon_weight
			endif
	endif
    if settings.typography_preset == 'custom'
        assign title_weight = settings.custom_icon_weight
        assign close_weight = settings.custom_icon_weight
    endif
-%}

{% style %}
{% if settings.typography_preset != 'custom' %}
.product-labels__title svg,
.product-labels__description svg {
    width: max(16px, var(--fluid-preset-body-s-lh));
    height: max(16px, var(--fluid-preset-body-s-lh));
}
{% else %}
.product-labels__title svg {
    width: max(16px, calc(var(--body-s-font-size) * var(--body-s-line-height)));
    height: max(16px, calc(var(--body-s-font-size) * var(--body-s-line-height)));
}
.product-labels__description svg {
    width: max(16px, calc(var(--label-font-size) * var(--label-line-height)));
    height: max(16px, calc(var(--label-font-size) * var(--label-line-height)));
}
section.icons_with_text .product-labels__description svg {
    width: max(16px, calc(var(--body-m-font-size) * var(--body-m-line-height)));
    height: max(16px, calc(var(--body-m-font-size) * var(--body-m-line-height)));
}
{% endif %}
{% endstyle %}

{% liquid
    if product_features_settings.icon_size == 'small'
        assign image_size = '32'
    elsif product_features_settings.icon_size == 'medium'
        assign image_size = '48'
    elsif product_features_settings.icon_size == 'large'
        assign image_size = '90'
    else
        assign image_size = product_features_settings.icon_or_image_size
    endif
%}

{% if icon != 'none' or feature_image != blank or text != blank or feature_page != blank or heading != blank %}
    <double-hover>
        <div class="product-labels__item product-labels__item--{{ settings.typography_preset }} {% if product_features_settings.layout == 'slider' %}card-js{% endif %} {% if product_features_settings.center_text %}centered{% endif %}">
            {% if page_content_in_popup == false %}
                {%- if feature_page != blank -%}<a class="product-labels__link double-hover product-labels__wrapper column {% if product_features_settings.center_text %}center-elements{% endif %}" href="{{ feature_page.url }}">
                {%- else -%}<div class="double-hover product-labels__wrapper column {% if product_features_settings.center_text %}center-elements{% endif %}">
                {%- endif -%}
            {% else %}
                <div class="product-labels__wrapper double-hover open-popup {% if feature_page != blank %}pointer{% endif %} column {% if product_features_settings.center_text %}center-elements{% endif %}" {% if feature_page != blank %}tabindex="0"{% endif %}>
            {% endif %}
                {% if feature_image or icon != 'none' %}
                    <div class="product-labels__image {% if product_features_settings.fill_container %}product-labels__image--fill{% endif %} product-labels__image--{{ product_features_settings.icon_size }}">
                        {% if feature_image != blank %}
                            <div class="product-labels__image-item lazy-image-container ratio-original" style=" --focal-point: {{ feature_image.presentation.focal_point }};" {% if settings.disable_right_click %}oncontextmenu="return false"{% endif %}>
                            {% if settings.images_loading != 'disable' %}
                                <figure class="lazy-image lazy-image--{{ settings.images_loading }}" style="--desktop-asp-rat: {{ feature_image.aspect_ratio }}">
                            {% endif %}
                                <img srcset="{%- if feature_image.width >= 165 -%}{{ feature_image | image_url: width: 165 }} 165w,{%- endif -%}
                                {%- if feature_image.width >= 375 -%}{{ feature_image | image_url: width: 375 }} 375w,{%- endif -%}
                                {%- if feature_image.width >= 550 -%}{{ feature_image | image_url: width: 550 }} 550w,{%- endif -%}
                                {%- if feature_image.width >= 750 -%}{{ feature_image | image_url: width: 750 }} 750w,{%- endif -%}
                                {%- if feature_image.width >= 1100 -%}{{ feature_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                                {%- if feature_image.width >= 1500 -%}{{ feature_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                                    {{ feature_image | image_url: height: feature_image.height }}"
                                    src="{{ feature_image | image_url: height: feature_image.height }}"
                                    loading="lazy"
                                    {% if settings.images_loading != 'disable' %}
                                        onload="this.parentNode.classList.add('lazyloaded');"
                                    {% endif %}
                                    draggable="false"
                                    sizes="calc({{ image_size }}px * 1)"
                                    width="{{ feature_image.width }}"
                                    height="{{ feature_image.height }}"
                                    alt="{{ feature_image.alt | default: shop.name | escape }}"
                                    style="object-position: {{ feature_image.presentation.focal_point }}"
                                />
                            {% if settings.images_loading != 'disable' %}
                                {% if settings.images_loading != 'fade_scale' %}
                                <div class="lazy-image__preloader lazy-image__preloader--full lazy-image__preloader-{{ settings.images_loading }}" aria-hidden="true">
                                    <img 
                                    alt="{{ feature_image.alt | escape }}" 
                                    src="{{ feature_image | image_url: width: 10 }}"
                                    draggable="false"
                                    width="10" 
                                    height="10">
                                </div>
                                {% endif %}
                            </figure>
                            {% endif %}
                            </div>
                        {% else %}
                            <div class="product-labels__icon">
                                {% unless icon == 'none' %}
                                    {% assign icon_name = icon | replace: "_", "-" %}
                                    {% assign icon_full = icon_name | append: "-" | append: product_features_settings.icon_weight %}
                                    {% case icon_name %}
                                    {% when 'search' or 'eye' or 'user' or 'settings' or 'shopping-cart' %}
                                        {% render 'icon', icon: icon_full %}
                                    {% when 'scissors' or 'security-badge' or 'share' or 'stiletto' or 'stop-watch'
                                        or 'sunflower' or 't-shirt' or 'trash' or 'truck' or 'washing-symbol'
                                        or 'water-bottle' or 'zoom-in' or 'zoom-out' %}
                                        {% render 'icon-accordion-2', icon: icon_full %}
                                    {% when 'house' or 'store-front' or 'map' or 'compass' or 'road-sign'
                                        or 'map-pin' or 'exclamation-mark' or 'warning-sign' or 'customer-support' or 'lightbulb'
                                        or 'lightbulb-lighting-up' or 'trending-item' or 'kids-friendly' or 'soft' or 'water-proof' or 'multi-language' or 'star' or 'satisfied' or 'flag' or 'freehand' or 'bubble' or 'connector' or 'battery' or 'camera' or 'beach' or 'terrain' or 'food' or 'fitness' or 'hotel' or 'subscription' or 'folder' or 'note'%}
                                        {% render 'icons-3', icon: icon_full %}
                                    {% else %}
                                        {% render 'icon-accordion', icon: icon_full %}
                                    {% endcase %}
                                {% endunless %}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                    {% if product_section %}
                        {% if text != blank %}
                            <div class="product-labels__description richtext {% if heading == blank %}without-heading{% endif %}  {% if settings.enable_animated_underline %}richtext-link--underline{% endif %} product-labels__description--{{ settings.typography_preset }} {% if product_features_settings.dim_text %}dim{% endif %} {% if product_features_settings.text_size != 'default' %}{{ product_features_settings.text_size }}{% else %}{% if uppercase_text %} uppercase{% endif %}{% if bolder_text %} bolder-font{% endif %}{% endif %}">
                                <object>
                                    {{ text }} 
                                        {% if feature_page != blank %}
                                            {% if page_content_in_popup %}
                                                {% assign icon_full = 'info' | append: "-" | append: close_weight %}
                                                {% render 'icon-accordion-2', icon: icon_full %}
                                            {% else %}
                                                {% assign icon_full = 'arrow-right-up' | append: "-" | append: close_weight %}
                                                {% render 'icon-accordion-2', icon: icon_full %}
                                            {% endif %}
                                        {% endif %}
                                </object>
                            </div>
                        {% endif %}

                    {% else %}
                        {% if heading != blank %}
                            {% liquid
                                assign heading_text = heading
                                assign final_text = ''
                                assign split_text_curly = heading_text | split: '{'
                                for part in split_text_curly
                                    if part contains '}'
                                        assign split_curly = part | split: '}'
                                        assign styled_text = split_curly[0]
                                        assign after_curly = split_curly[1]
                                        assign final_text = final_text | append: '<span class="styled">' | append: styled_text | append: '</span>' | append: after_curly
                                    else
                                        assign final_text = final_text | append: part
                                    endif
                                endfor
                              %}
                            <div class="product-labels__title custom-heading {% if settings.dim_text %}dim-icon{% endif %} product-labels__title--{{ settings.typography_preset }} {% if product_features_settings.item_heading_size != 'default' %}{{ product_features_settings.item_heading_size }}{% else %}{% if uppercase_heading %} uppercase{% endif %}{% if bolder_heading %} bolder-font{% endif %}{% endif %}">
                                {% if item_heading_gradient %}
                                    <span class="gradient-heading-text product-labels__title-span gradient-item-heading-text--{{ section.id }}">{{ final_text }}</span>
                                {% else %}
                                    <span class="product-labels__title-span">{{ final_text }}</span>
                                {% endif %}
                                {% if feature_page != blank %}
                                    {% if page_content_in_popup %}
                                        {% assign icon_full = 'info' | append: "-" | append: title_weight %}
                                        {% render 'icon-accordion-2', icon: icon_full %}
                                    {% else %}
                                        {% assign icon_full = 'arrow-right-up' | append: "-" | append: title_weight %}
                                        {% render 'icon-accordion-2', icon: icon_full %}
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endif %}
                        {% if text != blank %}
                            <div class="product-labels__description richtext  {% if settings.enable_animated_underline %}richtext-link--underline{% endif %} product-labels__description--{{ settings.typography_preset }} {% if product_features_settings.dim_text %}dim{% endif %} {% if product_features_settings.text_size != 'default' %}{{ product_features_settings.text_size }}{% else %}{% if uppercase_text %} uppercase{% endif %}{% if bolder_text %} bolder-font{% endif %}{% endif %}">
                                <object>
                                    {{ text }} 
                                    {% if heading == blank %}
                                        {% if feature_page != blank %}
                                            {% if page_content_in_popup %}
                                                {% assign icon_full = 'info' | append: "-" | append: close_weight %}
                                                {% render 'icon-accordion-2', icon: icon_full %}
                                            {% else %}
                                                {% assign icon_full = 'arrow-right-up' | append: "-" | append: close_weight %}
                                                {% render 'icon-accordion-2', icon: icon_full %}
                                            {% endif %}
                                        {% endif %}
                                    {% endif %} 
                                </object>
                            </div>
                        {% endif %}
                    {% endif %}
                    
            {% if page_content_in_popup == false %}{%- if feature_page != blank -%}</a>{%- else -%}</div>{%- endif -%}
            {% else %}</div>{% endif %} 
            {% if feature_page != blank and page_content_in_popup == true %}
                {% style %}
                    #shopify-section-{{ section.id }} .overlay,
                    #shopify-section-{{ section.id }} .popup-wrapper,
                    #shopify-section-{{ section.id }} .button-close {
                        --layout-text-color:
                            {{ settings.layout_text_color.red }},
                            {{ settings.layout_text_color.green }}, 
                            {{ settings.layout_text_color.blue }};
                        --layout-background-color:
                            {{ settings.layout_background_color.red }},
                            {{ settings.layout_background_color.green }},
                            {{ settings.layout_background_color.blue }};
                    }
                {% endstyle %}
                <div class="popup-wrapper popup-wrapper--page">
                    <div class="scroll-area hide-scrollbar">
                        <div class="button-wrapper {% if settings.enable_buttons_zoom %}buttons-zoom{% endif %}">
                            <button type="button" class="button-close close-popup">
                                {% assign icon_full = 'cross' | append: "-" | append: close_weight %}
                                {% render 'icon', icon: icon_full %}
                            </button>
                        </div>
                        <div class="popup-content product-labels__page page__content body-text--{{ settings.typography_preset }} rte {% if settings.typography_preset == 'custom' and settings.uppercase_body_m %} uppercase{% endif %}">{{ feature_page.content }}</div>
                    </div>
                </div>
            {% endif %}
        </div>
    </double-hover>
{% endif %}