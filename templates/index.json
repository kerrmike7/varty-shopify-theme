    "faq": {
      "type": "collapsible-tabs",
      "blocks": {
        "q1": {
          "type": "tab",
          "settings": {
            "heading": "Why choose Varty over other clean oat beverage brands?",
            "text": "<p>Because it's organic, it's real, and it keeps its promises. We only use 3-4 organic ingredients, the kind you'd actually find in your kitchen. No gums, no added sugar, no stabilizers, no \"natural flavours\" doing mysterious things. Just clean.</p>"
          }
        },
        "q2": {
          "type": "tab",
          "settings": {
            "heading": "Why does Varty cost more than other organic oat beverages?",
            "text": "<p>Quality ingredients cost more than whatever the other guys are using. We keep Varty as accessible as we can while using higher-quality ingredients than most brands on the shelf.</p>"
          }
        },
        "q3": {
          "type": "tab",
          "settings": {
            "heading": "Is it shelf stable without preservatives?",
            "text": "<p>Yes. Sea salt works as a natural shelf-life extender, so Varty stays fresh for longer, with no cryptic additives required. Once opened, refrigerate and use within 7-10 days.</p>"
          }
        },
        "q4": {
          "type": "tab",
          "settings": {
            "heading": "Aren't unsweetened oat beverages bland?",
            "text": "<p>We've tasted those too, so we get it. Varty's naturally sweet thanks to the way we process our oats, not because we added sugar. Any sugar on the label is natural oat sugar from the production process. Nothing added, nothing hidden.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ],
      "settings": {
        "heading": "FREQUENTLY ASKED QUESTIONS",
        "section_width": "wide",
        "color_type": "custom",
