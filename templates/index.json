    "why_varty": {
      "type": "multicolumn",
      "blocks": {
        "clean_ingredients": {
          "type": "text",
          "settings": {
            "heading": "3–4 Real Ingredients",
            "text": "<p>Organic oats, filtered water, sea salt, and sometimes vanilla. The label reads like a pantry shelf, not a lab note.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "no_fillers": {
          "type": "text",
          "settings": {
            "heading": "No Gums. No Fillers.",
            "text": "<p>No sunflower oil, carrageenan, stabilizers, or natural-flavour fog. Just the texture and taste the oats can earn on their own.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "organic": {
          "type": "text",
          "settings": {
            "heading": "Certified Organic",
            "text": "<p>Certified by Ecocert Canada, made for people who want the everyday carton to meet a higher standard.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "canada": {
          "type": "text",
          "settings": {
            "heading": "Made in Canada",
            "text": "<p>Built for Canadian shelves, cafes, and kitchens, with a short ingredient list that travels well from morning coffee to weeknight cooking.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "barista_ready": {
          "type": "text",
          "settings": {
            "heading": "Barista Ready",
            "text": "<p>Varty Barista froths cleanly and holds texture under heat. Made for serious coffee, without overpowering it.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "shelf_stable": {
          "type": "text",
          "settings": {
            "heading": "Shelf-Stable",
            "text": "<p>1L Tetra Pak. No fridge needed until opened. Stock the pantry without taking the fridge real estate.</p>",
            "button_label": "",
            "button_link": ""
          }
        }
      },
      "block_order": [
        "clean_ingredients",
        "no_fillers",
        "organic",
        "canada",
        "barista_ready",
        "shelf_stable"
