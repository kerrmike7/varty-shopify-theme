    "why_varty": {
      "type": "multicolumn",
      "blocks": {
        "w1": {
          "type": "text",
          "settings": {
            "heading": "100% Mouthwatering",
            "text": "<p>Healthy does not have to mean meh. Varty makes better choices taste like easy ones. Smooth, creamy, actually enjoyable.</p>"
          }
        },
        "w2": {
          "type": "text",
          "settings": {
            "heading": "Affordable Luxury",
            "text": "<p>Delivering organic quality that is accessible. Because you should not need to splurge to eat well.</p>"
          }
        },
        "w3": {
          "type": "text",
          "settings": {
            "heading": "Made in Canada",
            "text": "<p>Every bottle is proudly produced at home in Canada, using the freshest locally-sourced ingredients.</p>"
          }
        },
        "w4": {
          "type": "text",
          "settings": {
            "heading": "Naturally Delicious",
            "text": "<p>Varty is thoughtfully crafted to deliver a naturally rich, oat-forward flavour, without sugar, additives, or compromise on taste.</p>"
          }
        },
        "w5": {
          "type": "text",
          "settings": {
            "heading": "Filler-Free",
            "text": "<p>At Varty, you will not find any what-even-is-that ingredients here. Just 3-4 you will recognize.</p>"
          }
        },
        "w6": {
          "type": "text",
          "settings": {
            "heading": "Purely Crafted",
            "text": "<p>If made properly, natural oat beverages should not need stabilizers. The key is in the ingredients used and how they are prepared.</p>"
          }
        }
      },
      "block_order": [
        "w1",
        "w2",
        "w3",
        "w4",
        "w5",
        "w6"
      ],
