        "text_s2": {
          "type": "text",
          "settings": {
            "text": "<p>Every carton of Varty is made with oats we can trace and certifications we can back up. Certified organic by Ecocert. No hidden ingredients, no asterisks. Just clean oat beverage, made right in Canada.</p>",
            "dim_text": false,
            "text_size": "default"
          }
        }
