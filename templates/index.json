    "faq": {
      "type": "collapsible-tabs",
      "blocks": {
        "q1": {
          "type": "tab",
          "settings": {
            "heading": "Is Varty really only 3 ingredients?",
            "text": "<p>Yes. Varty Original contains certified organic oats, filtered water, and sea salt. That is it. Our Vanilla and Barista versions add one more ingredient each - nothing you cannot pronounce.</p>"
          }
        },
        "q2": {
          "type": "tab",
          "settings": {
            "heading": "Is Varty certified organic?",
            "text": "<p>Yes. Varty is certified organic by Ecocert Canada. Every batch meets certified organic standards from ingredient sourcing to production.</p>"
          }
        },
        "q3": {
          "type": "tab",
          "settings": {
            "heading": "Where can I buy Varty?",
            "text": "<p>Varty is available across Quebec and online here. Use the store finder below to locate your nearest retailer.</p>"
          }
        },
        "q4": {
          "type": "tab",
          "settings": {
            "heading": "Do you ship outside Quebec and Ontario?",
            "text": "<p>We currently offer flat-rate shipping in QC and ON. For other provinces, shipping is calculated at checkout via Canada Post. Subscription orders ship free in our delivery zone.</p>"
          }
        }
      },
      "block_order": [
