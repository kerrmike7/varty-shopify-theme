    "faq": {
      "type": "collapsible-tabs",
      "blocks": {
        "faq_q1": {
          "type": "tab",
          "settings": {
            "heading": "Why choose Varty over other clean oat beverage brands?",
            "text": "<p>Most \"clean\" oat beverages still contain sunflower oil, gums, or 10+ ingredients. Varty is 3 to 4 real organic ingredients — oats, water, sea salt, and sometimes vanilla. That's every SKU. No asterisks. Certified organic by Ecocert Canada.</p>"
          }
        },
        "faq_q2": {
          "type": "tab",
          "settings": {
            "heading": "Why does Varty cost more than other organic oat beverages?",
            "text": "<p>Short ingredient list ≠ cheap to make. Certified organic oats cost more. Our small-batch Canadian facility processes without fillers or bulking agents that bring cost down. You're paying for what's actually in the carton.</p>"
          }
        },
        "faq_q3": {
          "type": "tab",
          "settings": {
            "heading": "Is it shelf stable without preservatives?",
            "text": "<p>Yes. Varty uses aseptic Tetra Pak packaging — the same technology used for organic soups and broths. No preservatives needed. Store at room temperature until opened, then refrigerate and use within 7–10 days.</p>"
          }
        },
        "faq_q4": {
          "type": "tab",
          "settings": {
            "heading": "Aren't unsweetened oat beverages bland?",
            "text": "<p>The opposite, actually. Without gums and stabilizers masking the flavour, you taste the oats. Smooth, subtly sweet from the oats themselves, with a clean finish. Your coffee will thank you.</p>"
          }
        },
        "faq_q5": {
          "type": "tab",
          "settings": {
            "heading": "Where can I buy Varty in store?",
            "text": "<p>Available at 23 locations across Québec — Marché TAU, IGA Extra, Marché Oda, and more. <a href=\"/pages/where-to-find-us\">See all stockists →</a></p>"
          }
        },
        "faq_q6": {
          "type": "tab",
          "settings": {
            "heading": "How does the subscription work?",
            "text": "<p>Subscribe to Original, Vanilla, or Barista and save 5% on every order. No minimum commitment — pause or cancel anytime from your account. Subscriptions ship every Tuesday from Montréal. <a href=\"/collections/subscription\">Start your subscription →</a></p>"
          }
        }
      },
      "block_order": ["faq_q1", "faq_q2", "faq_q3", "faq_q4", "faq_q5", "faq_q6"],
