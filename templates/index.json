    "faq_accordion": {
      "type": "collapsible-tabs",
      "blocks": {
        "faq_q1": {
          "type": "tab",
          "settings": {
            "heading": "Is Varty really only 3 ingredients?",
            "content": "<p>Yes. Varty Original contains certified organic oats, filtered water, and sea salt. That's it. Our Vanilla and Barista versions add one more ingredient each — nothing you can't pronounce.</p>"
          }
        },
        "faq_q2": {
          "type": "tab",
          "settings": {
            "heading": "Is Varty certified organic?",
            "content": "<p>Yes. Varty is certified organic by Ecocert Canada. Every batch meets certified organic standards from ingredient sourcing to production.</p>"
          }
        },
        "faq_q3": {
          "type": "tab",
          "settings": {
            "heading": "Where can I buy Varty?",
            "content": "<p>Varty is available at 23 stockist locations across Québec and online at vartyallnatural.ca. Use our <a href=\"/pages/where-to-find-us\">store finder</a> to locate your nearest retailer.</p>"
          }
        },
        "faq_q4": {
          "type": "tab",
          "settings": {
            "heading": "Do you ship outside Québec and Ontario?",
            "content": "<p>We currently offer flat-rate shipping ($8.99) in QC and ON. For other provinces, shipping is calculated at checkout via Canada Post. Subscription orders ship free in our delivery zone.</p>"
          }
        }
      },
      "block_order": ["faq_q1", "faq_q2", "faq_q3", "faq_q4"],
