    "split_content_1": {
      "type": "media-with-text",
      "blocks": {
        "subheading_s1": {
          "type": "subheading",
          "settings": {
            "subheading": "Clean ingredients",
            "subheading_size": "default",
            "subheading_tag": "h3"
          }
        },
        "heading_s1": {
          "type": "heading",
          "settings": {
            "heading": "We Said Oats, Water, and a Little Salt. That's What's in the Carton.",
            "heading_size": "heading_m",
            "heading_tag": "h2",
            "heading_color": "solid",
            "heading_gradient": "linear-gradient(90deg, rgba(0,0,0,1) 50%, rgba(101,101,101,1) 100%)"
          }
        },
        "text_s1": {
          "type": "text",
          "settings": {
            "text": "<p>Three clean ingredients. Nothing else. No sunflower oil, no gums, no filler. Just certified organic oats, filtered water, and a pinch of sea salt. Because a short ingredient list shouldn't be a marketing claim — it should be the standard.</p>",
            "dim_text": false,
            "text_size": "default"
          }
        }
      },
      "block_order": ["subheading_s1", "heading_s1", "text_s1"],
      "settings": {
        "section_width": "wide",
        "swap_media": false,
        "media_size": "half",
        "media_ratio": "portrait",
        "narrow_content": true,
        "vertical_text_alignment": "center",
        "horizontal_text_alignment": "flex-start",
        "color_type": "custom",
        "background_color_type": "solid",
        "background_color": "#F0E8C8",
        "text_color": "#2D2D5E",
        "fill_section": false,
        "desktop_padding_top": 80,
        "desktop_padding_bottom": 80,
        "mobile_padding_top": 48,
        "mobile_padding_bottom": 48
      }
    },
    "features_grid": {
      "type": "multicolumn",
      "blocks": {
        "feat_organic": {
          "type": "column",
          "settings": {
            "title": "Certified Organic",
            "text": "<p>Ecocert-certified from field to carton.</p>"
          }
        },
        "feat_ingredients": {
          "type": "column",
          "settings": {
            "title": "Three Ingredients",
            "text": "<p>Oats, water, sea salt. Full stop.</p>"
          }
        },
        "feat_canadian": {
          "type": "column",
          "settings": {
            "title": "Canadian Made",
            "text": "<p>Produced in Montréal, QC.</p>"
          }
        },
        "feat_barista": {
          "type": "column",
          "settings": {
            "title": "Barista Ready",
            "text": "<p>Froths perfectly. Made for serious coffee.</p>"
          }
        },
        "feat_stable": {
          "type": "column",
          "settings": {
            "title": "Shelf-Stable",
            "text": "<p>1L Tetra Pak. No fridge needed until opened.</p>"
          }
        },
        "feat_nofillers": {
          "type": "column",
          "settings": {
            "title": "No Fillers",
            "text": "<p>No sunflower oil. No gums. No asterisks.</p>"
          }
        }
      },
      "block_order": [
        "feat_organic", "feat_ingredients", "feat_canadian",
        "feat_barista", "feat_stable", "feat_nofillers"
      ],
      "settings": {
        "heading": "Why Choose Varty?",
